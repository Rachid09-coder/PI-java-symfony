# Copiez ce fichier en .env.local et remplissez les valeurs.
# .env.local n'est pas versionné (sécurité).
#
# --- IMPORTANT : Connexion Google (éviter "redirect_uri_mismatch") ---
# L'URL de callback = APP_BASE_URL + /auth/google/callback (sans slash en trop).
# 1. Dans .env (ou ici) définissez APP_BASE_URL avec l'URL exacte de votre navigateur, ex. :
#    APP_BASE_URL=http://127.0.0.1:8000   (si vous ouvrez http://127.0.0.1:8000)
#    ou  APP_BASE_URL=http://localhost:8000
# 2. Dans Google Cloud Console → Credentials → OAuth 2.0 Client ID → Authorized redirect URIs,
#    ajoutez EXACTEMENT la même base + /auth/google/callback, ex. :
#    http://127.0.0.1:8000/auth/google/callback
# 3. Collez ci-dessous le Client ID et le Client Secret.
APP_BASE_URL=http://127.0.0.1:8000
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
# Optionnel : si défini, remplace APP_BASE_URL pour le callback Google
OAUTH_GOOGLE_CALLBACK_URL=

# --- Optionnel : envoi d'emails (mot de passe oublié, etc.) ---
# MAILER_DSN=smtp://user:pass@smtp.example.com:587
# MAILER_FROM=noreply@votredomaine.com
