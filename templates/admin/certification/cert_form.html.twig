{% extends 'admin_layout.html.twig' %}

{% block title %}{{ certification.id ? 'Mise à jour' : 'Émission' }} Certification - EduSmart{% endblock %}

{% block body %}
<div class="admin-page animate-fade-in py-4">
    {# Orbes décoratives pour la touche futuriste #}
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>

    <div class="container-fluid position-relative z-index-2">
        <header class="mb-5">
            <a href="{{ path('admin_certification_index') }}" class="btn-back-premium mb-3">
                <i class="fas fa-arrow-left me-2"></i> Retour au Registre
            </a>
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div>
                    <h1 class="h2 fw-900 text-dark mb-1">{{ certification.id ? 'Actualisation de Titre' : 'Délivrance de Certification' }}</h1>
                    <p class="text-muted small mb-0">Émettez des titres académiques sécurisés et signés via protocole HMAC.</p>
                </div>
                <div class="badge-premium-logic">
                    <i class="fas fa-shield-check me-2"></i> Protocole HMAC-SHA256 Actif
                </div>
            </div>
        </header>

        {{ form_start(form, {'attr': {'class': 'premium-form', 'novalidate': 'novalidate', 'id': 'certification-form'}}) }}
        
        {# Affichage des erreurs globales du formulaire #}
        {% if form.vars.errors|length > 0 %}
        <div class="alert alert-danger mb-4 rounded-3 shadow-sm">
            <div class="d-flex align-items-center">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong>Erreurs de validation :</strong>
            </div>
            <ul class="mb-0 mt-2">
                {% for error in form.vars.errors %}
                    <li>{{ error.message }}</li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}
        
        {# Flash messages #}
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type == 'error' ? 'danger' : type }} mb-4 rounded-3 shadow-sm alert-dismissible fade show">
                    <i class="fas fa-{{ type == 'success' ? 'check-circle' : (type == 'error' ? 'times-circle' : 'info-circle') }} me-2"></i>
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                </div>
            {% endfor %}
        {% endfor %}
        
        <div class="row justify-content-center">
            <div class="col-xl-10">
                <div class="card card-premium-glass shadow-lg border-0 overflow-hidden" style="border-radius: 28px;">
                    <div class="card-header bg-transparent border-bottom border-light py-4 px-4 p-md-5 pb-md-0 border-0">
                        <div class="d-flex align-items-center">
                            <div class="icon-pulse me-3">
                                <i class="fas fa-scroll fa-2x text-primary-gradient"></i>
                            </div>
                            <div>
                                <h4 class="fw-800 text-dark mb-0">Fiche de Certification</h4>
                                <p class="text-muted small mb-0">Renseignez les métadonnées pour générer le titre officiel.</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="card-body p-4 p-md-5">
                        <div class="row g-4">
                            {# Étape 1: Étudiant #}
                            <div class="col-12">
                                <div class="step-header mb-3">
                                    <span class="step-number">1</span>
                                    <span class="step-title">Sélectionner l'étudiant</span>
                                </div>
                                <div class="form-group-premium">
                                    {{ form_label(form.student, null, {'label_attr': {'class': 'label-premium'}}) }}
                                    <div class="input-glow-wrapper">
                                        {{ form_widget(form.student) }}
                                    </div>
                                </div>
                            </div>
                            
                            {# Étape 2: Type de certification #}
                            <div class="col-12" id="step-type" style="display: none;">
                                <div class="step-header mb-3">
                                    <span class="step-number">2</span>
                                    <span class="step-title">Type de certification</span>
                                </div>
                                <div class="form-group-premium">
                                    {{ form_label(form.type, null, {'label_attr': {'class': 'label-premium'}}) }}
                                    <div class="input-glow-wrapper">
                                        {{ form_widget(form.type) }}
                                    </div>
                                </div>
                            </div>

                            {# Étape 3: Période (conditionnel) #}
                            <div class="col-12" id="step-semester" style="display: none;">
                                <div class="step-header mb-3">
                                    <span class="step-number">3</span>
                                    <span class="step-title">Période concernée</span>
                                </div>
                                <div class="form-group-premium">
                                    {{ form_label(form.semesterChoice, null, {'label_attr': {'class': 'label-premium'}}) }}
                                    <div class="input-glow-wrapper">
                                        <select id="certification_semesterChoice_select" class="form-select-premium" style="width:100%; padding: 12px 16px; border-radius: 12px; border: 1px solid #e2e8f0; font-size: 0.95rem;">
                                            <option value="">Sélectionner la période</option>
                                        </select>
                                        {# Hidden input that Symfony will read #}
                                        <div style="display:none;">{{ form_widget(form.semesterChoice) }}</div>
                                    </div>
                                    <div class="form-status-info mt-2" id="semester-info">
                                        <i class="fas fa-info-circle me-1"></i> Les périodes disponibles sont basées sur les bulletins de l'étudiant
                                    </div>
                                </div>
                            </div>

                            {# Étape 4: Détails supplémentaires #}
                            <div class="col-12" id="step-details" style="display: none;">
                                <div class="step-header mb-3">
                                    <span class="step-number">4</span>
                                    <span class="step-title">Détails de la certification</span>
                                </div>
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <div class="form-group-premium">
                                            {{ form_label(form.verificationCode, null, {'label_attr': {'class': 'label-premium'}}) }}
                                            <div class="input-glow-wrapper">
                                                {{ form_widget(form.verificationCode) }}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group-premium">
                                            {{ form_label(form.validUntil, null, {'label_attr': {'class': 'label-premium'}}) }}
                                            <div class="input-glow-wrapper">
                                                {{ form_widget(form.validUntil) }}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            {# Upload PDF #}
                            <div class="col-12 mt-4" id="step-upload" style="display: none;">
                                <div class="upload-zone-premium p-5 rounded-4 border-dashed animate-pulse-soft">
                                    <div class="text-center">
                                        <div class="icon-upload-wrapper mb-3">
                                            <i class="fas fa-cloud-upload-alt fa-3x text-primary-gradient"></i>
                                        </div>
                                        <h6 class="fw-800 text-dark mb-2">Importation de PDF Manuel</h6>
                                        <p class="small text-muted mb-4 mx-auto" style="max-width: 500px;">
                                            Utilisez cette option uniquement si vous disposez d'un document externe. 
                                            EduSmart peut également générer ce PDF automatiquement.
                                        </p>
                                        <div class="max-width-400 mx-auto">
                                            {{ form_widget(form.pdfFile) }}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-5 pt-4 border-top border-light" id="form-actions" style="display: none;">
                            <a href="{{ path('admin_certification_index') }}" class="btn-premium-cancel px-4">
                                <i class="fas fa-times me-2"></i> Annuler l'opération
                            </a>
                            <button type="submit" class="btn-premium-submit px-5 shadow-lg">
                                <span>{{ certification.id ? 'Sauvegarder les modifications' : 'Émettre la Certification' }}</span>
                                <i class="fas fa-check-double ms-2"></i>
                            </button>
                        </div>
                    </div>
                </div>

                {% if certification.id and certification.hmacHash %}
                <div class="card card-premium-glass mt-4 shadow-sm border-0 animate-slide-up" style="animation-delay: 0.2s;">
                    <div class="card-body py-4 px-5">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center">
                                <div class="badge-hmac-pulse me-4">
                                    <i class="fas fa-key"></i>
                                </div>
                                <div>
                                    <div class="fw-800 text-dark h6 mb-1">Certificat Signature HMAC</div>
                                    <div class="small text-muted font-monospace opacity-75">SHA256: {{ certification.hmacHash }}</div>
                                </div>
                            </div>
                            <div class="badge bg-success-soft text-success px-4 py-2 rounded-pill fw-900 border-0">INTÉGRITÉ VÉRIFIÉE</div>
                        </div>
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
        {{ form_end(form) }}
    </div>
</div>

<style>
    /* --- Futuristic Design System --- */
    .fw-900 { font-weight: 900; }
    .fw-800 { font-weight: 800; }
    .z-index-2 { z-index: 2; }
    
    .bg-success-soft { background-color: rgba(16, 185, 129, 0.1); color: #10b981; }

    /* Orbes Lumineuses */
    .orb {
        position: fixed;
        width: 600px;
        height: 600px;
        border-radius: 50%;
        filter: blur(120px);
        opacity: 0.1;
        z-index: 0;
        pointer-events: none;
        animation: floatOrb 30s infinite alternate ease-in-out;
    }
    .orb-1 { top: -200px; right: -100px; background: #4f46e5; }
    .orb-2 { bottom: -200px; left: -100px; background: #6366f1; }
    @keyframes floatOrb {
        from { transform: translate(0, 0) rotate(0deg); }
        to { transform: translate(150px, 100px) rotate(15deg); }
    }

    /* Cards Glassmorphism */
    .card-premium-glass {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(226, 232, 240, 0.6) !important;
        transition: all 0.4s ease;
    }

    .text-primary-gradient {
        background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .icon-pulse {
        width: 56px;
        height: 56px;
        background: rgba(79, 70, 229, 0.08);
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        animation: softPulse 2s infinite;
    }
    @keyframes softPulse {
        0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(79, 70, 229, 0.15); }
        70% { transform: scale(1.05); box-shadow: 0 0 0 12px rgba(79, 70, 229, 0); }
        100% { transform: scale(1); }
    }

    /* Form Elements */
    .label-premium {
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #64748b;
        margin-bottom: 10px;
        display: block;
    }

    .form-control-premium, .form-select-premium {
        width: 100%;
        padding: 13px 18px;
        border-radius: 15px;
        border: 2px solid #f1f5f9;
        background: #fdfdfd;
        font-size: 0.95rem;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .form-control-premium:focus, .form-select-premium:focus {
        border-color: #6366f1;
        background: #ffffff;
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
        transform: translateY(-2px);
        outline: none;
    }

    .input-glow-wrapper { position: relative; }
    .input-glow-wrapper::after {
        content: '';
        position: absolute;
        inset: -2px;
        border-radius: 17px;
        background: linear-gradient(135deg, #4f46e5, #818cf8);
        z-index: -1;
        opacity: 0;
        transition: opacity 0.3s ease;
    }
    .input-glow-wrapper:focus-within::after { opacity: 0.15; }

    /* Custom Upload Zone */
    .upload-zone-premium {
        background: rgba(248, 250, 252, 0.5);
        border: 2px dashed #e2e8f0;
        transition: all 0.3s ease;
    }
    .upload-zone-premium:hover {
        background: rgba(79, 70, 229, 0.02);
        border-color: #6366f1;
    }

    /* Buttons */
    .btn-premium-submit {
        background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
        color: white;
        border: none;
        padding: 16px 45px;
        border-radius: 50px;
        font-weight: 800;
        letter-spacing: 0.5px;
        display: inline-flex;
        align-items: center;
        gap: 12px;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .btn-premium-submit:hover {
        transform: translateY(-5px) scale(1.05);
        box-shadow: 0 20px 40px rgba(79, 70, 229, 0.3);
        color: white;
    }

    .btn-premium-cancel {
        color: #64748b;
        font-weight: 700;
        text-decoration: none;
        padding: 16px 0;
        transition: all 0.3s ease;
    }
    .btn-premium-cancel:hover {
        color: #1e293b;
        transform: translateX(-5px);
    }

    .btn-back-premium {
        display: inline-flex;
        align-items: center;
        color: #64748b;
        text-decoration: none;
        font-weight: 700;
        font-size: 0.85rem;
        transition: opacity 0.3s ease;
    }
    .btn-back-premium:hover { opacity: 0.7; }

    /* Extra UI Elements */
    .badge-premium-logic {
        background: rgba(79, 70, 229, 0.1);
        color: #4f46e5;
        padding: 8px 18px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 0.8rem;
    }

    .badge-hmac-pulse {
        width: 48px;
        height: 48px;
        background: #10b981;
        color: white;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        animation: softPulseGreen 3s infinite;
    }
    @keyframes softPulseGreen {
        0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.2); }
        70% { transform: scale(1.05); box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
        100% { transform: scale(1); }
    }

    /* Animations */
    .animate-fade-in { animation: fadeIn 0.8s ease-out; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

    .border-dashed { border-style: dashed !important; border-width: 2px !important; }
    .max-width-400 { max-width: 400px; }

    /* Validation Error Styles */
    .field-error {
        border-color: #ef4444 !important;
        background-color: rgba(254, 242, 242, 0.5) !important;
        animation: shakeField 0.4s ease;
    }
    .error-message {
        color: #ef4444;
        font-size: 0.75rem;
        font-weight: 700;
        margin-top: 6px;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .error-message i { font-size: 0.7rem; }
    @keyframes shakeField {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-5px); }
        75% { transform: translateX(5px); }
    }

    /* Step indicators */
    .step-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 2px solid #f1f5f9;
        margin-bottom: 16px;
    }
    .step-number {
        width: 32px;
        height: 32px;
        background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 0.85rem;
    }
    .step-title {
        font-weight: 700;
        color: #1e293b;
        font-size: 1rem;
    }
    
    /* Slide animation */
    .slide-down {
        animation: slideDown 0.4s ease-out forwards;
    }
    @keyframes slideDown {
        from { opacity: 0; transform: translateY(-20px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('certification-form');
    // Use Symfony generated IDs (certification_fieldName)
    const studentSelect = document.getElementById('certification_student');
    const typeSelect = document.getElementById('certification_type');
    const semesterHiddenInput = document.getElementById('certification_semesterChoice');
    const semesterSelect = document.getElementById('certification_semesterChoice_select');
    
    const stepType = document.getElementById('step-type');
    const stepSemester = document.getElementById('step-semester');
    const stepDetails = document.getElementById('step-details');
    const stepUpload = document.getElementById('step-upload');
    const formActions = document.getElementById('form-actions');
    const semesterInfo = document.getElementById('semester-info');
    
    // Store available semesters for current student
    let availableSemesters = [];
    
    console.log('Form elements:', { studentSelect, typeSelect, semesterSelect });
    
    // Types requiring semester selection
    const typesNeedingSemester = ['NOTES', 'REUSSITE'];
    
    // Function to show element with animation
    function showStep(element) {
        if (element) {
            element.style.display = 'block';
            element.classList.add('slide-down');
        }
    }
    
    // Function to hide element
    function hideStep(element) {
        if (element) {
            element.style.display = 'none';
            element.classList.remove('slide-down');
        }
    }
    
    // Reset form steps from a certain point
    function resetFromStep(stepNumber) {
        if (stepNumber <= 2) {
            hideStep(stepType);
            typeSelect.value = '';
        }
        if (stepNumber <= 3) {
            hideStep(stepSemester);
            semesterSelect.innerHTML = '<option value="">S\u00e9lectionner la p\u00e9riode</option>';
            semesterHiddenInput.value = '';
            availableSemesters = [];
        }
        hideStep(stepDetails);
        hideStep(stepUpload);
        formActions.style.display = 'none';
    }
    
    // Load available semesters for student via AJAX
    function loadAvailableSemesters(studentId) {
        if (!studentId) return Promise.resolve([]);
        
        return fetch('/admin/certification/api/semesters/' + studentId)
            .then(response => response.json())
            .then(data => {
                availableSemesters = data;
                return data;
            })
            .catch(err => {
                console.error('Erreur chargement semestres:', err);
                return [];
            });
    }
    
    // Populate semester dropdown with available options
    function populateSemesterDropdown(semesters) {
        semesterSelect.innerHTML = '<option value="">S\u00e9lectionner la p\u00e9riode</option>';
        semesters.forEach(sem => {
            const option = document.createElement('option');
            option.value = sem.value;
            option.textContent = sem.label;
            semesterSelect.appendChild(option);
        });
        
        if (semesters.length === 0) {
            semesterInfo.innerHTML = '<i class="fas fa-exclamation-triangle me-1 text-warning"></i> Aucun bulletin disponible pour cet étudiant';
        } else {
            semesterInfo.innerHTML = '<i class="fas fa-info-circle me-1"></i> ' + semesters.length + ' période(s) disponible(s)';
        }
    }
    
    // Student selection change
    studentSelect.addEventListener('change', function() {
        resetFromStep(2);
        if (this.value) {
            // Load available semesters for this student
            loadAvailableSemesters(this.value).then(() => {
                showStep(stepType);
            });
        }
    });
    
    // Type selection change
    typeSelect.addEventListener('change', function() {
        hideStep(stepSemester);
        hideStep(stepDetails);
        hideStep(stepUpload);
        formActions.style.display = 'none';
        
        if (this.value) {
            if (typesNeedingSemester.includes(this.value)) {
                // Show semester choice for these types (only if semesters are available)
                if (availableSemesters.length > 0) {
                    populateSemesterDropdown(availableSemesters);
                    showStep(stepSemester);
                } else {
                    // No bulletins available, show warning and still allow proceeding
                    populateSemesterDropdown([]);
                    showStep(stepSemester);
                }
            } else {
                // Skip to details for other types (SCOLARITE, DIPLOME, STAGE, PRESENCE)
                showStep(stepDetails);
                showStep(stepUpload);
                formActions.style.display = 'flex';
            }
        }
    });
    
    // Semester choice change - go directly to details
    semesterSelect.addEventListener('change', function() {
        // Sync hidden input with selected value
        semesterHiddenInput.value = this.value;
        
        hideStep(stepDetails);
        hideStep(stepUpload);
        formActions.style.display = 'none';
        
        if (this.value) {
            showStep(stepDetails);
            showStep(stepUpload);
            formActions.style.display = 'flex';
        }
    });
    
    // Initial state - check if editing
    {% if certification.id %}
    // Show all steps when editing
    showStep(stepType);
    if (typesNeedingSemester.includes(typeSelect.value)) {
        loadAvailableSemesters(studentSelect.value).then(() => {
            populateSemesterDropdown(availableSemesters);
            showStep(stepSemester);
        });
    }
    showStep(stepDetails);
    showStep(stepUpload);
    formActions.style.display = 'flex';
    {% endif %}
    
    // Validation rules
    const validations = {
        student: { required: true, message: 'Veuillez sélectionner un étudiant' },
        type: { required: true, message: 'Veuillez choisir un type de certification' }
    };
    
    // Clear previous errors
    function clearErrors() {
        form.querySelectorAll('.field-error').forEach(el => el.classList.remove('field-error'));
        form.querySelectorAll('.error-message').forEach(el => el.remove());
    }
    
    // Show error for field
    function showError(field, message) {
        field.classList.add('field-error');
        const errorDiv = document.createElement('div');
        errorDiv.className = 'error-message';
        errorDiv.innerHTML = '<i class="fas fa-exclamation-circle"></i> ' + message;
        field.parentElement.appendChild(errorDiv);
    }
    
    // Date validation
    function isValidDate(dateStr) {
        if (!dateStr) return true;
        const date = new Date(dateStr);
        return date instanceof Date && !isNaN(date);
    }
    
    form.addEventListener('submit', function(e) {
        clearErrors();
        let isValid = true;
        
        if (!studentSelect.value) {
            showError(studentSelect, validations.student.message);
            isValid = false;
        }
        
        if (!typeSelect.value) {
            showError(typeSelect, validations.type.message);
            isValid = false;
        }
        
        const validUntilInput = form.querySelector('[name*="[validUntil]"]');
        if (validUntilInput && validUntilInput.value && !isValidDate(validUntilInput.value)) {
            showError(validUntilInput, 'Format de date invalide');
            isValid = false;
        }
        
        if (!isValid) {
            e.preventDefault();
            const firstError = form.querySelector('.field-error');
            if (firstError) {
                firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }
    });
    
    // Real-time validation on blur
    form.querySelectorAll('select, input').forEach(field => {
        field.addEventListener('blur', function() {
            const wrapper = this.closest('.form-group-premium');
            if (wrapper) {
                wrapper.querySelectorAll('.error-message').forEach(e => e.remove());
                this.classList.remove('field-error');
            }
        });
    });
});
</script>
{% endblock %}
{% endblock %}


