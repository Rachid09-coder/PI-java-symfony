{% extends 'admin_layout.html.twig' %}

{% block title %}Certification - {{ certification.student.name }} - EduSmart{% endblock %}

{% block body %}
<div class="admin-page animate-fade-in py-4">
    {# Orbes décoratives #}
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>

    <div class="container-fluid position-relative z-index-2">

        {# Flash messages #}
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" style="border-radius: 16px; border: none; font-weight: 600;">
                    <i class="fas fa-{{ type == 'success' ? 'check-circle' : 'exclamation-triangle' }} me-2"></i>
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {# Header #}
        <header class="mb-5 d-flex justify-content-between align-items-center flex-wrap gap-4">
            <div>
                <a href="{{ path('admin_certification_index') }}" class="text-decoration-none d-inline-flex align-items-center gap-2 mb-3" style="color: #64748b; font-weight: 700; transition: all 0.3s;">
                    <i class="fas fa-arrow-left"></i> Retour à la liste
                </a>
                <h1 class="h2 fw-900 text-dark mb-1">Certification <span class="text-primary-gradient">#{{ certification.id }}</span></h1>
                <p class="text-muted small mb-0">Détails complets, sécurité et actions disponibles.</p>
            </div>
            <div class="header-buttons">
                {% if certification.pdfPath %}
                    <a href="{{ asset(certification.pdfPath) }}" class="btn-premium-launch px-4 shadow-lg" target="_blank">
                        <i class="fas fa-file-pdf me-2"></i> <span class="fw-800">Voir le PDF</span>
                    </a>
                {% endif %}

                {% if certification.status == 'ACTIVE' and certification.student.numtel %}
                    <form action="{{ path('admin_certification_send_sms', {id: certification.id}) }}" method="POST" class="d-inline">
                        <button type="submit" class="btn-premium-action shadow-sm" style="border-color: #8B5CF6;">
                            <i class="fas fa-sms" style="color: #8B5CF6;"></i> <span style="color: #8B5CF6;">SMS</span>
                        </button>
                    </form>
                {% endif %}

                {% if certification.status == 'ACTIVE' and certification.student.email %}
                    <form action="{{ path('admin_certification_send_email', {id: certification.id}) }}" method="POST" class="d-inline">
                        <button type="submit" class="btn-premium-action shadow-sm" style="border-color: #3B82F6;">
                            <i class="fas fa-envelope" style="color: #3B82F6;"></i> <span style="color: #3B82F6;">Email</span>
                        </button>
                    </form>
                {% endif %}

                <a href="{{ path('admin_audit_log_index', {entity_type: 'Certification', entity_id: certification.id}) }}" class="btn-premium-action shadow-sm">
                    <i class="fas fa-history text-primary"></i> <span>Audit Log</span>
                </a>

                {% if certification.status == 'ACTIVE' %}
                    <button class="btn-premium-action shadow-sm" style="border-color: #EF4444;" data-bs-toggle="modal" data-bs-target="#revokeModal">
                        <i class="fas fa-ban" style="color: #EF4444;"></i> <span style="color: #EF4444;">Révoquer</span>
                    </button>
                {% endif %}
            </div>
        </header>

        <div class="row g-4">
            {# Colonne gauche: Étudiant + Sécurité #}
            <div class="col-lg-4">
                {# Carte Étudiant #}
                <div class="card card-premium-glass shadow-lg border-0 overflow-hidden mb-4">
                    <div class="card-header bg-transparent py-4 px-4 border-bottom border-light">
                        <div class="d-flex align-items-center">
                            <div class="icon-pulse-blue me-3">
                                <i class="fas fa-user-graduate text-primary"></i>
                            </div>
                            <h5 class="m-0 fw-800 text-dark">Informations Étudiant</h5>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <div class="text-center mb-4">
                            <div class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 80px; height: 80px; background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%); box-shadow: 0 10px 30px rgba(79, 70, 229, 0.3);">
                                <i class="fas fa-user-graduate fa-2x text-white"></i>
                            </div>
                            <h5 class="mt-3 mb-1 fw-800">{{ certification.student.prenom }} {{ certification.student.name }}</h5>
                            <span class="badge-hologram">
                                <i class="fas fa-envelope me-1"></i> {{ certification.student.email }}
                            </span>
                        </div>
                        <div class="info-block">
                            <div class="info-item">
                                <span class="label-premium">Type de Certification</span>
                                <span class="badge-hologram" style="background: rgba(79, 70, 229, 0.08); color: #4F46E5; border-color: rgba(79, 70, 229, 0.2);">
                                    <i class="fas fa-certificate me-1"></i> {{ certification.type }}
                                </span>
                            </div>
                            <div class="info-item mt-3">
                                <span class="label-premium">Numéro Unique</span>
                                <div class="id-glow-box">
                                    <span class="font-monospace fw-800 text-primary-gradient" style="font-size: 0.85rem;">{{ certification.uniqueNumber }}</span>
                                </div>
                            </div>
                            <div class="info-item mt-3">
                                <span class="label-premium">Statut</span>
                                <div>
                                    {% if certification.status == 'ACTIVE' %}
                                        <span class="badge-status-active"><i class="fas fa-check-circle me-1"></i> ACTIVE</span>
                                    {% elseif certification.status == 'REVOKED' %}
                                        <span class="badge-status-revoked"><i class="fas fa-times-circle me-1"></i> RÉVOQUÉE</span>
                                    {% else %}
                                        <span class="badge-hologram">{{ certification.status }}</span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# Carte Sécurité & Vérification #}
                {% if certification.verificationCode %}
                <div class="card card-premium-glass shadow-lg border-0 overflow-hidden mb-4">
                    <div class="card-header bg-transparent py-4 px-4 border-bottom border-light">
                        <div class="d-flex align-items-center">
                            <div class="icon-pulse-blue me-3" style="background: rgba(16, 185, 129, 0.1);">
                                <i class="fas fa-shield-alt" style="color: #10B981;"></i>
                            </div>
                            <h5 class="m-0 fw-800 text-dark">Sécurité & Vérification</h5>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <div class="info-item mb-3">
                            <span class="label-premium">Code de vérification</span>
                            <div class="id-glow-box w-100" style="border-color: #d1fae5; background: #f0fdf4;">
                                <span class="font-monospace fw-700" style="font-size: 0.8rem; color: #059669; word-break: break-all;">{{ certification.verificationCode }}</span>
                            </div>
                        </div>
                        <div class="info-item mb-3">
                            <span class="label-premium">Lien de vérification publique</span>
                            <a href="{{ path('public_verify', {code: certification.verificationCode}) }}" target="_blank" class="d-block text-truncate" style="font-size: 0.8rem; color: #4F46E5; font-weight: 600;">
                                <i class="fas fa-external-link-alt me-1"></i> {{ url('public_verify', {code: certification.verificationCode}) }}
                            </a>
                        </div>
                        {% if certification.hmacHash %}
                        <div class="info-item mb-3">
                            <span class="label-premium">Signature HMAC</span>
                            <div class="id-glow-box w-100" style="border-color: #fef3c7; background: #fffbeb;">
                                <span class="font-monospace fw-600" style="font-size: 0.7rem; color: #92400e; word-break: break-all;">SHA256: {{ certification.hmacHash }}</span>
                            </div>
                        </div>
                        {% endif %}
                        <div class="info-item">
                            <span class="label-premium">Date d'émission</span>
                            <div class="d-flex align-items-center gap-2">
                                <i class="fas fa-calendar-alt" style="color: #6366F1;"></i>
                                <span class="fw-800" style="color: #1e293b;">{{ certification.issuedAt|date('d/m/Y H:i') }}</span>
                            </div>
                        </div>
                    </div>
                </div>
                {% endif %}
            </div>

            {# Colonne droite: Détails Certification #}
            <div class="col-lg-8">
                <div class="card card-premium-glass shadow-lg border-0 overflow-hidden">
                    <div class="card-header bg-transparent py-4 px-4 border-bottom border-light d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <div class="icon-pulse-blue me-3">
                                <i class="fas fa-certificate text-primary"></i>
                            </div>
                            <h5 class="m-0 fw-800 text-dark">Détails de la Certification</h5>
                        </div>
                        <div class="badge-premium-logic">
                            <i class="fas fa-fingerprint me-2"></i> Document officiel
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="detail-card p-4" style="background: linear-gradient(135deg, #f8fafc 0%, #eef2ff 100%); border-radius: 20px; border: 1px solid #e0e7ff;">
                                    <span class="label-premium">Type</span>
                                    <div class="d-flex align-items-center gap-2 mt-1">
                                        <i class="fas fa-tag" style="color: #6366F1;"></i>
                                        <span class="fw-800" style="font-size: 1.1rem; color: #1e293b;">{{ certification.type }}</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="detail-card p-4" style="background: linear-gradient(135deg, #f8fafc 0%, #eef2ff 100%); border-radius: 20px; border: 1px solid #e0e7ff;">
                                    <span class="label-premium">Numéro Unique</span>
                                    <div class="d-flex align-items-center gap-2 mt-1">
                                        <i class="fas fa-hashtag" style="color: #6366F1;"></i>
                                        <span class="fw-800 font-monospace" style="font-size: 1.1rem; color: #1e293b;">{{ certification.uniqueNumber }}</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="detail-card p-4" style="background: linear-gradient(135deg, #f8fafc 0%, #f0fdf4 100%); border-radius: 20px; border: 1px solid #d1fae5;">
                                    <span class="label-premium">Date d'émission</span>
                                    <div class="d-flex align-items-center gap-2 mt-1">
                                        <i class="fas fa-calendar-check" style="color: #10B981;"></i>
                                        <span class="fw-800" style="font-size: 1.1rem; color: #1e293b;">{{ certification.issuedAt|date('d/m/Y H:i') }}</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="detail-card p-4" style="background: linear-gradient(135deg, #f8fafc 0%, {% if certification.status == 'ACTIVE' %}#f0fdf4{% elseif certification.status == 'REVOKED' %}#fef2f2{% else %}#f8fafc{% endif %} 100%); border-radius: 20px; border: 1px solid {% if certification.status == 'ACTIVE' %}#d1fae5{% elseif certification.status == 'REVOKED' %}#fecaca{% else %}#e2e8f0{% endif %};">
                                    <span class="label-premium">Statut</span>
                                    <div class="mt-1">
                                        {% if certification.status == 'ACTIVE' %}
                                            <span class="badge-status-active" style="font-size: 0.85rem; padding: 8px 20px;"><i class="fas fa-check-circle me-1"></i> ACTIVE</span>
                                        {% elseif certification.status == 'REVOKED' %}
                                            <span class="badge-status-revoked" style="font-size: 0.85rem; padding: 8px 20px;"><i class="fas fa-times-circle me-1"></i> RÉVOQUÉE</span>
                                        {% else %}
                                            <span class="badge-hologram" style="font-size: 0.85rem; padding: 8px 20px;">{{ certification.status }}</span>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                            {% if certification.validUntil %}
                            <div class="col-md-6">
                                <div class="detail-card p-4" style="background: linear-gradient(135deg, #f8fafc 0%, #fffbeb 100%); border-radius: 20px; border: 1px solid #fef3c7;">
                                    <span class="label-premium">Valide jusqu'au</span>
                                    <div class="d-flex align-items-center gap-2 mt-1">
                                        <i class="fas fa-clock" style="color: #F59E0B;"></i>
                                        <span class="fw-800" style="font-size: 1.1rem; color: #1e293b;">{{ certification.validUntil|date('d/m/Y') }}</span>
                                    </div>
                                </div>
                            </div>
                            {% endif %}
                        </div>

                        {# Résumé visuel #}
                        <div class="mt-4 p-4" style="background: linear-gradient(135deg, rgba(79, 70, 229, 0.04) 0%, rgba(139, 92, 246, 0.08) 100%); border-radius: 20px; border: 1px solid rgba(99, 102, 241, 0.1);">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div style="width: 40px; height: 40px; background: linear-gradient(135deg, #4F46E5, #7C3AED); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                                    <i class="fas fa-info-circle text-white"></i>
                                </div>
                                <h6 class="m-0 fw-800 text-dark">Résumé</h6>
                            </div>
                            <p class="mb-0" style="color: #475569; line-height: 1.8;">
                                Cette certification de type <strong style="color: #4F46E5;">{{ certification.type }}</strong> a été émise le
                                <strong>{{ certification.issuedAt|date('d/m/Y') }}</strong> pour l'étudiant(e)
                                <strong>{{ certification.student.prenom }} {{ certification.student.name }}</strong>.
                                {% if certification.status == 'ACTIVE' %}
                                    Elle est actuellement <strong style="color: #10B981;">active</strong> et vérifiable en ligne.
                                {% elseif certification.status == 'REVOKED' %}
                                    Elle a été <strong style="color: #EF4444;">révoquée</strong>.
                                {% endif %}
                                {% if certification.validUntil %}
                                    Validité jusqu'au <strong>{{ certification.validUntil|date('d/m/Y') }}</strong>.
                                {% endif %}
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{# Revoke Modal #}
<div class="modal fade" id="revokeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content card-premium-glass shadow-2xl border-0 overflow-hidden" style="border-radius: 28px;">
            <div class="modal-header border-0 p-4 pb-0" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); border-radius: 28px 28px 0 0;">
                <div class="d-flex align-items-center gap-3">
                    <div style="width: 44px; height: 44px; background: rgba(255,255,255,0.2); border-radius: 14px; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-ban text-white fa-lg"></i>
                    </div>
                    <div>
                        <h5 class="modal-title text-white fw-800 mb-0">Révoquer la Certification</h5>
                        <small class="text-white-50">Cette action est irréversible</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="{{ path('admin_certification_revoke', {id: certification.id}) }}" method="POST">
                <div class="modal-body p-4">
                    <div class="p-3 mb-4" style="background: rgba(239, 68, 68, 0.05); border-radius: 16px; border: 1px solid rgba(239, 68, 68, 0.1);">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fas fa-exclamation-triangle" style="color: #EF4444;"></i>
                            <span class="fw-700" style="color: #991B1B;">Êtes-vous sûr de vouloir révoquer cette certification ?</span>
                        </div>
                        <p class="mb-0 mt-2 small" style="color: #64748b;">Le document sera invalidé et ne sera plus vérifiable en ligne.</p>
                    </div>
                    <div class="mb-3">
                        <label class="label-premium" for="revocation_reason">Raison de la révocation</label>
                        <textarea class="form-control-premium" id="revocation_reason" name="reason" rows="3" required placeholder="Décrivez la raison de la révocation..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0 d-flex justify-content-end gap-3">
                    <button type="button" class="btn-premium-cancel" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn-premium-launch px-4 shadow-lg" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); padding: 12px 28px;">
                        <i class="fas fa-ban me-2"></i> Confirmer la Révocation
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    /* Background Orbs */
    .orb { position: fixed; width: 600px; height: 600px; border-radius: 50%; filter: blur(120px); opacity: 0.1; z-index: 0; pointer-events: none; animation: floatOrb 30s infinite alternate ease-in-out; }
    .orb-1 { top: -200px; right: -100px; background: #6366f1; }
    .orb-2 { bottom: -200px; left: -100px; background: #4f46e5; }
    @keyframes floatOrb { from { transform: translate(0, 0) scale(1); } to { transform: translate(100px, 50px) scale(1.1) rotate(10deg); } }

    /* Glassmorphism Card */
    .card-premium-glass { background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(20px); border: 1px solid rgba(226, 232, 240, 0.6) !important; border-radius: 28px; }

    /* Buttons */
    .header-buttons { display: flex; flex-wrap: wrap; gap: 15px; row-gap: 12px; }
    .btn-premium-launch { background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%); color: white !important; border: none; padding: 14px 28px; border-radius: 50px; transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); font-weight: 800; text-decoration: none; display: inline-flex; align-items: center; }
    .btn-premium-launch:hover { transform: translateY(-4px) scale(1.05); box-shadow: 0 15px 30px rgba(79, 70, 229, 0.3); color: white !important; }
    .btn-premium-action { background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(10px); border: 1px solid #e2e8f0; padding: 14px 24px; border-radius: 50px; color: #64748b; font-weight: 800; text-decoration: none; display: flex; align-items: center; gap: 10px; transition: all 0.3s ease; }
    .btn-premium-action:hover { background: #ffffff; transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,0.08); }

    /* Badges */
    .badge-hologram { background: #f1f5f9; color: #475569; font-weight: 700; font-size: 0.75rem; padding: 6px 14px; border-radius: 50px; text-transform: uppercase; border: 1px solid #e2e8f0; display: inline-block; }
    .badge-status-active { background: rgba(16, 185, 129, 0.1); color: #10b981; font-weight: 800; font-size: 0.75rem; padding: 6px 16px; border-radius: 50px; display: inline-block; }
    .badge-status-revoked { background: rgba(239, 68, 68, 0.1); color: #ef4444; font-weight: 800; font-size: 0.75rem; padding: 6px 16px; border-radius: 50px; display: inline-block; }
    .badge-premium-logic { background: #f8fafc; color: #64748b; padding: 8px 16px; border-radius: 50px; font-weight: 700; font-size: 0.75rem; border: 1px solid #e2e8f0; }

    /* UI Elements */
    .icon-pulse-blue { width: 44px; height: 44px; background: rgba(79, 70, 229, 0.1); border-radius: 14px; display: flex; align-items: center; justify-content: center; animation: pulseBlue 3s infinite; }
    @keyframes pulseBlue { 0% { box-shadow: 0 0 0 0 rgba(79, 70, 229, 0.2); } 70% { box-shadow: 0 0 0 10px rgba(79, 70, 229, 0); } 100% { box-shadow: 0 0 0 0 rgba(79, 70, 229, 0); } }
    .id-glow-box { background: #ffffff; padding: 6px 14px; border-radius: 10px; border: 1px solid #eef2ff; display: inline-block; box-shadow: 0 4px 10px rgba(79, 70, 229, 0.05); }
    .text-primary-gradient { background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .label-premium { font-size: 0.7rem; font-weight: 800; text-transform: uppercase; color: #94a3b8; margin-bottom: 8px; display: block; letter-spacing: 0.05em; }

    /* Form elements */
    .form-control-premium { width: 100%; padding: 12px 18px; border-radius: 14px; border: 2px solid #f1f5f9; font-size: 0.9rem; transition: all 0.3s ease; }
    .form-control-premium:focus { border-color: #ef4444; box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.1); outline: none; }
    .btn-premium-cancel { background: transparent; border: none; color: #94a3b8; font-weight: 700; transition: all 0.3s ease; }
    .btn-premium-cancel:hover { color: #475569; }

    /* Animations */
    .animate-fade-in { animation: fadeIn 0.8s ease-out; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
{% endblock %}