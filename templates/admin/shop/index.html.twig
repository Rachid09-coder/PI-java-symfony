{% extends 'admin_layout.html.twig' %}

{% block stylesheets %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
{% endblock %}

{% block title %}Gestion Boutique - EduSmart{% endblock %}

{% block body %}
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
    <h2 style="font-size: 1.5rem; font-weight: 800; color: #1E293B;">Gestion de la Boutique</h2>
    <div style="display: flex; gap: 15px;">
        <button id="aiAnalyseBtn" class="btn" style="background: linear-gradient(135deg, #6366F1 0%, #A855F7 100%); color: white; border-radius: 12px; padding: 10px 25px; border: none; cursor: pointer; display: flex; align-items: center; gap: 8px; font-weight: 700; transition: transform 0.2s, box-shadow 0.2s;">
            <i class="fas fa-robot"></i>
            <span>Analyser avec IA</span>
        </button>
        <a href="{{ path('admin_shop_categories') }}" class="btn btn-outline" style="border-radius: 12px; padding: 10px 20px; text-decoration: none; border: 1px solid #E2E8F0; color: #64748B;">Gérer Catégories</a>
        <a href="{{ path('admin_shop_product_new') }}" class="btn btn-primary" style="background: #3B49A2; color: white; border-radius: 12px; padding: 10px 25px; text-decoration: none;">+ Nouveau Produit</a>
    </div>
</div>

{# AI Analysis Results Container #}
<div id="aiAnalysisResults" style="display: none; margin-bottom: 30px; animation: slideDown 0.4s ease-out;">
    <div class="card" style="padding: 25px; background: linear-gradient(to bottom right, #ffffff, #f9fafb); border: 1px solid #E2E8F0; border-radius: 20px; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #F1F5F9; padding-bottom: 15px;">
            <h3 style="margin:0; color: #1E293B; display: flex; align-items: center; gap:10px;">
                <i class="fas fa-magic" style="color: #8B5CF6;"></i> Analyse Stratégique IA
            </h3>
            <button onclick="document.getElementById('aiAnalysisResults').style.display='none'" style="background:none; border:none; cursor:pointer; color:#94A3B8;">
                <i class="fas fa-times"></i>
            </button>
        </div>
        
        <div id="aiLoading" style="text-align: center; padding: 40px;">
            <div style="display: inline-block; width: 40px; height: 40px; border: 4px solid #f3f3f3; border-top: 4px solid #6366F1; border-radius: 50%; animation: spin 1s linear infinite;"></div>
            <p style="margin-top: 15px; color: #64748B; font-weight: 600;">Gemini analyse vos données...</p>
        </div>

        <div id="aiContent" style="display: none;">
            <div id="aiBusyWarning" style="display:none; background: #FFFBEB; padding: 12px; border-radius: 12px; color: #92400E; font-weight: 600; margin-bottom: 15px; border-left: 4px solid #F59E0B; font-size: 0.85rem;">
                <i class="fas fa-hourglass-half"></i> L'IA est temporairement saturée. Affichage des statistiques locales uniquement.
            </div>

            {# Simple Stats Bar #}
            <div id="statsBar" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin-bottom: 20px;">
                <div style="background: white; padding: 10px; border-radius: 10px; border: 1px solid #F1F5F9; text-align: center;">
                    <div style="font-size: 0.7rem; color: #64748B; text-transform: uppercase;">Gain Total</div>
                    <div id="statGain" style="font-size: 1.1rem; font-weight: 800; color: #3B49A2;">0 €</div>
                </div>
                <div style="background: white; padding: 10px; border-radius: 10px; border: 1px solid #F1F5F9; text-align: center;">
                    <div style="font-size: 0.7rem; color: #64748B; text-transform: uppercase;">Commandes</div>
                    <div id="statOrders" style="font-size: 1.1rem; font-weight: 800; color: #1E293B;">0</div>
                </div>
                <div style="background: white; padding: 10px; border-radius: 10px; border: 1px solid #F1F5F9; text-align: center;">
                    <div style="font-size: 0.7rem; color: #64748B; text-transform: uppercase;">Best Seller</div>
                    <div id="statBest" style="font-size: 0.9rem; font-weight: 700; color: #6366F1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">-</div>
                </div>
            </div>

            <div id="aiPerformanceAlert" style="display:none; background: #FEF2F2; padding: 15px; border-radius: 12px; color: #991B1B; font-weight: 700; margin-bottom: 20px; border-left: 4px solid #EF4444;">
                <i class="fas fa-exclamation-circle"></i> <span id="performanceAlertText"></span>
            </div>

            <div id="aiSummary" style="background: #EEF2FF; padding: 15px; border-radius: 12px; color: #3730A3; font-weight: 500; margin-bottom: 20px; border-left: 4px solid #6366F1;"></div>
            
            {# Sales Chart Section #}
            <div id="aiChartContainer" style="background: white; padding: 20px; border-radius: 15px; border: 1px solid #F1F5F9; margin-bottom: 25px;">
                <h4 style="margin-top:0; color: #1e293b; font-size:0.9rem; text-transform:uppercase;"><i class="fas fa-chart-area"></i> Évolution des Ventes (30 jours)</h4>
                <div style="height: 250px; width: 100%;">
                    <canvas id="salesChart"></canvas>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;">
                <div class="ai-card" style="background: white; padding: 18px; border-radius: 15px; border: 1px solid #F1F5F9;">
                    <h4 style="margin-top:0; color: #3B49A2; font-size:0.9rem; text-transform:uppercase;"><i class="fas fa-magic"></i> Optimisation des Prix</h4>
                    <div id="aiPriceOptimization" style="font-size:0.85rem; color:#475569;"></div>
                </div>
                <div class="ai-card" style="background: white; padding: 18px; border-radius: 15px; border: 1px solid #F1F5F9;">
                    <h4 style="margin-top:0; color: #D97706; font-size:0.9rem; text-transform:uppercase;"><i class="fas fa-clock"></i> Produits Stagnants</h4>
                    <div id="aiStagnant" style="font-size:0.85rem; color:#475569;"></div>
                </div>
                <div class="ai-card" style="background: white; padding: 18px; border-radius: 15px; border: 1px solid #F1F5F9;">
                    <h4 style="margin-top:0; color: #059669; font-size:0.9rem; text-transform:uppercase;"><i class="fas fa-coins"></i> Prévisions & Ruptures</h4>
                    <div id="aiForecastDetail" style="font-size:0.85rem; color:#475569;"></div>
                </div>
            </div>

            <div style="margin-top: 25px; padding-top: 20px; border-top: 1px solid #F1F5F9;">
                <h4 style="margin-top:0; color: #1e293b;"><i class="fas fa-lightbulb" style="color:#F59E0B;"></i> Conseils Stratégiques</h4>
                <ul id="aiStrategy" style="padding-left: 20px; color: #475569; font-size: 0.9rem;"></ul>
            </div>
        </div>
    </div>
</div>

<style>
@keyframes slideDown { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: translateY(0); } }
@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
#aiAnalyseBtn:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3); }
</style>

{% for message in app.flashes('success') %}
    <div style="padding: 15px; background: #DEF7EC; color: #03543F; border-radius: 10px; margin-bottom: 20px;">
        {{ message }}
    </div>
{% endfor %}

{# Filter Bar #}
<div style="margin-bottom: 25px; display: flex; gap: 15px; align-items: center; flex-wrap: wrap;">
    <form method="get" action="{{ path('admin_shop_index') }}" style="display: flex; gap: 10px; flex-grow: 1;">
        <div style="position: relative; flex-grow: 1;">
            <i class="fas fa-search" style="position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: #94A3B8;"></i>
            <input type="text" name="search" value="{{ currentFilters.search|default('') }}" placeholder="Rechercher par nom..." style="width: 100%; padding: 12px 12px 12px 45px; border: 1px solid #E2E8F0; border-radius: 12px; outline: none;">
        </div>
        
        <select name="category" style="padding: 12px; border: 1px solid #E2E8F0; border-radius: 12px; outline: none; background: white; min-width: 150px;">
            <option value="">Toutes les catégories</option>
            {% for cat in categories %}
                <option value="{{ cat.id }}" {{ currentFilters.category == cat.id ? 'selected' : '' }}>{{ cat.name }}</option>
            {% endfor %}
        </select>

        <button type="submit" class="btn btn-primary" style="background: #3B49A2; color: white; border-radius: 12px; padding: 10px 20px; border: none; cursor: pointer;">
            Filtrer
        </button>
        
        {% if currentFilters.search or currentFilters.category or currentSort != 'id' %}
            <a href="{{ path('admin_shop_index') }}" class="btn" style="padding: 10px; color: #64748B; text-decoration: none; display: flex; align-items: center;">
                <i class="fas fa-times"></i>
            </a>
        {% endif %}
    </form>
</div>

<div class="card" style="padding: 0; overflow: hidden; background: white; border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
    <table style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr style="text-align: left; background: #F8FAFC; border-bottom: 2px solid #F1F5F9; color: #64748B; font-size: 0.8rem; text-transform: uppercase;">
                <th style="padding: 20px;">
                    <a href="{{ path('admin_shop_index', app.request.query.all|merge({'sortBy': 'name', 'direction': currentSort == 'name' and currentDirection == 'ASC' ? 'DESC' : 'ASC'})) }}" style="text-decoration: none; color: inherit;">
                        Produit {% if currentSort == 'name' %}<i class="fas fa-sort-{{ currentDirection == 'ASC' ? 'up' : 'down' }}"></i>{% endif %}
                    </a>
                </th>
                <th style="padding: 20px;">
                    <a href="{{ path('admin_shop_index', app.request.query.all|merge({'sortBy': 'category', 'direction': currentSort == 'category' and currentDirection == 'ASC' ? 'DESC' : 'ASC'})) }}" style="text-decoration: none; color: inherit;">
                        Catégorie {% if currentSort == 'category' %}<i class="fas fa-sort-{{ currentDirection == 'ASC' ? 'up' : 'down' }}"></i>{% endif %}
                    </a>
                </th>
                <th style="padding: 20px;">
                    <a href="{{ path('admin_shop_index', app.request.query.all|merge({'sortBy': 'price', 'direction': currentSort == 'price' and currentDirection == 'ASC' ? 'DESC' : 'ASC'})) }}" style="text-decoration: none; color: inherit;">
                        Prix {% if currentSort == 'price' %}<i class="fas fa-sort-{{ currentDirection == 'ASC' ? 'up' : 'down' }}"></i>{% endif %}
                    </a>
                </th>
                <th style="padding: 20px;">
                    <a href="{{ path('admin_shop_index', app.request.query.all|merge({'sortBy': 'stock', 'direction': currentSort == 'stock' and currentDirection == 'ASC' ? 'DESC' : 'ASC'})) }}" style="text-decoration: none; color: inherit;">
                        Stock {% if currentSort == 'stock' %}<i class="fas fa-sort-{{ currentDirection == 'ASC' ? 'up' : 'down' }}"></i>{% endif %}
                    </a>
                </th>
                <th style="padding: 20px; text-align: right;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for product in products %}
                <tr style="border-bottom: 1px solid #F1F5F9; transition: 0.2s;" onmouseover="this.style.background='#FBFDFF'" onmouseout="this.style.background='transparent'">
                    <td style="padding: 20px; font-weight: 700; color: #1E293B;">
                        {{ product.name }}
                        <span id="score-badge-{{ product.id }}" class="performance-badge" style="display:none; margin-left:8px; font-size:10px; padding:2px 6px; border-radius:4px; font-weight:700; text-transform:uppercase;"></span>
                    </td>
                    <td style="padding: 20px;">
                        <span style="background: {{ product.category.color|default('#EEF2FF') }}; color: white; padding: 5px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 700;">
                            {{ product.category.name }}
                        </span>
                    </td>
                    <td style="padding: 20px; font-weight: 700; color: #3B49A2;">{{ product.price|number_format(2) }} €</td>
                    <td style="padding: 20px;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <div style="width: 8px; height: 8px; border-radius: 50%; background: {{ product.stock > 10 ? '#10B981' : '#F59E0B' }};"></div>
                            <span style="font-weight: 600;">{{ product.stock }}</span>
                        </div>
                    </td>
                    <td style="padding: 20px; text-align: right;">
                        <div style="display: flex; gap: 10px; justify-content: flex-end; align-items: center;">
                            <a href="{{ path('admin_shop_product_edit', {id: product.id}) }}" style="padding: 8px 12px; border-radius: 8px; color: #64748B; border: 1px solid #E2E8F0; text-decoration: none;">
                                <i class="fas fa-edit"></i>
                            </a>
                            
                            <form method="post" action="{{ path('admin_shop_product_delete', {id: product.id}) }}" onsubmit="return confirm('Supprimer ce produit ?');" style="display: inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
                                <button style="padding: 8px 12px; border-radius: 8px; color: #EF4444; border: 1px solid #E2E8F0; background: white; cursor: pointer;"> 
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" style="padding: 40px; text-align: center; color: #64748B;">Aucun produit en boutique.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<script>

let salesChart = null;

document.getElementById('aiAnalyseBtn').addEventListener('click', async function() {
    const resultsContainer = document.getElementById('aiAnalysisResults');
    const loading = document.getElementById('aiLoading');
    const content = document.getElementById('aiContent');
    
    resultsContainer.style.display = 'block';
    loading.style.display = 'block';
    content.style.display = 'none';
    
    resultsContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });

    try {
        const response = await fetch('{{ path("professor_ai_analytics") }}');
        const result = await response.json();

        if (result.success) {
            const data = result.data;
            const stats = result.stats;
            
            // Stats Bar
            document.getElementById('statGain').innerText = stats.totalGain;
            document.getElementById('statOrders').innerText = stats.orderCount;
            document.getElementById('statBest').innerText = stats.potentialGain; // Showing potential as best for now
            
            // Performance Alert
            const alertDiv = document.getElementById('aiPerformanceAlert');
            if (data.performance_alert) {
                alertDiv.style.display = 'block';
                document.getElementById('performanceAlertText').innerText = data.performance_alert;
            } else {
                alertDiv.style.display = 'none';
            }

            // UI Styling & Core Analysis
            document.getElementById('aiBusyWarning').style.display = result.is_limited ? 'block' : 'none';
            document.getElementById('aiSummary').innerText = data.summary;

            // Price Optimization
            const priceDiv = document.getElementById('aiPriceOptimization');
            priceDiv.innerHTML = '';
            const priceOps = Array.isArray(data.price_optimization) ? data.price_optimization : [];
            priceOps.forEach(po => {
                priceDiv.innerHTML += `
                    <div style="margin-bottom:12px; border-bottom:1px solid #F8FAFC; padding-bottom:8px;">
                        <strong>${po.product_name || 'Produit'}</strong>: 
                        <span style="color:#059669; font-weight:700;">${po.suggestion || '-'}</span><br>
                        <small style="color:#64748B;">${po.justification || ''}</small>
                    </div>`;
            });

            // Stagnant Products
            const stagnantDiv = document.getElementById('aiStagnant');
            stagnantDiv.innerHTML = '';
            const stagnantProds = Array.isArray(data.stagnant_products) ? data.stagnant_products : [];
            stagnantProds.forEach(sp => {
                stagnantDiv.innerHTML += `
                    <div style="margin-bottom:10px;">
                        <span style="color:#EF4444;"><i class="fas fa-history"></i></span> 
                        <strong>${sp.product_name || 'Produit'}</strong>: <br>
                        <small style="background:#FEF2F2; padding:2px 6px; border-radius:4px;">${sp.recommendation || ''}</small>
                    </div>`;
            });

            // Forecast Details
            const forecastDiv = document.getElementById('aiForecastDetail');
            const f = data.forecast || {};
            const stockRisks = Array.isArray(f.stock_out_risks) ? f.stock_out_risks : [];
            forecastDiv.innerHTML = `
                <div style="margin-bottom:15px;">
                    <div style="font-size:0.75rem; color:#64748B;">ESTIMATION 30 JOURS</div>
                    <div style="font-size:1.1rem; font-weight:800; color:#059669;">+ ${f.gain_30d_estimate || 0} €</div>
                </div>
                <div style="margin-bottom:10px;">
                    <div style="font-size:0.75rem; color:#64748B;">RISQUES DE RUPTURE</div>
                    <div style="color:#D97706;">${stockRisks.join(', ') || 'Aucun risque détecté'}</div>
                </div>
            `;

            // Strategy
            const strategyList = document.getElementById('aiStrategy');
            strategyList.innerHTML = '';
            const strategies = Array.isArray(data.strategy) ? data.strategy : [];
            strategies.forEach(s => {
                const li = document.createElement('li');
                li.style.marginBottom = '8px';
                li.innerText = s;
                strategyList.appendChild(li);
            });

            // Product Score Badges
            (result.product_scores || []).forEach(ps => {
                const badge = document.getElementById(`score-badge-${ps.id}`);
                if (badge) {
                    badge.style.display = 'inline-block';
                    badge.innerText = ps.label;
                    if (ps.label === 'Top') {
                        badge.style.background = '#D1FAE5';
                        badge.style.color = '#065F46';
                    } else if (ps.label === 'Moyen') {
                        badge.style.background = '#FEF3C7';
                        badge.style.color = '#92400E';
                    } else {
                        badge.style.background = '#FEE2E2';
                        badge.style.color = '#991B1B';
                    }
                }
            });

            // Chart Rendering
            const ctx = document.getElementById('salesChart').getContext('2d');
            if (salesChart) salesChart.destroy();
            salesChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: result.chart_data.labels,
                    datasets: [{
                        label: 'Ventes Journalières (€)',
                        data: result.chart_data.values,
                        borderColor: '#6366F1',
                        backgroundColor: 'rgba(99, 102, 241, 0.1)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 3,
                        pointRadius: 4,
                        pointBackgroundColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, grid: { color: '#F1F5F9' } },
                        x: { grid: { display: false } }
                    }
                }
            });

            loading.style.display = 'none';
            content.style.display = 'block';
        } else {
            throw new Error(result.error || 'Erreur inconnue');
        }
    } catch (error) {
        loading.innerHTML = `<div style="color:#EF4444; padding:20px;">
            <i class="fas fa-times-circle" style="font-size:2rem; margin-bottom:10px;"></i>
            <p>Erreur: ${error.message}</p>
            <button onclick="location.reload()" class="btn btn-outline" style="margin-top:10px;">Réessayer</button>
        </div>`;
    }
});
</script>
{% endblock %}
