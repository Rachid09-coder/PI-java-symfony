{% extends 'admin_layout.html.twig' %}

{% block title %}Gestion des Examens - EduSmart{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
<style>
.exam-manage-page { font-family: 'Plus Jakarta Sans', var(--text-primary); max-width: 1200px; margin: 0 auto; padding: 28px 24px 48px; }
.exam-manage-hero {
    background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 50%, #6366f1 100%);
    border-radius: 24px;
    padding: 36px 40px;
    margin-bottom: 32px;
    position: relative;
    overflow: hidden;
    color: #fff;
    animation: examManageHeroIn 0.6s ease-out;
}
@keyframes examManageHeroIn {
    from { opacity: 0; transform: translateY(-12px); }
    to { opacity: 1; transform: translateY(0); }
}
.exam-manage-hero::before {
    content: '';
    position: absolute;
    top: -40%;
    right: -10%;
    width: 320px; height: 320px;
    background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
    border-radius: 50%;
}
.exam-manage-hero-inner { position: relative; z-index: 2; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 24px; }
.exam-manage-hero-text h1 { font-size: 1.85rem; font-weight: 800; margin: 0 0 8px 0; letter-spacing: -0.02em; }
.exam-manage-hero-text p { margin: 0; opacity: 0.9; font-size: 0.95rem; font-weight: 500; }
.exam-manage-hero-stats { display: flex; align-items: center; gap: 20px; }
.exam-manage-hero-stat { background: rgba(255,255,255,0.2); backdrop-filter: blur(8px); padding: 14px 22px; border-radius: 16px; border: 1px solid rgba(255,255,255,0.25); }
.exam-manage-hero-stat-value { font-size: 1.6rem; font-weight: 800; display: block; line-height: 1; }
.exam-manage-hero-stat-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; opacity: 0.9; margin-top: 4px; }
.exam-manage-hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }
.exam-manage-btn { display: inline-flex; align-items: center; gap: 10px; padding: 14px 24px; border-radius: 14px; font-weight: 700; font-size: 0.95rem; text-decoration: none; transition: transform 0.2s, box-shadow 0.2s; border: none; cursor: pointer; }
.exam-manage-btn-outline { background: rgba(255,255,255,0.2); color: #fff; border: 2px solid rgba(255,255,255,0.4); }
.exam-manage-btn-outline:hover { background: rgba(255,255,255,0.3); color: #fff; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.15); }
.exam-manage-btn-primary { background: #fff; color: #4f46e5; }
.exam-manage-btn-primary:hover { color: #4338ca; transform: translateY(-2px); box-shadow: 0 12px 28px rgba(0,0,0,0.2); }

.exam-manage-toolbar { display: flex; gap: 16px; align-items: center; margin-bottom: 24px; flex-wrap: wrap; }
.exam-manage-search-wrap { position: relative; flex: 1; min-width: 220px; }
.exam-manage-search-wrap i { position: absolute; left: 18px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 0.95rem; transition: color 0.2s; }
.exam-manage-search-wrap:focus-within i { color: #6366f1; }
.exam-manage-search { width: 100%; padding: 14px 18px 14px 48px; border: 2px solid var(--border-color); border-radius: 14px; outline: none; background: var(--bg-secondary); color: var(--text-primary); font-size: 0.95rem; font-weight: 500; transition: border-color 0.2s, box-shadow 0.2s; }
.exam-manage-search:focus { border-color: #6366f1; box-shadow: 0 0 0 4px rgba(99,102,241,0.15); }
.exam-manage-sort-btn { display: inline-flex; align-items: center; gap: 10px; padding: 14px 22px; border: 2px solid var(--border-color); border-radius: 14px; background: var(--bg-secondary); color: var(--text-primary); font-weight: 600; font-size: 0.9rem; cursor: pointer; transition: all 0.2s; }
.exam-manage-sort-btn:hover { border-color: #6366f1; color: #6366f1; }

.exam-manage-card { background: var(--card-bg); border-radius: 20px; border: 1px solid var(--border-color); overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,0.04); }
.exam-manage-table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
.exam-manage-table thead { background: linear-gradient(90deg, rgba(99,102,241,0.06), rgba(124,58,237,0.04)); }
.exam-manage-table th { text-align: left; padding: 18px 24px; color: #64748b; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; border-bottom: 2px solid var(--border-color); }
.exam-manage-table tbody tr { border-bottom: 1px solid var(--border-color); transition: background 0.2s; animation: examManageRowIn 0.4s ease-out both; }
.exam-manage-table tbody tr:hover { background: rgba(99,102,241,0.04); }
.exam-manage-table tbody tr:last-child { border-bottom: none; }
@keyframes examManageRowIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
}
.exam-manage-table td { padding: 20px 24px; vertical-align: middle; }
.exam-manage-table .exam-title { font-weight: 800; color: var(--text-primary); font-size: 1rem; }
.exam-manage-table .exam-type { display: inline-block; padding: 6px 14px; border-radius: 999px; font-size: 0.75rem; font-weight: 700; background: linear-gradient(135deg, #eef2ff, #e0e7ff); color: #4f46e5; }
.exam-manage-table .exam-meta { color: #64748b; font-weight: 600; }
.exam-manage-actions { display: flex; gap: 8px; justify-content: flex-end; align-items: center; flex-wrap: wrap; }
.exam-manage-action { width: 40px; height: 40px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; text-decoration: none; border: 1px solid var(--border-color); background: var(--bg-secondary); color: var(--text-secondary); transition: all 0.2s; }
.exam-manage-action:hover { transform: translateY(-2px); border-color: transparent; }
.exam-manage-action-dash { color: #059669; }
.exam-manage-action-dash:hover { background: #059669; color: #fff; }
.exam-manage-action-questions { color: #6366f1; }
.exam-manage-action-questions:hover { background: #6366f1; color: #fff; }
.exam-manage-action-edit { color: #64748b; }
.exam-manage-action-edit:hover { background: #64748b; color: #fff; }
.exam-manage-action-delete { color: #ef4444; border: none; background: none; cursor: pointer; }
.exam-manage-action-delete:hover { background: #ef4444; color: #fff; }
.exam-manage-empty { text-align: center; padding: 64px 24px; color: #64748b; }
.exam-manage-empty-icon { width: 80px; height: 80px; margin: 0 auto 20px; border-radius: 22px; background: linear-gradient(135deg, rgba(99,102,241,0.12), rgba(124,58,237,0.08)); display: flex; align-items: center; justify-content: center; color: #6366f1; font-size: 2rem; }
.exam-manage-empty-title { font-size: 1.15rem; font-weight: 700; color: var(--text-primary); margin-bottom: 8px; }
.exam-manage-empty-btn { display: inline-flex; align-items: center; gap: 8px; margin-top: 20px; padding: 14px 28px; background: linear-gradient(135deg, #4f46e5, #6366f1); color: #fff; border-radius: 14px; text-decoration: none; font-weight: 700; transition: transform 0.2s, box-shadow 0.2s; }
.exam-manage-empty-btn:hover { color: #fff; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(79,70,229,0.4); }

.exam-manage-modal { display: none; position: fixed; inset: 0; background: rgba(15,23,42,0.5); backdrop-filter: blur(6px); z-index: 1000; align-items: center; justify-content: center; padding: 24px; animation: examManageModalBg 0.25s ease; }
.exam-manage-modal.open { display: flex; }
@keyframes examManageModalBg { from { opacity: 0; } to { opacity: 1; } }
.exam-manage-modal-box { background: var(--card-bg); border-radius: 24px; padding: 36px; width: 100%; max-width: 520px; box-shadow: 0 24px 48px rgba(0,0,0,0.15); animation: examManageModalIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); }
@keyframes examManageModalIn { from { opacity: 0; transform: scale(0.95) translateY(-10px); } to { opacity: 1; transform: scale(1) translateY(0); } }
.exam-manage-modal h3 { font-size: 1.35rem; font-weight: 800; margin-bottom: 24px; color: var(--text-primary); display: flex; align-items: center; gap: 12px; }
.exam-manage-modal h3 i { width: 44px; height: 44px; border-radius: 14px; background: linear-gradient(135deg, #6366f1, #7c3aed); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 1rem; }
.exam-manage-modal label { display: block; font-weight: 700; margin-bottom: 8px; font-size: 0.9rem; color: var(--text-primary); }
.exam-manage-modal input, .exam-manage-modal select, .exam-manage-modal textarea { width: 100%; padding: 14px 18px; border: 2px solid var(--border-color); border-radius: 12px; outline: none; background: var(--bg-secondary); color: var(--text-primary); font-size: 0.95rem; margin-bottom: 20px; }
.exam-manage-modal input:focus, .exam-manage-modal select:focus, .exam-manage-modal textarea:focus { border-color: #6366f1; }
.exam-manage-modal-actions { display: flex; gap: 14px; margin-top: 28px; }
.exam-manage-modal-actions button { flex: 1; padding: 14px; border-radius: 12px; font-weight: 700; cursor: pointer; transition: transform 0.2s; }
.exam-manage-modal-actions .btn-cancel { border: 2px solid var(--border-color); background: transparent; color: var(--text-secondary); }
.exam-manage-modal-actions .btn-submit { background: linear-gradient(135deg, #4f46e5, #6366f1); color: #fff; border: none; }
.exam-manage-modal-actions .btn-submit:hover { transform: translateY(-2px); }
</style>
{% endblock %}

{% block body %}
<div class="exam-manage-page">
    <header class="exam-manage-hero">
        <div class="exam-manage-hero-inner">
            <div class="exam-manage-hero-text">
                <h1><i class="fas fa-clipboard-list" style="margin-right: 10px;"></i> Examens & Évaluations</h1>
                <p>Créez et gérez vos examens, consultez les statistiques et les rendus.</p>
            </div>
            <div class="exam-manage-hero-stats">
                <div class="exam-manage-hero-stat">
                    <span class="exam-manage-hero-stat-value">{{ exams|length }}</span>
                    <span class="exam-manage-hero-stat-label">Examens</span>
                </div>
            </div>
            <div class="exam-manage-hero-actions">
                <button type="button" class="exam-manage-btn exam-manage-btn-outline" onclick="document.getElementById('eval-modal').classList.add('open')">
                    <i class="fas fa-plus"></i> Ajouter une Évaluation
                </button>
                <a href="{{ path('admin_exam_new') }}" class="exam-manage-btn exam-manage-btn-primary">
                    <i class="fas fa-plus-circle"></i> Créer un Examen
                </a>
            </div>
        </div>
    </header>

    <div class="exam-manage-toolbar">
        <div class="exam-manage-search-wrap">
            <i class="fas fa-search"></i>
            <input type="text" id="searchInput" class="exam-manage-search" placeholder="Rechercher un examen..." onkeyup="filterTable()">
        </div>
        <button type="button" class="exam-manage-sort-btn" id="sortBtn" onclick="sortTable()">
            <i class="fas fa-sort-alpha-down" id="sortIcon"></i>
            <span id="sortLabel">Trier A-Z</span>
        </button>
    </div>

    <div class="exam-manage-card">
        <table class="exam-manage-table">
            <thead>
                <tr>
                    <th>Titre de l'examen</th>
                    <th>Type</th>
                    <th>Questions</th>
                    <th>Durée</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for exam in exams %}
                <tr style="animation-delay: {{ loop.index0 * 0.04 }}s;">
                    <td><span class="exam-title">{{ exam.title }}</span></td>
                    <td><span class="exam-type">{{ exam.type }}</span></td>
                    <td class="exam-meta">{{ exam.questions|length }} questions</td>
                    <td class="exam-meta">{{ exam.duration ? exam.duration ~ ' min' : '—' }}</td>
                    <td style="text-align: right;">
                        <div class="exam-manage-actions">
                            <a href="{{ path('admin_exam_dashboard', {id: exam.id}) }}" class="exam-manage-action exam-manage-action-dash" title="Tableau de bord"><i class="fas fa-chart-line"></i></a>
                            <a href="{{ path('admin_exam_similarity', {id: exam.id}) }}" class="exam-manage-action" title="Similarité" style="color: #f59e0b;"><i class="fas fa-search"></i></a>
                            <a href="{{ path('admin_exam_questions', {id: exam.id}) }}" class="exam-manage-action exam-manage-action-questions" title="Questions"><i class="fas fa-list-ol"></i></a>
                            <a href="{{ path('admin_exam_edit', {id: exam.id}) }}" class="exam-manage-action exam-manage-action-edit" title="Modifier"><i class="fas fa-edit"></i></a>
                            <form method="post" action="{{ path('admin_exam_delete', {'id': exam.id}) }}" onsubmit="return confirm('Supprimer cet examen ?');" style="margin: 0; display: inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ exam.id) }}">
                                <button type="submit" class="exam-manage-action exam-manage-action-delete" title="Supprimer"><i class="fas fa-trash"></i></button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="5">
                        <div class="exam-manage-empty">
                            <div class="exam-manage-empty-icon"><i class="fas fa-clipboard-list"></i></div>
                            <div class="exam-manage-empty-title">Aucun examen</div>
                            <p>Créez votre premier examen pour commencer.</p>
                            <a href="{{ path('admin_exam_new') }}" class="exam-manage-empty-btn"><i class="fas fa-plus"></i> Créer un examen</a>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<div class="exam-manage-modal" id="eval-modal">
    <div class="exam-manage-modal-box">
        <h3><i class="fas fa-plus"></i> Ajouter une Évaluation</h3>
        <form>
            <label>Sélectionner l'examen cible</label>
            <select>
                <option>Contrôle Final: Algèbre</option>
                <option>QCM: Introduction IA</option>
            </select>
            <label>Énoncé de la question</label>
            <textarea rows="3" placeholder="Tapez votre question ici..."></textarea>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                <input type="text" placeholder="Réponse A (correcte)">
                <input type="text" placeholder="Réponse B">
                <input type="text" placeholder="Réponse C">
                <input type="text" placeholder="Réponse D">
            </div>
            <div class="exam-manage-modal-actions">
                <button type="button" class="btn-cancel" onclick="document.getElementById('eval-modal').classList.remove('open')">Annuler</button>
                <button type="button" class="btn-submit">Enregistrer</button>
            </div>
        </form>
</div>

<div class="admin-page animate-fade-in py-4">
    {# Orbes décoratives pour la touche futuriste #}
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>

    <div class="container-fluid position-relative z-index-2">
        <header class="mb-5 d-flex justify-content-between align-items-center flex-wrap gap-4">
            <div>
                <h1 class="h2 fw-900 text-dark mb-1">Examens & Évaluations</h1>
                <p class="text-muted small mb-0">Centre de commande des épreuves et du catalogue d'évaluations analytiques.</p>
            </div>
            <div class="d-flex flex-wrap gap-3">
                <button class="btn-premium-action shadow-sm" onclick="document.getElementById('eval-modal').style.display='flex'">
                    <i class="fas fa-plus-circle text-primary"></i> <span>Ajouter Évaluation</span>
                </button>
                <a href="{{ path('admin_exam_new') }}" class="btn-premium-launch px-4 shadow-lg">
                    <i class="fas fa-file-signature me-2"></i>
                    <span class="fw-800">Créer un Examen</span>
                </a>
            </div>
        </header>

        {# Search & Filter Bar - Futuristic Glass #}
        <div class="card card-premium-glass-sm shadow-sm mb-4 border-0">
            <div class="card-body p-3">
                <div class="row g-3">
                    <div class="col-md-9">
                        <div class="input-glow-wrapper">
                            <i class="fas fa-search search-icon-premium"></i>
                            <input type="text" id="searchInput" class="form-control-premium-search" placeholder="Rechercher une épreuve par titre ou métadonnée..." onkeyup="filterTable()">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <button onclick="sortTable()" id="sortBtn" class="btn-premium-action w-100 justify-content-center">
                            <i class="fas fa-sort-alpha-down me-2" id="sortIcon"></i>
                            <span>Trier A-Z</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card card-premium-glass shadow-lg border-0 overflow-hidden">
            <div class="card-header bg-transparent py-4 px-4 border-bottom border-light d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <div class="icon-pulse-blue me-3">
                        <i class="fas fa-vial text-primary"></i>
                    </div>
                    <h5 class="m-0 fw-800 text-dark">Catalogue des Épreuves Systémiques</h5>
                </div>
                <div class="badge-premium-logic">
                    <i class="fas fa-microchip me-2"></i> {{ exams|length }} instances actives
                </div>
            </div>
            
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover-premium align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Référentiel de l'Examen</th>
                                <th class="text-center">Classification</th>
                                <th class="text-center">Cours/Module</th>
                                <th class="text-center">Catégorie</th>
                                <th class="text-center">Structure</th>
                                <th class="text-center">Dimensions Time</th>
                                <th class="pe-4 text-end">Opérations</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for exam in exams %}
                            <tr class="animate-row-in">
                                <td class="ps-4">
                                    <div class="fw-800 text-dark mb-1">{{ exam.title }}</div>
                                    <div class="small text-muted font-monospace" style="font-size: 0.65rem;">UID: <span class="text-primary opacity-75">#{{ exam.id }}</span></div>
                                </td>
                                <td class="text-center">
                                    <span class="badge-hologram">
                                        {{ exam.type }}
                                    </span>
                                </td>
                                <td class="text-center">
                                    {% if exam.course %}
                                        <span class="badge bg-info text-white">{{ exam.course.title }}</span>
                                        {% if exam.course.coefficient %}
                                            <br><small class="text-muted">Coef: {{ exam.course.coefficient }}</small>
                                        {% endif %}
                                    {% elseif exam.moduleName %}
                                        <span class="text-secondary">{{ exam.moduleName }}</span>
                                        {% if exam.coefficient %}
                                            <br><small class="text-muted">Coef: {{ exam.coefficient }}</small>
                                        {% endif %}
                                    {% else %}
                                        <span class="text-muted">-</span>
                                    {% endif %}
                                </td>
                                <td class="text-center">
                                    {% if exam.gradeCategory == 'cc' %}
                                        <span class="badge bg-success">CC (10%)</span>
                                    {% elseif exam.gradeCategory == 'ds' %}
                                        <span class="badge bg-warning text-dark">DS (20%)</span>
                                    {% elseif exam.gradeCategory == 'exam' %}
                                        <span class="badge bg-danger">Exam (70%)</span>
                                    {% else %}
                                        <span class="text-muted">-</span>
                                    {% endif %}
                                    {% if exam.semester %}
                                        <br><small class="text-muted">S{{ exam.semester }}</small>
                                    {% endif %}
                                </td>
                                <td class="text-center">
                                    <div class="data-badge-blue">
                                        <i class="fas fa-tasks me-1 small"></i> {{ exam.questions|length }} Segments
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="date-capsule-sm">
                                        <i class="far fa-clock me-1 opacity-50"></i> {{ exam.duration ? exam.duration ~ ' min' : '∞' }}
                                    </div>
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="d-flex justify-content-end gap-2 action-btns">
                                        <a href="{{ path('admin_exam_questions', {id: exam.id}) }}" class="btn-action-premium text-primary" title="Build Architecture">
                                            <i class="fas fa-project-diagram"></i>
                                        </a>
                                        <a href="{{ path('admin_exam_edit', {id: exam.id}) }}" class="btn-action-premium text-warning" title="Edit Logic">
                                            <i class="fas fa-sliders-h"></i>
                                        </a>
                                        <form method="post" action="{{ path('admin_exam_delete', {'id': exam.id}) }}" onsubmit="return confirm('Confirmer la désactivation complète de ce protocole d\'examen ?');" class="m-0">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ exam.id) }}">
                                            <button class="btn-action-premium text-danger border-0">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <div class="empty-state-icon mb-3">
                                        <i class="fas fa-brain fa-3x opacity-20"></i>
                                    </div>
                                    <p class="text-muted fw-800">Aucune épreuve répertoriée dans le noyau.</p>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Ajout Évaluation Rapide - Futuristic Glass -->
<div id="eval-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.4); z-index: 1050; align-items: center; justify-content: center; backdrop-filter: blur(12px);">
    <div class="card card-premium-glass-modal shadow-2xl border-0 overflow-hidden" style="width: 600px; border-radius: 32px;">
        <div class="card-header bg-primary-gradient text-white p-4 border-0">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="m-0 fw-800"><i class="fas fa-plus-circle me-2"></i>Injecter une Évaluation</h5>
                <button type="button" class="btn-close-premium" onclick="document.getElementById('eval-modal').style.display='none'">&times;</button>
            </div>
        </div>
        <div class="card-body p-4 p-md-5">
            <form>
                <div class="mb-4">
                    <label class="label-premium">Protocole d'Examen Cible</label>
                    <div class="input-glow-wrapper">
                        <select class="form-select-premium">
                            {% for exam in exams %}
                                <option value="{{ exam.id }}">{{ exam.title }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <div class="mb-4">
                    <label class="label-premium">Énoncé Systémique</label>
                    <div class="input-glow-wrapper">
                        <textarea class="form-control-premium" rows="3" placeholder="Saisir la base de la question..."></textarea>
                    </div>
                </div>
                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <label class="label-premium small">Option Alpha (Correcte)</label>
                        <input type="text" class="form-control-premium border-success-subtle" placeholder="Correcte">
                    </div>
                    <div class="col-6">
                        <label class="label-premium small">Option Beta</label>
                        <input type="text" class="form-control-premium" placeholder="Distracteur B">
                    </div>
                    <div class="col-6">
                        <label class="label-premium small">Option Gamma</label>
                        <input type="text" class="form-control-premium" placeholder="Distracteur C">
                    </div>
                    <div class="col-6">
                        <label class="label-premium small">Option Delta</label>
                        <input type="text" class="form-control-premium" placeholder="Distracteur D">
                    </div>
                </div>
                <div class="d-flex gap-3 mt-4">
                    <button type="button" class="btn btn-premium-cancel flex-grow-1" onclick="document.getElementById('eval-modal').style.display='none'">Avorter</button>
                    <button type="button" class="btn-premium-launch flex-grow-2 py-3 px-5 shadow">Valider & Déployer</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    /* --- Futuristic Design System --- */
    .fw-900 { font-weight: 900; }
    .fw-800 { font-weight: 800; }
    .z-index-2 { z-index: 2; }
    .bg-primary-gradient { background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%); }
    
    /* Background Orbs */
    .orb {
        position: fixed;
        width: 600px;
        height: 600px;
        border-radius: 50%;
        filter: blur(130px);
        opacity: 0.08;
        z-index: 0;
        pointer-events: none;
        animation: floatOrb 35s infinite alternate ease-in-out;
    }
    .orb-1 { top: -200px; right: -100px; background: #6366f1; }
    .orb-2 { bottom: -200px; left: -100px; background: #4f46e5; }
    @keyframes floatOrb {
        from { transform: translate(0, 0) scale(1); }
        to { transform: translate(100px, 50px) scale(1.1) rotate(10deg); }
    }

    /* Glassmorphism Card */
    .card-premium-glass {
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(25px);
        border: 1px solid rgba(226, 232, 240, 0.5) !important;
        border-radius: 30px;
    }
    .card-premium-glass-sm {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(226, 232, 240, 0.4) !important;
        border-radius: 20px;
    }
    .card-premium-glass-modal {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(30px);
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    /* Table Styles */
    .table-hover-premium thead th {
        font-size: 0.72rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #94a3b8;
        padding: 22px 18px;
        border-bottom: 2px solid #f1f5f9;
        background: rgba(248, 250, 252, 0.4);
    }
    .table-hover-premium tbody td {
        padding: 22px 18px;
        border-bottom: 1px solid #f1f5f9;
        transition: all 0.3s ease;
    }
    .table-hover-premium tbody tr:hover {
        background: rgba(79, 70, 229, 0.03);
    }

    /* Buttons */
    .btn-premium-launch {
        background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
        color: white !important;
        border: none;
        padding: 14px 30px;
        border-radius: 50px;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        font-weight: 800;
    }
    .btn-premium-launch:hover {
        transform: translateY(-5px) scale(1.03);
        box-shadow: 0 15px 35px rgba(79, 70, 229, 0.25);
    }

    .btn-premium-action {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border: 1px solid #e2e8f0;
        padding: 12px 24px;
        border-radius: 50px;
        color: #64748b;
        font-weight: 800;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 12px;
        transition: all 0.3s ease;
    }
    .btn-premium-action:hover {
        background: #ffffff;
        color: #4f46e5;
        border-color: #4f46e5;
        box-shadow: 0 10px 20px rgba(0,0,0,0.05);
    }

    .btn-action-premium {
        width: 38px;
        height: 38px;
        border-radius: 14px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        color: inherit;
        text-decoration: none;
    }
    .btn-action-premium:hover {
        transform: scale(1.2) rotate(5deg);
        background: #fff;
        box-shadow: 0 8px 20px rgba(0,0,0,0.08);
    }

    /* Inputs */
    .form-control-premium-search {
        width: 100%;
        padding: 12px 18px 12px 50px;
        border-radius: 14px;
        border: 1px solid #f1f5f9;
        font-size: 0.95rem;
        background: #ffffff;
        transition: all 0.3s ease;
    }
    .form-control-premium-search:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
        outline: none;
    }
    .search-icon-premium {
        position: absolute;
        left: 20px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        font-size: 1.1rem;
    }

    /* Modal Form Elements */
    .label-premium {
        font-size: 0.72rem;
        font-weight: 800;
        text-transform: uppercase;
        color: #94a3b8;
        margin-bottom: 10px;
        display: block;
        letter-spacing: 0.05em;
    }
    .form-control-premium, .form-select-premium {
        width: 100%;
        padding: 14px 20px;
        border-radius: 16px;
        border: 2px solid #f1f5f9;
        font-size: 0.95rem;
        transition: all 0.3s ease;
    }
    .form-control-premium:focus, .form-select-premium:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 5px rgba(99, 102, 241, 0.08);
        outline: none;
    }

    .btn-premium-cancel {
        background: transparent;
        border: none;
        color: #94a3b8;
        font-weight: 800;
        transition: all 0.3s ease;
    }
    .btn-premium-cancel:hover { color: #64748b; }

    .btn-close-premium {
        background: none;
        border: none;
        color: white;
        font-size: 1.8rem;
        line-height: 1;
        opacity: 0.7;
        transition: transform 0.3s ease;
    }
    .btn-close-premium:hover { opacity: 1; transform: rotate(90deg); }

    /* Badges */
    .badge-hologram {
        background: #f1f5f9;
        color: #475569;
        font-weight: 800;
        font-size: 0.65rem;
        padding: 6px 12px;
        border-radius: 50px;
        text-transform: uppercase;
        border: 1px solid #e2e8f0;
    }
    .data-badge-blue {
        background: rgba(79, 70, 229, 0.08);
        color: #4f46e5;
        padding: 4px 12px;
        border-radius: 50px;
        font-weight: 800;
        font-size: 0.7rem;
        display: inline-block;
    }
    .date-capsule-sm {
        background: #f8fafc;
        padding: 4px 12px;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 700;
        color: #64748b;
        display: inline-block;
        border: 1px solid #f1f5f9;
    }

    .icon-pulse-blue {
        width: 48px;
        height: 48px;
        background: rgba(79, 70, 229, 0.08);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        animation: pulseBlue 4s infinite;
    }
    @keyframes pulseBlue {
        0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(79, 70, 229, 0.2); }
        70% { transform: scale(1.05); box-shadow: 0 0 0 12px rgba(79, 70, 229, 0); }
        100% { transform: scale(1); }
    }

    .badge-premium-logic {
        background: #f8fafc;
        color: #64748b;
        padding: 8px 18px;
        border-radius: 50px;
        font-weight: 800;
        font-size: 0.75rem;
        border: 1px solid #e2e8f0;
    }

    /* Animations */
    .animate-fade-in { animation: fadeIn 0.8s ease-out; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

    .animate-row-in { animation: rowIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) both; }
    @keyframes rowIn { from { opacity: 0; transform: translateX(-15px); } to { opacity: 1; transform: translateX(0); } }

    {% for i in 1..20 %}
    .animate-row-in:nth-child({{ i }}) { animation-delay: {{ 0.04 * i }}s; }
    {% endfor %}

    .flex-grow-2 { flex-grow: 2; }
</style>

<script>
function filterTable() {
    var input = document.getElementById('searchInput');
    var filter = input.value.toLowerCase();
    var tbody = document.querySelector('.exam-manage-table tbody');
    if (!tbody) return;
    var rows = tbody.getElementsByTagName('tr');
    for (var i = 0; i < rows.length; i++) {
        var td = rows[i].getElementsByTagName('td')[0];
        if (!td || td.querySelector('.exam-manage-empty')) { rows[i].style.display = ''; continue; }
        var text = (td.textContent || td.innerText || '').toLowerCase();
        rows[i].style.display = text.indexOf(filter) > -1 ? '' : 'none';
    }
}
var sortAscending = true;
function sortTable() {
    var tbody = document.querySelector('.exam-manage-table tbody');
    if (!tbody) {
        const table = document.querySelector('table tbody');
        if (table) {
            const rows = Array.from(table.getElementsByTagName('tr'));
            if (rows.length === 1 && rows[0].innerText.includes('Aucun')) return;
            rows.sort((a, b) => {
                const aText = a.getElementsByTagName('td')[0]?.textContent.trim() || '';
                const bText = b.getElementsByTagName('td')[0]?.textContent.trim() || '';
                return sortAscending ? aText.localeCompare(bText, 'fr', { sensitivity: 'base' }) : bText.localeCompare(aText, 'fr', { sensitivity: 'base' });
            });
            rows.forEach(r => table.appendChild(r));
            const sortBtn = document.getElementById('sortBtn');
            const sortIcon = document.getElementById('sortIcon');
            sortAscending = !sortAscending;
            if (sortIcon) sortIcon.className = sortAscending ? 'fas fa-sort-alpha-down me-2' : 'fas fa-sort-alpha-up me-2';
            if (sortBtn && sortBtn.querySelector('span')) sortBtn.querySelector('span').textContent = sortAscending ? 'Trier A-Z' : 'Trier Z-A';
        }
        return;
    }
    var rows = Array.prototype.slice.call(tbody.getElementsByTagName('tr'));
    var emptyRow = rows.find(function(r) { return r.querySelector('.exam-manage-empty'); });
    var dataRows = emptyRow ? rows.filter(function(r) { return r !== emptyRow; }) : rows;
    dataRows.sort(function(a, b) {
        var aText = (a.getElementsByTagName('td')[0] && (a.getElementsByTagName('td')[0].textContent || '').trim()) || '';
        var bText = (b.getElementsByTagName('td')[0] && (b.getElementsByTagName('td')[0].textContent || '').trim()) || '';
        return sortAscending ? aText.localeCompare(bText, 'fr', { sensitivity: 'base' }) : bText.localeCompare(aText, 'fr', { sensitivity: 'base' });
    });
    dataRows.forEach(function(r) { tbody.appendChild(r); });
    if (emptyRow) tbody.appendChild(emptyRow);
    sortAscending = !sortAscending;
    document.getElementById('sortIcon').className = sortAscending ? 'fas fa-sort-alpha-down' : 'fas fa-sort-alpha-up';
    var sortLabel = document.getElementById('sortLabel');
    if (sortLabel) sortLabel.textContent = sortAscending ? 'Trier A-Z' : 'Trier Z-A';
}
document.getElementById('eval-modal').addEventListener('click', function(e) {
    if (e.target === this) this.classList.remove('open');
});
</script>
{% endblock %}
