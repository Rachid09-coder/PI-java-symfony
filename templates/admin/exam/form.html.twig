{% extends 'admin_layout.html.twig' %}

{% block title %}{{ isEdit ? 'Modifier l\'Examen' : 'Créer un Nouvel Examen' }} - EduSmart{% endblock %}

{% block body %}
<div class="mb-4">
    <a href="{{ path('admin_exams_manage') }}" class="btn btn-link p-0 text-decoration-none">
        <i class="fas fa-arrow-left me-1"></i> Retour à la gestion
    </a>
    <h1 class="h3 mt-2">{{ isEdit ? 'Modifier l\'Examen' : 'Créer un Nouvel Examen' }}</h1>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow border-0 overflow-hidden">
            <div class="card-header bg-primary py-3">
                <h6 class="m-0 font-weight-bold text-white">Informations de l'Évaluation</h6>
            </div>
            <div class="card-body p-4">
                {{ form_start(form) }}
                    <div class="mb-3">
                        {{ form_label(form.title, 'Titre de l\'examen') }}
                        {{ form_widget(form.title, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Contrôle Final Algèbre'}}) }}
                        {{ form_errors(form.title) }}
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.duration, 'Durée (minutes)') }}
                            {{ form_widget(form.duration, {'attr': {'class': 'form-control', 'placeholder': '60'}}) }}
                            {{ form_errors(form.duration) }}
                        </div>
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.type) }}
                            {{ form_widget(form.type, {'attr': {'class': 'form-select'}}) }}
                            {{ form_errors(form.type) }}
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.externalLink, 'Lien Externe (Optionnel)') }}
                            {{ form_widget(form.externalLink, {'attr': {'class': 'form-control', 'placeholder': 'https://...'}}) }}
                            {{ form_errors(form.externalLink) }}
                        </div>
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.filePath, 'Fichier Exam (PDF)') }}
                            {{ form_widget(form.filePath, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.filePath) }}
                        </div>
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.description, 'Description / Consignes') }}
                        {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 3, 'placeholder': 'Calculatrice autorisée, etc.'}}) }}
                        {{ form_errors(form.description) }}
                    </div>

                    {# Section Bulletin / Notes #}
                    <div class="card bg-light border-0 p-3 mb-3">
                        <h6 class="text-primary mb-3"><i class="fas fa-graduation-cap me-2"></i>Paramètres Bulletin</h6>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                {{ form_label(form.course, 'Cours associé') }}
                                {{ form_widget(form.course, {'attr': {'class': 'form-select'}}) }}
                                <small class="text-muted">Le coefficient sera récupéré automatiquement du cours</small>
                                {{ form_errors(form.course) }}
                            </div>
                            <div class="col-md-6 mb-3">
                                {{ form_label(form.gradeCategory, 'Catégorie de note') }}
                                {{ form_widget(form.gradeCategory, {'attr': {'class': 'form-select'}}) }}
                                <small class="text-muted">CC (Quiz/QCM) = 10%, DS = 20%, Exam = 70%</small>
                                {{ form_errors(form.gradeCategory) }}
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                {{ form_label(form.moduleName, 'Nom du module (si pas de cours)') }}
                                {{ form_widget(form.moduleName, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Mathématiques'}}) }}
                                {{ form_errors(form.moduleName) }}
                            </div>
                            <div class="col-md-4 mb-3">
                                {{ form_label(form.academicYear, 'Année académique') }}
                                {{ form_widget(form.academicYear, {'attr': {'class': 'form-control', 'placeholder': '2025-2026'}}) }}
                                {{ form_errors(form.academicYear) }}
                            </div>
                            <div class="col-md-4 mb-3">
                                {{ form_label(form.semester, 'Semestre') }}
                                {{ form_widget(form.semester, {'attr': {'class': 'form-select'}}) }}
                                {{ form_errors(form.semester) }}
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                {{ form_label(form.coefficient, 'Coefficient (si pas de cours)') }}
                                {{ form_widget(form.coefficient, {'attr': {'class': 'form-control', 'placeholder': '1'}}) }}
                                {{ form_errors(form.coefficient) }}
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4">
                        <button type="submit" class="btn btn-primary d-flex align-items-center gap-2 px-4 shadow">
                            <i class="fas fa-save fs-5"></i>
                            <span class="fw-bold">Enregistrer l'Examen</span>
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
