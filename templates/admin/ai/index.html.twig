function displayError(message) {
    document.getElementById('resultsTitle').textContent = 'Erreur';
    document.getElementById('resultsSubtitle').textContent = '';
    
    document.getElementById('resultsContent').innerHTML = `
        <div class="alert alert-danger border-0" style="border-radius: 12px;">
            <i class="fas fa-exclamation-circle me-2"></i>${escapeHtml(message)}
        </div>
    `;
    document.getElementById('resultsContainer').style.display = 'block';
}

function closeResults() {
    document.getElementById('resultsContainer').style.display = 'none';
}

function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

// ===== NOUVELLES FONCTIONNALITÉS AI =====

async function predictSuccess() {
    showLoading('Prédiction de réussite en cours... (analyse de tous les étudiants)');

    try {
        const response = await fetch('/admin/ai/predict-success');
        const data = await response.json();

        if (data.success) {
            displayPrediction(data);
        } else {
            displayError(data.error || 'Erreur lors de la prédiction');
        }
    } catch (error) {
        displayError('Erreur de connexion: ' + error.message);
    }
}

async function detectAnomalies() {
    showLoading('Détection d\'anomalies en cours... (audit de tous les bulletins)');

    try {
        const response = await fetch('/admin/ai/detect-anomalies');
        const data = await response.json();

        if (data.success) {
            displayAnomalies(data);
        } else {
            displayError(data.error || 'Erreur lors de la détection');
        }
    } catch (error) {
        displayError('Erreur de connexion: ' + error.message);
    }
}

async function certificationOverview() {
    showLoading('Audit des certifications en cours...');

    try {
        const response = await fetch('/admin/ai/certification-overview');
        const data = await response.json();

        if (data.success) {
            displayCertOverview(data);
        } else {
            displayError(data.error || 'Erreur lors de l\'audit');
        }
    } catch (error) {
        displayError('Erreur de connexion: ' + error.message);
    }
}

async function suggestCertifications() {
    showLoading('Analyse des éligibilités en cours...');

    try {
        const response = await fetch('/admin/ai/suggest-certifications');
        const data = await response.json();

        if (data.success) {
