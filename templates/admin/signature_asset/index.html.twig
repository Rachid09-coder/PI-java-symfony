{% extends 'admin_layout.html.twig' %}

{% block title %}Signatures & Cachets Officiels - EduSmart{% endblock %}

{% block body %}
<div class="admin-page animate-fade-in py-4">
    {# Orbes decoratives #}
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>

    <div class="container-fluid position-relative z-index-2">
        
        {# Header #}
        <header class="mb-5 d-flex justify-content-between align-items-center flex-wrap gap-4">
            <div>
                <h1 class="h2 fw-900 text-dark mb-1">
                    <i class="fas fa-fingerprint text-primary me-2"></i>
                    Signatures & Cachets Officiels
                </h1>
                <p class="text-muted small mb-0">Gestion securisee des actifs d'authentification institutionnelle.</p>
            </div>
            <div class="d-flex flex-wrap gap-3">
                <a href="{{ path('admin_signature_asset_new') }}" class="btn-premium-launch shadow">
                    <i class="fas fa-plus-circle me-2"></i>
                    Ajouter un actif
                </a>
                <a href="{{ path('admin_bulletin_index') }}" class="btn-premium-action shadow-sm">
                    <i class="fas fa-clipboard-list text-primary"></i> <span>Bulletins</span>
                </a>
                <a href="{{ path('admin_certification_index') }}" class="btn-premium-action shadow-sm">
                    <i class="fas fa-certificate text-primary"></i> <span>Certifications</span>
                </a>
            </div>
        </header>

        {# Stats Cards #}
        <div class="row g-4 mb-5">
            {% set signatures = 0 %}
            {% set cachets = 0 %}
            {% for asset in assets %}
                {% if 'signature' in asset.label|lower %}{% set signatures = signatures + 1 %}
                {% else %}{% set cachets = cachets + 1 %}{% endif %}
            {% endfor %}
            
            <div class="col-md-4">
                <div class="stat-card-sig shadow-sm">
                    <div class="stat-icon bg-primary-soft"><i class="fas fa-database text-primary"></i></div>
                    <div class="stat-content">
                        <div class="stat-value">{{ assets|length }}</div>
                        <div class="stat-label">Total Actifs</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card-sig shadow-sm">
                    <div class="stat-icon bg-success-soft"><i class="fas fa-pen-nib text-success"></i></div>
                    <div class="stat-content">
                        <div class="stat-value">{{ signatures }}</div>
                        <div class="stat-label">Signatures</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card-sig shadow-sm">
                    <div class="stat-icon bg-info-soft"><i class="fas fa-stamp text-info"></i></div>
                    <div class="stat-content">
                        <div class="stat-value">{{ cachets }}</div>
                        <div class="stat-label">Cachets</div>
                    </div>
                </div>
            </div>
        </div>

        {# Assets Grid #}
        <div class="row g-4">
            {% for asset in assets %}
            <div class="col-lg-4 col-xl-3">
                <div class="asset-card shadow-lg animate-card-in">
                    <div class="asset-card-header">
                        <div class="asset-type-badge">
                            {% if 'signature' in asset.label|lower %}
                                <i class="fas fa-pen-nib text-success"></i>
                            {% else %}
                                <i class="fas fa-stamp text-info"></i>
                            {% endif %}
                        </div>
                        <div class="asset-date-badge">
                            <i class="far fa-calendar me-1"></i>{{ asset.createdAt|date('d/m/Y') }}
                        </div>
                    </div>
                    
                    <div class="asset-preview-zone">
                        <div class="asset-preview-frame">
                            <img src="{{ asset(asset.imagePath) }}" class="img-fluid" alt="{{ asset.label }}">
                        </div>
                    </div>
                    
                    <div class="asset-card-body">
                        <h6 class="asset-title">{{ asset.label }}</h6>
                        <p class="asset-meta">
                            <i class="fas fa-shield-alt me-1 text-success"></i> Actif securise
                        </p>
                    </div>
                    
                    <div class="asset-card-footer">
                        <form action="{{ path('admin_signature_asset_delete', {id: asset.id}) }}" 
                              method="POST" 
                              onsubmit="return confirm('Etes-vous sur de vouloir supprimer cet actif ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_asset_' ~ asset.id) }}">
                            <button type="submit" class="btn-delete-asset">
                                <i class="fas fa-trash-alt me-2"></i>Supprimer
                            </button>
                        </form>
                    </div>
                </div>
            </div>
            {% else %}
            {# Empty State #}
            <div class="col-12">
                <div class="empty-state-premium">
                    <div class="empty-icon-wrapper">
                        <i class="fas fa-fingerprint fa-4x"></i>
                    </div>
                    <h4 class="fw-900 text-dark mt-4 mb-2">Aucun actif disponible</h4>
                    <p class="text-muted mb-4">Initialisez le depot de signatures et cachets pour authentifier vos documents officiels.</p>
                    <a href="{{ path('admin_signature_asset_new') }}" class="btn-premium-launch shadow-lg">
                        <i class="fas fa-rocket me-2"></i>Initialiser le depot
                    </a>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</div>

<style>
    .fw-900 { font-weight: 900; }
    .fw-800 { font-weight: 800; }
    .z-index-2 { z-index: 2; }
    .orb { position: fixed; width: 600px; height: 600px; border-radius: 50%; filter: blur(130px); opacity: 0.08; z-index: 0; pointer-events: none; }
    .orb-1 { top: -100px; left: -100px; background: #4f46e5; }
    .orb-2 { bottom: -100px; right: -100px; background: #10b981; }

    .stat-card-sig { background: white; border-radius: 20px; padding: 25px; display: flex; align-items: center; gap: 20px; transition: all 0.3s ease; }
    .stat-card-sig:hover { transform: translateY(-5px); box-shadow: 0 15px 35px rgba(0,0,0,0.1) !important; }
    .stat-icon { width: 60px; height: 60px; border-radius: 18px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; }
    .stat-value { font-size: 2rem; font-weight: 900; color: #1E293B; }
    .stat-label { font-size: 0.8rem; font-weight: 700; color: #64748B; text-transform: uppercase; letter-spacing: 0.05em; }
    .bg-primary-soft { background: rgba(99, 102, 241, 0.1); }
    .bg-success-soft { background: rgba(16, 185, 129, 0.1); }
    .bg-info-soft { background: rgba(59, 130, 246, 0.1); }

    .asset-card { background: white; border-radius: 24px; overflow: hidden; transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); }
    .asset-card:hover { transform: translateY(-8px); box-shadow: 0 25px 50px rgba(0,0,0,0.15) !important; }
    .asset-card-header { padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #f1f5f9; }
    .asset-type-badge { width: 40px; height: 40px; border-radius: 12px; background: #F1F5F9; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; }
    .asset-date-badge { font-size: 0.75rem; font-weight: 600; color: #94A3B8; }
    .asset-preview-zone { position: relative; height: 160px; background: linear-gradient(135deg, #F8FAFC 0%, #E2E8F0 100%); display: flex; align-items: center; justify-content: center; overflow: hidden; }
    .asset-preview-frame { max-width: 140px; max-height: 120px; z-index: 1; }
    .asset-preview-frame img { max-height: 120px; object-fit: contain; filter: drop-shadow(0 4px 10px rgba(0,0,0,0.1)); }
    .asset-card-body { padding: 20px; text-align: center; }
    .asset-title { font-weight: 800; color: #1E293B; margin-bottom: 8px; font-size: 1rem; }
    .asset-meta { font-size: 0.8rem; color: #64748B; margin: 0; }
    .asset-card-footer { padding: 16px 20px; border-top: 1px solid #f1f5f9; }
    .btn-delete-asset { width: 100%; background: #FEE2E2; color: #DC2626; border: none; padding: 12px; border-radius: 12px; font-weight: 700; font-size: 0.85rem; cursor: pointer; transition: all 0.2s ease; }
    .btn-delete-asset:hover { background: #DC2626; color: white; transform: scale(1.02); }

    .empty-state-premium { padding: 100px 40px; background: linear-gradient(135deg, rgba(255,255,255,0.95), rgba(248,250,252,0.95)); border-radius: 30px; text-align: center; border: 2px dashed #E2E8F0; }
    .empty-icon-wrapper { position: relative; display: inline-flex; align-items: center; justify-content: center; color: #94A3B8; }

    .btn-premium-launch { background: linear-gradient(135deg, #4f46e5, #6366f1); color: white; border: none; padding: 14px 32px; border-radius: 50px; font-weight: 700; transition: all 0.3s ease; text-decoration: none; display: inline-flex; align-items: center; }
    .btn-premium-launch:hover { transform: translateY(-3px); box-shadow: 0 15px 30px rgba(79, 70, 229, 0.35); color: white; }
    .btn-premium-action { background: white; color: #1E293B; border: 1px solid #E2E8F0; padding: 12px 20px; border-radius: 14px; font-weight: 700; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 10px; text-decoration: none; transition: all 0.3s ease; }
    .btn-premium-action:hover { background: #F8FAFC; border-color: #6366F1; color: #4F46E5; transform: translateY(-2px); }

    .animate-fade-in { animation: fadeIn 0.6s ease-out; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    .animate-card-in { animation: cardIn 0.5s ease-out; }
    @keyframes cardIn { from { opacity: 0; transform: translateY(20px) scale(0.95); } to { opacity: 1; transform: translateY(0) scale(1); } }
</style>
{% endblock %}
