{% extends 'admin_layout.html.twig' %}

{% block title %}Ajouter une Signature/Cachet - EduSmart{% endblock %}

{% block body %}
<div class="admin-page animate-fade-in py-4">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>

    <div class="container-fluid position-relative z-index-2">
        <header class="mb-5">
            <a href="{{ path('admin_signature_asset_index') }}" class="btn-back-premium mb-3">
                <i class="fas fa-arrow-left me-2"></i> Retour aux Actifs
            </a>
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div>
                    <h1 class="h2 fw-900 text-dark mb-1">
                        <i class="fas fa-fingerprint text-primary me-2"></i>
                        Nouvel Actif Officiel
                    </h1>
                    <p class="text-muted small mb-0">Ajoutez un logo, signature ou cachet pour les documents officiels.</p>
                </div>
                <div class="badge-premium-logic">
                    <i class="fas fa-upload me-2"></i> Upload Securise
                </div>
            </div>
        </header>

        <div class="row justify-content-center">
            <div class="col-xl-8">
                <div class="card card-premium-glass shadow-lg border-0 overflow-hidden">
                    <div class="card-header bg-transparent border-0 py-4 px-4 px-md-5">
                        <div class="d-flex align-items-center">
                            <div class="icon-pulse-blue me-3">
                                <i class="fas fa-signature text-primary"></i>
                            </div>
                            <div>
                                <h4 class="fw-800 text-dark mb-0">Configuration de l'Actif</h4>
                                <p class="text-muted small mb-0">Definissez le type et uploadez l'image.</p>
                            </div>
                        </div>
                    </div>

                    <div class="card-body p-4 p-md-5 pt-0">
                        {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'id': 'signature-form'}}) }}
                        
                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="form-group-premium">
                                    {{ form_label(form.label, 'Nom de l\'element', {'label_attr': {'class': 'form-label fw-700 text-dark'}}) }}
                                    {{ form_widget(form.label, {'attr': {'class': 'form-control form-control-lg rounded-3', 'placeholder': 'Ex: Signature du Directeur'}}) }}
                                    {{ form_errors(form.label) }}
                                    <div class="error-message" id="label-error"></div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group-premium">
                                    {{ form_label(form.type, 'Type d\'element', {'label_attr': {'class': 'form-label fw-700 text-dark'}}) }}
                                    {{ form_widget(form.type, {'attr': {'class': 'form-select form-select-lg rounded-3'}}) }}
                                    {{ form_errors(form.type) }}
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-group-premium">
                                    {{ form_label(form.imageFile, 'Fichier Image', {'label_attr': {'class': 'form-label fw-700 text-dark'}}) }}
                                    <div class="upload-zone p-4 rounded-4 text-center">
                                        {{ form_widget(form.imageFile, {'attr': {'class': 'form-control form-control-lg rounded-3'}}) }}
                                        <div class="mt-3 text-muted small">
                                            <i class="fas fa-info-circle me-1"></i>
                                            PNG recommande (fond transparent). Max 2Mo.
                                        </div>
                                    </div>
                                    {{ form_errors(form.imageFile) }}
                                </div>
                            </div>
                        </div>

                        <div class="mt-5 d-flex justify-content-between align-items-center gap-3">
                            <a href="{{ path('admin_signature_asset_index') }}" class="btn btn-outline-secondary px-4 rounded-pill">
                                <i class="fas fa-times me-2"></i>Annuler
                            </a>
                            <button type="submit" class="btn-premium-launch shadow">
                                <i class="fas fa-save me-2"></i>
                                <span class="fw-bold">Enregistrer l'Actif</span>
                            </button>
                        </div>
                        
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .fw-900 { font-weight: 900; }
    .fw-800 { font-weight: 800; }
    .fw-700 { font-weight: 700; }
    .z-index-2 { z-index: 2; }
    .orb { position: fixed; width: 600px; height: 600px; border-radius: 50%; filter: blur(130px); opacity: 0.08; z-index: 0; pointer-events: none; }
    .orb-1 { top: -100px; left: -100px; background: #4f46e5; }
    .orb-2 { bottom: -100px; right: -100px; background: #10b981; }
    .card-premium-glass { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(25px); border: 1px solid rgba(226, 232, 240, 0.5) !important; border-radius: 30px !important; }
    .icon-pulse-blue { width: 56px; height: 56px; background: rgba(99, 102, 241, 0.1); border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; }
    .btn-back-premium { display: inline-flex; align-items: center; color: #64748b; text-decoration: none; font-weight: 600; transition: all 0.2s ease; padding: 8px 16px; border-radius: 10px; background: rgba(241, 245, 249, 0.8); }
    .btn-back-premium:hover { color: #4f46e5; background: #EEF2FF; transform: translateX(-3px); }
    .badge-premium-logic { background: rgba(16, 185, 129, 0.1); color: #10b981; padding: 10px 18px; border-radius: 50px; font-weight: 700; font-size: 0.85rem; }
    .form-control:focus, .form-select:focus { border-color: #6366f1; box-shadow: 0 0 0 0.2rem rgba(99, 102, 241, 0.15); }
    .form-control-lg, .form-select-lg { padding: 14px 18px; font-size: 1rem; }
    .upload-zone { background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); border: 2px dashed #e2e8f0; transition: all 0.3s ease; }
    .upload-zone:hover { border-color: #6366f1; background: #EEF2FF; }
    .btn-premium-launch { background: linear-gradient(135deg, #4f46e5, #6366f1); color: white; border: none; padding: 14px 32px; border-radius: 50px; font-weight: 700; transition: all 0.3s ease; text-decoration: none; display: inline-flex; align-items: center; }
    .btn-premium-launch:hover { transform: translateY(-3px); box-shadow: 0 15px 30px rgba(79, 70, 229, 0.35); color: white; }
    .field-error { border-color: #dc2626 !important; background-color: #fef2f2 !important; }
    .error-message { color: #dc2626; font-size: 0.85rem; font-weight: 600; margin-top: 6px; display: none; }
    .error-message.show { display: block; }
    .animate-fade-in { animation: fadeIn 0.6s ease-out; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-5px); } 75% { transform: translateX(5px); } }
    .field-error { animation: shake 0.4s ease; }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var form = document.getElementById('signature-form');
    if (form) {
        form.addEventListener('submit', function(e) {
            form.querySelectorAll('.field-error').forEach(el => el.classList.remove('field-error'));
            
            var isValid = true;
            var requiredFields = form.querySelectorAll('[required]');
            
            requiredFields.forEach(function(field) {
                if (!field.value || field.value.trim() === '') {
                    field.classList.add('field-error');
                    isValid = false;
                }
            });
            
            if (!isValid) {
                e.preventDefault();
                var firstError = form.querySelector('.field-error');
                if (firstError) {
                    firstError.focus();
                    firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            }
        });
        
        form.querySelectorAll('input, select, textarea').forEach(function(field) {
            field.addEventListener('input', function() {
                this.classList.remove('field-error');
            });
        });
    }
});
</script>
{% endblock %}
