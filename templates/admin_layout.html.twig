<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}EduSmart - Dashboard Professeur{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        
        <!-- Favicon EduSmart -->
        <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><defs><linearGradient id='grad' x1='0%25' y1='0%25' x2='100%25' y2='100%25'><stop offset='0%25' style='stop-color:%236366F1'/><stop offset='100%25' style='stop-color:%238B5CF6'/></linearGradient></defs><rect width='100' height='100' rx='20' fill='url(%23grad)'/><text x='50' y='70' font-family='Arial,sans-serif' font-size='60' font-weight='bold' fill='white' text-anchor='middle'>E</text></svg>">
        
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
        
        <!-- Flatpickr Calendar -->
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/airbnb.css">
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
        <style>
            :root {
                --bg-primary: #F8FAFC;
                --bg-secondary: white;
                --bg-sidebar: #1E293B;
                --text-primary: #1E293B;
                --text-secondary: #64748B;
                --text-sidebar: white;
                --border-color: #E2E8F0;
                --card-bg: white;
            }

            [data-theme="dark"] {
                --bg-primary: #0F172A;
                --bg-secondary: #1E293B;
                --bg-sidebar: #0F172A;
                --text-primary: #F1F5F9;
                --text-secondary: #94A3B8;
                --text-sidebar: #F1F5F9;
                --border-color: #334155;
                --card-bg: #1E293B;
            }

            body {
                background: var(--bg-primary) !important;
                color: var(--text-primary);
                transition: background 0.3s, color 0.3s;
            }

            .sidebar {
                background: var(--bg-sidebar) !important;
            }

            .header {
                background: var(--bg-secondary) !important;
                border-bottom: 1px solid var(--border-color) !important;
            }

            .card {
                background: var(--card-bg) !important;
                color: var(--text-primary);
                border-color: var(--border-color) !important;
            }

            .page-title {
                color: var(--text-primary) !important;
            }

            .theme-toggle {
                width: 40px;
                height: 40px;
                border-radius: 12px;
                background: var(--bg-primary);
                border: 1px solid var(--border-color);
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                transition: 0.3s;
                color: var(--text-primary);
            }

            .theme-toggle:hover {
                transform: scale(1.1);
            }

            /* ========== DARK MODE COMPREHENSIVE TEXT FIXES ========== */
            [data-theme="dark"] .text-dark {
                color: #F1F5F9 !important;
            }

            [data-theme="dark"] .text-muted {
                color: #94A3B8 !important;
            }

            [data-theme="dark"] h1, [data-theme="dark"] h2, [data-theme="dark"] h3,
            [data-theme="dark"] h4, [data-theme="dark"] h5, [data-theme="dark"] h6 {
                color: #F1F5F9 !important;
            }

            [data-theme="dark"] p {
                color: #CBD5E1 !important;
            }

            [data-theme="dark"] span {
                color: #CBD5E1;
            }

            [data-theme="dark"] label, [data-theme="dark"] .form-label {
                color: #E2E8F0 !important;
            }

            [data-theme="dark"] .form-select, [data-theme="dark"] .form-control {
                background-color: #334155 !important;
                color: #F1F5F9 !important;
                border-color: #475569 !important;
            }

            [data-theme="dark"] .form-select option {
                background-color: #1E293B;
                color: #F1F5F9;
            }

            [data-theme="dark"] table {
                color: #E2E8F0 !important;
            }

            [data-theme="dark"] table th {
                color: #94A3B8 !important;
            }

            [data-theme="dark"] table td {
                color: #CBD5E1 !important;
                border-color: #334155 !important;
            }

            [data-theme="dark"] table td span[style*="font-weight"] {
                color: #F1F5F9 !important;
            }

            [data-theme="dark"] tr {
                border-color: #334155 !important;
            }

            /* Card premium glass in dark mode */
            [data-theme="dark"] .card-premium-glass {
                background: #1E293B !important;
                border-color: #334155 !important;
            }

            /* Stat cards & values */
            [data-theme="dark"] .stat-value {
                color: #F1F5F9 !important;
            }

            /* Chat container */
            [data-theme="dark"] #chatContainer {
                background: #0F172A !important;
            }

            [data-theme="dark"] .chat-message.assistant .bubble {
                background: #334155 !important;
                border-color: #475569 !important;
                color: #E2E8F0 !important;
            }

            /* Analysis sections */
            [data-theme="dark"] .analysis-section {
                background: #0F172A !important;
                color: #E2E8F0 !important;
            }

            /* Results container */
            [data-theme="dark"] #resultsContainer {
                background: #1E293B !important;
            }

            /* Alerts */
            [data-theme="dark"] .alert {
                background: #1E293B !important;
                color: #E2E8F0 !important;
            }

            /* Inline color overrides for hardcoded styles */
            [data-theme="dark"] [style*="color: #1E293B"],
            [data-theme="dark"] [style*="color: #1e293b"],
            [data-theme="dark"] [style*="color:#1E293B"],
            [data-theme="dark"] [style*="color:#1e293b"] {
                color: #F1F5F9 !important;
            }

            [data-theme="dark"] [style*="color: #64748B"],
            [data-theme="dark"] [style*="color: #64748b"],
            [data-theme="dark"] [style*="color:#64748B"],
            [data-theme="dark"] [style*="color:#64748b"] {
                color: #94A3B8 !important;
            }

            /* Badge & status colors preservation */
            [data-theme="dark"] .badge.bg-success,
            [data-theme="dark"] .badge.bg-primary,
            [data-theme="dark"] .badge.bg-warning,
            [data-theme="dark"] .badge.bg-danger {
                color: white !important;
            }

            [data-theme="dark"] .badge.bg-success-soft {
                background: rgba(16, 185, 129, 0.15) !important;
            }

            [data-theme="dark"] .badge.bg-warning-soft {
                background: rgba(245, 158, 11, 0.15) !important;
            }

            /* Status badge (Actif, etc.) */
            [data-theme="dark"] span[style*="background: #D1FAE5"] {
                background: rgba(16, 185, 129, 0.2) !important;
                color: #34D399 !important;
            }

            /* API Docs table in dark mode */
            [data-theme="dark"] .table {
                color: #E2E8F0 !important;
            }

            [data-theme="dark"] .font-monospace {
                color: #CBD5E1 !important;
            }

            /* Form text & links */
            [data-theme="dark"] .form-text {
                color: #94A3B8 !important;
            }

            [data-theme="dark"] a.nav-item {
                color: rgba(255,255,255,0.7);
            }

            /* Collapse sections (Documentation API) */
            [data-theme="dark"] .collapse .card-body {
                color: #CBD5E1 !important;
            }

            /* Date premium class */
            [data-theme="dark"] .date-premium {
                color: #F1F5F9 !important;
            }

            /* Header text */
            [data-theme="dark"] .header .page-title {
                color: #CBD5E1 !important;
            }

            /* Button outlines */
            [data-theme="dark"] .btn-outline-secondary {
                border-color: #475569 !important;
                color: #94A3B8 !important;
            }

            [data-theme="dark"] .btn-outline-secondary:hover {
                background: #334155 !important;
                color: #F1F5F9 !important;
            }

            /* Initials avatar in dark mode */
            [data-theme="dark"] div[style*="background: #DBEAFE"] {
                background: rgba(99, 102, 241, 0.2) !important;
                color: #818CF8 !important;
            }

            /* Certification & bulletin specific */
            [data-theme="dark"] .badge-status-active {
                background: rgba(16, 185, 129, 0.15) !important;
                color: #34D399 !important;
            }

            [data-theme="dark"] code {
                color: #F472B6 !important;
                background: #1E293B !important;
            }

            /* Admin card from _edusmart_styles */
            [data-theme="dark"] .admin-card {
                background: #1E293B !important;
                box-shadow: 0 18px 45px rgba(0, 0, 0, 0.3) !important;
            }

            [data-theme="dark"] .admin-card-title,
            [data-theme="dark"] .admin-card-subtitle {
                color: #E2E8F0 !important;
            }

            /* bg-light badges in dark mode */
            [data-theme="dark"] .bg-light {
                background-color: #334155 !important;
                color: #E2E8F0 !important;
            }

            [data-theme="dark"] .bg-light.text-dark {
                color: #F1F5F9 !important;
            }

            /* Generic input, select, textarea */
            [data-theme="dark"] input, [data-theme="dark"] select, [data-theme="dark"] textarea {
                background-color: #334155 !important;
                color: #F1F5F9 !important;
                border-color: #475569 !important;
            }

            /* Table row borders */
            [data-theme="dark"] tbody tr {
                border-bottom-color: #334155 !important;
            }

            /* Modal dark mode */
            [data-theme="dark"] .modal-content {
                background-color: #1E293B !important;
                color: #E2E8F0 !important;
                border-color: #334155 !important;
            }

            [data-theme="dark"] .modal-header {
                border-bottom-color: #334155 !important;
            }

            [data-theme="dark"] .modal-footer {
                border-top-color: #334155 !important;
            }

            [data-theme="dark"] .btn-close {
                filter: invert(1) !important;
            }

            /* Info value text in show pages */
            [data-theme="dark"] .info-value {
                color: #F1F5F9 !important;
            }

            /* Dropdown menus */
            [data-theme="dark"] .dropdown-menu {
                background-color: #1E293B !important;
                border-color: #334155 !important;
            }

            [data-theme="dark"] .dropdown-item {
                color: #E2E8F0 !important;
            }

            [data-theme="dark"] .dropdown-item:hover {
                background-color: #334155 !important;
            }
        </style>
        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        <div class="app-container">
            <aside class="sidebar">
                <div class="sidebar-header">
                    <div class="logo-icon" style="background: #6366F1; color: white;">E</div>
                    <h2 style="font-size: 1.3rem; font-weight: 800; color: white;">EduSmart</h2>
                </div>
                <nav style="margin-top: 30px;">
    <ul style="list-style: none;">
        <li>
            <a href="{{ path('admin_dashboard') }}"
               class="nav-item {{ app.request.get('_route') == 'admin_dashboard' ? 'active' : '' }}">
                <i class="fas fa-chart-pie"></i>
                <span>Dashboard</span>
            </a>
        </li>

        <li>
            <a href="{{ path('admin_courses_manage') }}"
               class="nav-item {{ app.request.get('_route') == 'admin_courses_manage' ? 'active' : '' }}">
                <i class="fas fa-edit"></i>
                <span>Gérer les Cours</span>
            </a>
        </li>

        <li>
            <a href="{{ path('admin_modules_manage') }}"
               class="nav-item {{ app.request.get('_route') == 'admin_modules_manage' ? 'active' : '' }}">
                <i class="fas fa-cubes"></i>
                <span>Gérer les Modules</span>
            </a>
        </li>

        <li>
            <a href="{{ path('admin_exams_manage') }}
               "class="nav-item {{ app.request.get('_route') == 'admin_exams_manage' ? 'active' : '' }}">
                <i class="fas fa-tasks"></i>
                <span>Gérer Examens</span>
            </a>
        </li>

        <li>
            <a href="{{ path('admin_shop_index') }}"
               class="nav-item {{ app.request.get('_route') starts with 'admin_shop' ? 'active' : '' }}">
                <i class="fas fa-shopping-cart"></i>
                <span>Boutique</span>
            </a>
        </li>

        {# --- NOUVEAU : BULLETINS --- #}
        <li>
            <a href="{{ path('admin_bulletin_index') }}"
               class="nav-item {{ app.request.get('_route') starts with 'admin_bulletin_' ? 'active' : '' }}">
                <i class="fas fa-clipboard-list"></i>
                <span>Bulletins</span>
            </a>
        </li>

        {# --- EXISTANT : CERTIFICATIONS --- #}
        <li>
            <a href="{{ path('admin_certification_index') }}"
               class="nav-item {{ app.request.get('_route') starts with 'admin_certification_' ? 'active' : '' }}">
                <i class="fas fa-certificate"></i>
                <span>Certifications</span>
            </a>
        </li>

        {# --- NOUVEAU : ANALYSE AI --- #}
        <li>
            <a href="{{ path('admin_ai_index') }}"
               class="nav-item {{ app.request.get('_route') starts with 'admin_ai_' ? 'active' : '' }}">
                <i class="fas fa-brain"></i>
                <span>Analyse AI</span>
            </a>
        </li>

    </ul>
    </nav>
                <div style="margin-top: auto; padding: 20px;">
                    <a href="{{ path('app_logout') }}" class="btn btn-primary" style="width: 100%; font-size: 0.8rem; background: #6366F1;">Mode Étudiant</a>
                    <a href="{{ path('app_logout') }}" class="nav-item" style="margin-top: 10px;"><i class="fas fa-sign-out-alt"></i> <span>Déconnexion</span></a>
                </div>
            </aside>

            <main class="main-content">
                <div class="header">
                    <div class="page-title">Dashboard Professeur</div>
                    <div style="display: flex; align-items: center; gap: 15px;">
                        <button id="theme-toggle" class="theme-toggle" title="Changer de thème">
                            <i class="fas fa-moon" id="theme-icon"></i>
                        </button>
                        <span style="font-size: 0.9rem; font-weight: 600; color: var(--text-secondary);">Admin Professeur</span>
                        <a href="{{ path('app_profile') }}" title="Gérer mon compte" style="width: 40px; height: 40px; border-radius: 12px; background: #6366F1; display: flex; align-items: center; justify-content: center; color: white; text-decoration: none; transition: 0.3s;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'">
                            <i class="fas fa-user-tie"></i>
                        </a>
                    </div>
                </div>
                <div style="padding: 30px;">{% block body %}{% endblock %}</div>
            </main>
        </div>
        <script>
            // Dark mode toggle
            const themeToggle = document.getElementById('theme-toggle');
            const themeIcon = document.getElementById('theme-icon');
            const html = document.documentElement;

            // Load saved theme
            const savedTheme = localStorage.getItem('admin-theme') || 'light';
            html.setAttribute('data-theme', savedTheme);
            updateIcon(savedTheme);

            themeToggle.addEventListener('click', () => {
                const currentTheme = html.getAttribute('data-theme');
                const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
                
                html.setAttribute('data-theme', newTheme);
                localStorage.setItem('admin-theme', newTheme);
                updateIcon(newTheme);
            });

            function updateIcon(theme) {
                if (theme === 'dark') {
                    themeIcon.className = 'fas fa-sun';
                } else {
                    themeIcon.className = 'fas fa-moon';
                }
            }
        </script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
        
        <!-- Flatpickr Calendar -->
        <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
        <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script>
        <script>
            // Initialisation globale de Flatpickr pour tous les champs date
            document.addEventListener('DOMContentLoaded', function() {
                // Sélectionner tous les inputs de type date ET les champs avec la classe flatpickr-date
                const dateInputs = document.querySelectorAll('input[type="date"], input.flatpickr-date');
                dateInputs.forEach(function(input) {
                    // Changer le type en text pour éviter le date picker natif du navigateur
                    if (input.type === 'date') {
                        input.type = 'text';
                    }
                    flatpickr(input, {
                        locale: 'fr',
                        dateFormat: 'Y-m-d',
                        altInput: true,
                        altFormat: 'd/m/Y',
                        allowInput: true,
                        disableMobile: true,
                        animate: true,
                        monthSelectorType: 'dropdown'
                    });
                });
            });
        </script>
        {% block javascripts %}{% endblock %}
    </body>
</html>
