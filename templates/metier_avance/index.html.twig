{% extends 'admin_layout.html.twig' %}

{% block title %}Specialisations Avancees - EduSmart{% endblock %}

{% block body %}
<div class="admin-page animate-fade-in py-4">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>

    <div class="container-fluid position-relative z-index-2">
        <header class="mb-5 d-flex justify-content-between align-items-center flex-wrap gap-4">
            <div>
                <h1 class="h2 fw-900 text-dark mb-1">
                    <i class="fas fa-rocket text-primary me-2"></i>
                    Specialisations Avancees
                </h1>
                <p class="text-muted small mb-0">Expertises techniques et specialisations professionnelles avancees.</p>
            </div>
            <div class="d-flex flex-wrap gap-3">
                <a href="{{ path('app_metier_avance_new') }}" class="btn-premium-launch shadow">
                    <i class="fas fa-plus-circle me-2"></i>
                    Nouvelle Specialisation
                </a>
                <a href="{{ path('app_metier_index') }}" class="btn-premium-action shadow-sm">
                    <i class="fas fa-briefcase text-primary"></i> <span>Metiers</span>
                </a>
            </div>
        </header>

        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="stat-card-spec shadow-sm">
                    <div class="stat-icon bg-primary-soft"><i class="fas fa-layer-group text-primary"></i></div>
                    <div class="stat-content">
                        <div class="stat-value">{{ metier_avances|length }}</div>
                        <div class="stat-label">Specialisations</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card-spec shadow-sm">
                    <div class="stat-icon bg-success-soft"><i class="fas fa-check-circle text-success"></i></div>
                    <div class="stat-content">
                        <div class="stat-value">{{ metier_avances|length > 0 ? 'Actif' : '-' }}</div>
                        <div class="stat-label">Statut</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card-spec shadow-sm">
                    <div class="stat-icon bg-info-soft"><i class="fas fa-star text-info"></i></div>
                    <div class="stat-content">
                        <div class="stat-value">Expert</div>
                        <div class="stat-label">Niveau</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card card-premium-glass shadow-lg border-0 overflow-hidden">
            <div class="card-header bg-transparent py-4 px-4 border-bottom border-light d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <div class="icon-pulse-blue me-3">
                        <i class="fas fa-project-diagram text-primary"></i>
                    </div>
                    <h5 class="m-0 fw-800 text-dark">Liste des Specialisations</h5>
                </div>
                <div class="badge-premium-logic">
                    <i class="fas fa-database me-2"></i> {{ metier_avances|length }} entrees
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover-premium align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Filiere</th>
                                <th>Nom de la Specialite</th>
                                <th>Description</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for metier_avance in metier_avances %}
                            <tr class="animate-row-in">
                                <td class="ps-4">
                                    <span class="parent-badge">
                                        <i class="fas fa-tag me-1"></i>{{ metier_avance.metier.nom|default('N/A') }}
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-800 text-dark">{{ metier_avance.nom }}</div>
                                </td>
                                <td>
                                    <p class="text-muted small mb-0" style="max-width: 400px;">
                                        {{ metier_avance.description|length > 100 ? metier_avance.description|slice(0, 100) ~ '...' : metier_avance.description }}
                                    </p>
                                </td>
                                <td class="pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a href="{{ path('app_metier_avance_show', {id: metier_avance.id}) }}" class="btn-action-view" title="Voir">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="{{ path('app_metier_avance_edit', {id: metier_avance.id}) }}" class="btn-action-edit" title="Modifier">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <div class="d-inline-block">
                                            {{ include('metier_avance/_delete_form.html.twig', {metier_avance: metier_avance}) }}
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="4" class="text-center py-5">
                                    <div class="empty-state">
                                        <div class="empty-icon mb-3">
                                            <i class="fas fa-microchip fa-3x text-muted opacity-50"></i>
                                        </div>
                                        <h5 class="fw-800 text-dark">Aucune specialisation</h5>
                                        <p class="text-muted small mb-3">Ajoutez des specialisations pour enrichir vos filieres.</p>
                                        <a href="{{ path('app_metier_avance_new') }}" class="btn-premium-launch">
                                            <i class="fas fa-plus-circle me-2"></i>Ajouter une specialite
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .fw-900 { font-weight: 900; }
    .fw-800 { font-weight: 800; }
    .z-index-2 { z-index: 2; }
    .orb { position: fixed; width: 600px; height: 600px; border-radius: 50%; filter: blur(130px); opacity: 0.08; z-index: 0; pointer-events: none; }
    .orb-1 { top: -100px; left: -100px; background: #6366f1; }
    .orb-2 { bottom: -100px; right: -100px; background: #8b5cf6; }
    .card-premium-glass { background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(25px); border: 1px solid rgba(226, 232, 240, 0.5) !important; border-radius: 30px; }
    .stat-card-spec { background: white; border-radius: 20px; padding: 25px; display: flex; align-items: center; gap: 20px; transition: all 0.3s ease; }
    .stat-card-spec:hover { transform: translateY(-5px); box-shadow: 0 15px 35px rgba(0,0,0,0.1) !important; }
    .stat-icon { width: 60px; height: 60px; border-radius: 18px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; }
    .stat-value { font-size: 2rem; font-weight: 900; color: #1E293B; }
    .stat-label { font-size: 0.8rem; font-weight: 700; color: #64748B; text-transform: uppercase; letter-spacing: 0.05em; }
    .bg-primary-soft { background: rgba(99, 102, 241, 0.1); }
    .bg-success-soft { background: rgba(16, 185, 129, 0.1); }
    .bg-info-soft { background: rgba(59, 130, 246, 0.1); }
    .table-hover-premium thead th { font-size: 0.72rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: #94a3b8; padding: 22px 18px; border-bottom: 2px solid #f1f5f9; background: rgba(248, 250, 252, 0.4); }
    .table-hover-premium tbody td { padding: 20px 18px; border-bottom: 1px solid #f1f5f9; transition: all 0.3s ease; }
    .table-hover-premium tbody tr:hover { background: rgba(99, 102, 241, 0.03); }
    .parent-badge { background: #EEF2FF; color: #4F46E5; padding: 6px 12px; border-radius: 8px; font-size: 0.8rem; font-weight: 700; }
    .btn-action-view, .btn-action-edit { width: 36px; height: 36px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.85rem; border: none; transition: all 0.2s ease; text-decoration: none; }
    .btn-action-view { background: #EEF2FF; color: #4F46E5; }
    .btn-action-view:hover { background: #4F46E5; color: white; }
    .btn-action-edit { background: #FEF3C7; color: #D97706; }
    .btn-action-edit:hover { background: #D97706; color: white; }
    .btn-premium-launch { background: linear-gradient(135deg, #4f46e5, #6366f1); color: white; border: none; padding: 14px 32px; border-radius: 50px; font-weight: 700; transition: all 0.3s ease; text-decoration: none; display: inline-flex; align-items: center; }
    .btn-premium-launch:hover { transform: translateY(-3px); box-shadow: 0 15px 30px rgba(79, 70, 229, 0.35); color: white; }
    .btn-premium-action { background: white; color: #1E293B; border: 1px solid #E2E8F0; padding: 12px 20px; border-radius: 14px; font-weight: 700; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 10px; text-decoration: none; transition: all 0.3s ease; }
    .btn-premium-action:hover { background: #F8FAFC; border-color: #6366F1; color: #4F46E5; transform: translateY(-2px); }
    .badge-premium-logic { background: rgba(16, 185, 129, 0.1); color: #10b981; padding: 8px 16px; border-radius: 50px; font-weight: 700; font-size: 0.8rem; }
    .icon-pulse-blue { width: 48px; height: 48px; background: rgba(99, 102, 241, 0.1); border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; }
    .animate-fade-in { animation: fadeIn 0.6s ease-out; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    .animate-row-in { animation: rowIn 0.4s ease-out; }
    @keyframes rowIn { from { opacity: 0; transform: translateX(-10px); } to { opacity: 1; transform: translateX(0); } }
</style>
{% endblock %}
