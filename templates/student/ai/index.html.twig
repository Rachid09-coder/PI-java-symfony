{% extends 'student_layout.html.twig' %}

{% block title %}Mon Analyse AI - EduSmart{% endblock %}

{% block body %}
<div class="student-ai-page animate-fade-in py-4">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>

    <div class="container-fluid position-relative z-index-2">
        <header class="mb-5">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div>
                    <h1 class="h2 fw-900 text-dark mb-1">
                        <i class="fas fa-brain text-primary me-2"></i>
                        Mon Analyse AI
                    </h1>
                    <p class="text-muted small mb-0">Intelligence artificielle personnalisée pour votre réussite</p>
                </div>
                <div class="d-flex gap-2">
                    {% if isConfigured %}
                    <span class="badge bg-success-soft text-success px-3 py-2 rounded-pill">
                        <i class="fas fa-check-circle me-1"></i> Groq AI Connecté
                    </span>
                    {% else %}
                    <span class="badge bg-warning-soft text-warning px-3 py-2 rounded-pill">
                        <i class="fas fa-exclamation-triangle me-1"></i> AI Non Disponible
                    </span>
                    {% endif %}
                </div>
            </div>
        </header>

        {% if not isConfigured %}
        <div class="alert alert-warning border-0 shadow-sm mb-4" style="border-radius: 16px;">
            <div class="d-flex align-items-center">
                <i class="fas fa-info-circle fa-2x text-warning me-3"></i>
                <div>
                    <h6 class="fw-bold mb-1">Fonctionnalité temporairement indisponible</h6>
                    <p class="mb-0 small">
                        L'analyse AI n'est pas disponible pour le moment. Veuillez réessayer plus tard.
                    </p>
                </div>
            </div>
        </div>
        {% endif %}

        <div class="row g-4">
            {# Carte Analyse de Performance #}
            <div class="col-lg-6">
                <div class="card card-premium-glass shadow-lg border-0 h-100" style="border-radius: 20px;">
                    <div class="card-header bg-transparent border-0 py-4 px-4">
                        <div class="d-flex align-items-center">
                            <div class="icon-pulse me-3" style="background: linear-gradient(135deg, #6366F1, #8B5CF6); width: 60px; height: 60px; border-radius: 16px; display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-chart-line text-white fa-lg"></i>
                            </div>
                            <div>
                                <h5 class="fw-800 text-dark mb-1">Analyse Complète</h5>
                                <p class="text-muted small mb-0">Évaluation détaillée de vos performances</p>
                            </div>
                        </div>
                    </div>
                    <div class="card-body px-4 pb-4">
                        <p class="text-muted mb-4">
                            Obtenez une analyse approfondie de vos résultats académiques, incluant :
                        </p>
                        <ul class="feature-list mb-4">
                            <li><i class="fas fa-check-circle text-success"></i> Évaluation de vos points forts</li>
                            <li><i class="fas fa-check-circle text-success"></i> Identification des axes d'amélioration</li>
                            <li><i class="fas fa-check-circle text-success"></i> Analyse de votre progression</li>
                            <li><i class="fas fa-check-circle text-success"></i> Score de performance global</li>
                        </ul>
                        <button type="button" id="btnAnalyze" class="btn-premium-action w-100" onclick="getMyAnalysis()" {{ not isConfigured ? 'disabled' : '' }}>
                            <i class="fas fa-magic me-2"></i> Générer Mon Analyse
                        </button>
                    </div>
                </div>
            </div>

            {# Carte Recommandations #}
            <div class="col-lg-6">
                <div class="card card-premium-glass shadow-lg border-0 h-100" style="border-radius: 20px;">
                    <div class="card-header bg-transparent border-0 py-4 px-4">
                        <div class="d-flex align-items-center">
                            <div class="icon-pulse me-3" style="background: linear-gradient(135deg, #10B981, #059669); width: 60px; height: 60px; border-radius: 16px; display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-lightbulb text-white fa-lg"></i>
                            </div>
                            <div>
                                <h5 class="fw-800 text-dark mb-1">Recommandations</h5>
                                <p class="text-muted small mb-0">Conseils personnalisés pour progresser</p>
                            </div>
                        </div>
                    </div>
                    <div class="card-body px-4 pb-4">
                        <p class="text-muted mb-4">
                            Recevez des conseils adaptés à votre profil :
                        </p>
                        <ul class="feature-list mb-4">
                            <li><i class="fas fa-star text-warning"></i> Stratégies d'étude personnalisées</li>
                            <li><i class="fas fa-star text-warning"></i> Matières à prioriser</li>
                            <li><i class="fas fa-star text-warning"></i> Objectifs réalistes à atteindre</li>
                            <li><i class="fas fa-star text-warning"></i> Ressources recommandées</li>
                        </ul>
                        <button type="button" id="btnRecommend" class="btn-premium-submit w-100" onclick="getMyRecommendations()" {{ not isConfigured ? 'disabled' : '' }}>
                            <i class="fas fa-compass me-2"></i> Obtenir Mes Conseils
                        </button>
                    </div>
                </div>
            </div>

            {# Zone de résultats #}
            <div class="col-12">
                <div id="resultsContainer" class="card card-premium-glass shadow-lg border-0" style="border-radius: 20px; display: none;">
                    <div class="card-header bg-transparent border-0 py-4 px-4 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <div id="resultsIcon" class="icon-pulse me-3" style="background: linear-gradient(135deg, #3B82F6, #1D4ED8); width: 50px; height: 50px; border-radius: 14px; display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-file-alt text-white"></i>
                            </div>
                            <div>
                                <h5 class="fw-800 text-dark mb-0" id="resultsTitle">Résultats</h5>
                                <p class="text-muted small mb-0" id="resultsSubtitle">Généré par Groq AI (Llama 3.3)</p>
                            </div>
                        </div>
                        <button type="button" class="btn-close-custom" onclick="closeResults()">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    <div class="card-body px-4 pb-4">
                        <div id="resultsContent">
                            {# Contenu dynamique #}
                        </div>
                    </div>
                </div>
            </div>

            {# Section Chat AI #}
            <div class="col-12">
                <div class="card card-premium-glass shadow-lg border-0" style="border-radius: 20px;">
                    <div class="card-header bg-transparent border-0 py-4 px-4">
                        <div class="d-flex align-items-center">
                            <div class="icon-pulse me-3" style="background: linear-gradient(135deg, #F59E0B, #D97706); width: 50px; height: 50px; border-radius: 14px; display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-robot text-white"></i>
                            </div>
                            <div>
                                <h5 class="fw-800 text-dark mb-0">Assistant AI Personnel</h5>
                                <p class="text-muted small mb-0">Posez vos questions sur vos performances académiques</p>
                            </div>
                        </div>
                    </div>
                    <div class="card-body px-4 pb-4">
                        <div id="chatContainer" class="chat-container mb-3">
                            <div class="chat-welcome text-center py-5">
                                <div class="chat-welcome-icon mb-3">
                                    <i class="fas fa-comments"></i>
                                </div>
                                <h6 class="fw-bold text-dark mb-2">Bienvenue dans votre Assistant AI</h6>
                                <p class="text-muted small mb-0">Posez vos questions sur vos résultats, demandez des conseils d'étude, ou des explications sur vos performances.</p>
                            </div>
                        </div>
                        <div class="chat-input-wrapper">
                            <input type="text" id="chatInput" class="form-control form-control-chat" placeholder="Posez une question sur vos résultats académiques..." {{ not isConfigured ? 'disabled' : '' }}>
                            <button type="button" class="btn-chat-send" onclick="sendChat()" {{ not isConfigured ? 'disabled' : '' }}>
                                <i class="fas fa-paper-plane"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Info Card #}
        <div class="card card-premium-glass border-0 shadow-lg mt-4" style="border-radius: 20px; background: linear-gradient(135deg, rgba(99, 102, 241, 0.05) 0%, rgba(139, 92, 246, 0.1) 100%);">
            <div class="card-body p-4">
                <div class="d-flex align-items-start">
                    <div class="icon-pulse me-3" style="background: linear-gradient(135deg, #3B82F6, #1D4ED8); width: 50px; height: 50px; border-radius: 14px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <i class="fas fa-robot text-white"></i>
                    </div>
                    <div>
                        <h6 class="fw-800 text-dark mb-2">Comment ça marche ?</h6>
                        <p class="text-muted small mb-0">
                            Notre système d'intelligence artificielle Groq (Llama 3.3) analyse vos bulletins, notes et certifications pour vous fournir 
                            une évaluation personnalisée de vos performances. Les analyses sont générées en temps réel et prennent 
                            en compte l'ensemble de votre parcours académique. Plus vous avez de données (bulletins, examens), 
                            plus l'analyse sera précise et pertinente.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .student-ai-page {
        position: relative;
        min-height: 100vh;
        overflow: hidden;
    }
    
    /* EduSmart Logo */
    .edusmart-logo {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    
    .logo-icon {
        width: 48px;
        height: 48px;
        background: linear-gradient(135deg, #6366F1, #8B5CF6);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 20px rgba(99, 102, 241, 0.3);
    }
    
    .logo-letter {
        color: white;
        font-size: 1.5rem;
        font-weight: 900;
    }
    
    .logo-text {
        font-size: 1.5rem;
        font-weight: 800;
        background: linear-gradient(135deg, #6366F1, #8B5CF6);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    
    .header-divider {
        width: 2px;
        height: 40px;
        background: linear-gradient(180deg, transparent, #e2e8f0, transparent);
    }
    
    .orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        opacity: 0.5;
        z-index: 0;
    }
    
    .orb-1 {
        width: 400px;
        height: 400px;
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.3), rgba(139, 92, 246, 0.2));
        top: -100px;
        right: -100px;
        animation: float 8s ease-in-out infinite;
    }
    
    .orb-2 {
        width: 300px;
        height: 300px;
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.3), rgba(5, 150, 105, 0.2));
        bottom: 100px;
        left: -100px;
        animation: float 10s ease-in-out infinite reverse;
    }
    
    .orb-3 {
        width: 200px;
        height: 200px;
        background: linear-gradient(135deg, rgba(245, 158, 11, 0.2), rgba(217, 119, 6, 0.15));
        top: 50%;
        right: 20%;
        animation: float 6s ease-in-out infinite;
    }
    
    @keyframes float {
        0%, 100% { transform: translate(0, 0); }
        50% { transform: translate(20px, -20px); }
    }
    
    .z-index-2 {
        z-index: 2;
    }
    
    .fw-900 { font-weight: 900; }
    .fw-800 { font-weight: 800; }
    
    .card-premium-glass {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        transition: all 0.3s ease;
    }
    
    .card-premium-glass:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1) !important;
    }
    
    .icon-pulse {
        position: relative;
        animation: pulse-ring 2s ease infinite;
    }
    
    .icon-pulse::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        animation: pulse-effect 2s ease infinite;
    }
    
    @keyframes pulse-effect {
        0%, 100% { box-shadow: 0 0 0 0 rgba(99, 102, 241, 0.3); }
        50% { box-shadow: 0 0 0 8px rgba(99, 102, 241, 0); }
    }
    
    .feature-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    
    .feature-list li {
        padding: 10px 0;
        display: flex;
        align-items: center;
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    }
    
    .feature-list li:last-child {
        border-bottom: none;
    }
    
    .feature-list li i {
        margin-right: 12px;
        font-size: 1rem;
    }
    
    .btn-premium-action {
        background: linear-gradient(135deg, #6366F1, #8B5CF6);
        color: white;
        border: none;
        padding: 14px 28px;
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }
    
    .btn-premium-action::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(255,255,255,0.2), transparent);
        transform: translateX(-100%);
        transition: transform 0.5s ease;
    }
    
    .btn-premium-action:hover:not(:disabled)::before {
        transform: translateX(100%);
    }
    
    .btn-premium-action:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(99, 102, 241, 0.4);
        color: white;
    }
    
    .btn-premium-action:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
    
    .btn-premium-submit {
        background: linear-gradient(135deg, #10B981, #059669);
        color: white;
        border: none;
        padding: 14px 28px;
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }
    
    .btn-premium-submit::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(255,255,255,0.2), transparent);
        transform: translateX(-100%);
        transition: transform 0.5s ease;
    }
    
    .btn-premium-submit:hover:not(:disabled)::before {
        transform: translateX(100%);
    }
    
    .btn-premium-submit:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(16, 185, 129, 0.4);
        color: white;
    }
    
    .btn-premium-submit:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
    
    .btn-close-custom {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: none;
        background: #f1f5f9;
        color: #64748b;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
    }
    
    .btn-close-custom:hover {
        background: #e2e8f0;
        color: #334155;
    }
    
    .bg-success-soft { background-color: rgba(16, 185, 129, 0.1); }
    .bg-warning-soft { background-color: rgba(245, 158, 11, 0.1); }
    
    .loading-spinner {
        display: inline-block;
        width: 24px;
        height: 24px;
        border: 3px solid rgba(255, 255, 255, 0.3);
        border-top: 3px solid white;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }
    
    @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
    
    .analysis-section {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 16px;
        border: 1px solid rgba(0, 0, 0, 0.05);
    }
    
    .analysis-section h6 {
        color: #6366F1;
        font-weight: 700;
        margin-bottom: 16px;
        font-size: 1rem;
    }
    
    .score-circle {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        background: linear-gradient(135deg, #6366F1, #8B5CF6);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: white;
        margin: 0 auto 24px;
        box-shadow: 0 20px 40px rgba(99, 102, 241, 0.3);
        position: relative;
    }
    
    .score-circle::before {
        content: '';
        position: absolute;
        inset: -4px;
        border-radius: 50%;
        background: linear-gradient(135deg, #6366F1, #8B5CF6);
        opacity: 0.3;
        animation: pulse-effect 2s ease infinite;
    }
    
    .score-value {
        font-size: 3rem;
        font-weight: 900;
        line-height: 1;
        position: relative;
        z-index: 1;
    }
    
    .score-label {
        font-size: 0.9rem;
        opacity: 0.9;
        position: relative;
        z-index: 1;
    }
    
    .animate-fade-in {
        animation: fadeIn 0.6s ease-out;
    }
    
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    .ai-loading-animation {
        display: flex;
        justify-content: center;
        align-items: center;
    }
    
    .ai-brain {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #6366F1, #8B5CF6);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        animation: brainPulse 2s ease-in-out infinite;
    }
    
    .ai-brain i {
        font-size: 2rem;
        color: white;
    }
    
    .ai-brain::before, .ai-brain::after {
        content: '';
        position: absolute;
        border-radius: 50%;
        border: 2px solid rgba(99, 102, 241, 0.3);
        animation: ripple 2s ease-out infinite;
    }
    
    .ai-brain::before {
        inset: -15px;
    }
    
    .ai-brain::after {
        inset: -30px;
        animation-delay: 0.5s;
    }
    
    @keyframes brainPulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.05); }
    }
    
    @keyframes ripple {
        0% { opacity: 1; transform: scale(1); }
        100% { opacity: 0; transform: scale(1.3); }
    }
    
    @keyframes progressIndeterminate {
        0% { width: 0%; margin-left: 0%; }
        50% { width: 40%; margin-left: 30%; }
        100% { width: 0%; margin-left: 100%; }
    }
    
    .analysis-content {
        white-space: pre-wrap;
        line-height: 1.8;
        color: #374151;
    }
    
    .styled-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    
    .styled-list li {
        padding: 10px 0;
        display: flex;
        align-items: flex-start;
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    }
    
    .styled-list li:last-child {
        border-bottom: none;
    }
    
    .styled-list li i {
        flex-shrink: 0;
        margin-top: 4px;
    }
    
    /* Chat Styles */
    .chat-container {
        height: 350px;
        overflow-y: auto;
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-radius: 16px;
        padding: 20px;
    }
    
    .chat-welcome {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
    }
    
    .chat-welcome-icon {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, rgba(245, 158, 11, 0.1), rgba(217, 119, 6, 0.1));
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .chat-welcome-icon i {
        font-size: 2rem;
        color: #F59E0B;
    }
    
    .chat-input-wrapper {
        display: flex;
        gap: 12px;
        align-items: center;
    }
    
    .form-control-chat {
        flex: 1;
        border: 2px solid #E2E8F0;
        border-radius: 16px;
        padding: 14px 20px;
        font-size: 0.95rem;
        transition: all 0.3s ease;
    }
    
    .form-control-chat:focus {
        border-color: #F59E0B;
        box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.1);
    }
    
    .btn-chat-send {
        width: 50px;
        height: 50px;
        border-radius: 16px;
        border: none;
        background: linear-gradient(135deg, #F59E0B, #D97706);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        cursor: pointer;
    }
    
    .btn-chat-send:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(245, 158, 11, 0.4);
    }
    
    .btn-chat-send:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
    
    .chat-message {
        margin-bottom: 16px;
        animation: slideIn 0.3s ease;
    }
    
    .chat-message.user {
        display: flex;
        justify-content: flex-end;
    }
    
    .chat-message.assistant {
        display: flex;
        justify-content: flex-start;
    }
    
    .chat-message .bubble {
        display: inline-block;
        padding: 14px 20px;
        border-radius: 20px;
        max-width: 80%;
        line-height: 1.6;
    }
    
    .chat-message.user .bubble {
        background: linear-gradient(135deg, #6366F1, #8B5CF6);
        color: white;
        border-bottom-right-radius: 6px;
    }
    
    .chat-message.assistant .bubble {
        background: white;
        border: 1px solid #E2E8F0;
        color: #374151;
        border-bottom-left-radius: 6px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }
    
    @keyframes slideIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<script>
async function getMyAnalysis() {
    const btn = document.getElementById('btnAnalyze');
    btn.disabled = true;
    btn.innerHTML = '<div class="loading-spinner"></div> Analyse en cours...';
    
    showLoading('Génération de votre analyse personnalisée...');

    try {
        const response = await fetch('/student/ai/my-analysis');
        const data = await response.json();

        if (data.success) {
            displayAnalysis(data);
        } else {
            displayError(data.error || 'Erreur lors de l\'analyse');
        }
    } catch (error) {
        displayError('Erreur de connexion: ' + error.message);
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-magic me-2"></i> Générer Mon Analyse';
    }
}

async function getMyRecommendations() {
    const btn = document.getElementById('btnRecommend');
    btn.disabled = true;
    btn.innerHTML = '<div class="loading-spinner"></div> Génération...';
    
    showLoading('Préparation de vos recommandations personnalisées...');

    try {
        const response = await fetch('/student/ai/my-recommendations');
        const data = await response.json();

        if (data.success) {
            displayRecommendations(data);
        } else {
            displayError(data.error || 'Erreur');
        }
    } catch (error) {
        displayError('Erreur: ' + error.message);
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-compass me-2"></i> Obtenir Mes Conseils';
    }
}

function showLoading(message) {
    const container = document.getElementById('resultsContainer');
    const content = document.getElementById('resultsContent');
    
    document.getElementById('resultsTitle').textContent = 'Traitement en cours';
    document.getElementById('resultsSubtitle').textContent = 'Groq AI (Llama 3.3) travaille...';
    
    content.innerHTML = `
        <div class="text-center py-5">
            <div class="ai-loading-animation">
                <div class="ai-brain">
                    <i class="fas fa-brain"></i>
                </div>
            </div>
            <h5 class="fw-bold text-dark mt-4 mb-2">${message}</h5>
            <p class="text-muted small">Notre IA analyse vos données académiques...</p>
            <div class="progress mt-3" style="height: 4px; max-width: 300px; margin: 0 auto; border-radius: 4px; overflow: hidden;">
                <div class="progress-bar" style="background: linear-gradient(135deg, #6366F1, #8B5CF6); animation: progressIndeterminate 1.5s infinite ease-in-out;"></div>
            </div>
        </div>
    `;
    container.style.display = 'block';
    container.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function displayAnalysis(data) {
    document.getElementById('resultsTitle').textContent = 'Mon Analyse de Performance';
    document.getElementById('resultsSubtitle').textContent = 'Généré le ' + new Date(data.generatedAt).toLocaleString('fr-FR') + ' par Groq AI';
    document.getElementById('resultsIcon').style.background = 'linear-gradient(135deg, #6366F1, #8B5CF6)';
    document.getElementById('resultsIcon').innerHTML = '<i class="fas fa-chart-line text-white"></i>';

    const analysis = data.analysis;
    let html = '';

    // Score circle if available
    if (analysis.score) {
        html += `
            <div class="text-center mb-4">
                <div class="score-circle">
                    <div class="score-value">${analysis.score}</div>
                    <div class="score-label">/ 100</div>
                </div>
                <p class="text-muted fw-semibold">Score de performance global</p>
            </div>
        `;
    }

    // Analysis content
    html += `
        <div class="analysis-section">
            <h6><i class="fas fa-chart-bar me-2"></i>Analyse Détaillée</h6>
            <div class="analysis-content">${escapeHtml(analysis.full || data.rawAnalysis || 'Aucune analyse disponible')}</div>
        </div>
    `;

    // Strengths if available
    if (analysis.strengths && analysis.strengths.length > 0) {
        html += `
            <div class="analysis-section" style="background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border-left: 4px solid #10B981;">
                <h6 style="color: #059669;"><i class="fas fa-trophy me-2"></i>Vos Points Forts</h6>
                <ul class="styled-list success">
                    ${analysis.strengths.map(s => `<li><i class="fas fa-check-circle text-success me-2"></i>${escapeHtml(s)}</li>`).join('')}
                </ul>
            </div>
        `;
    }

    // Weaknesses if available
    if (analysis.weaknesses && analysis.weaknesses.length > 0) {
        html += `
            <div class="analysis-section" style="background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%); border-left: 4px solid #EF4444;">
                <h6 style="color: #DC2626;"><i class="fas fa-exclamation-circle me-2"></i>Axes d'Amélioration</h6>
                <ul class="styled-list danger">
                    ${analysis.weaknesses.map(w => `<li><i class="fas fa-arrow-right text-danger me-2"></i>${escapeHtml(w)}</li>`).join('')}
                </ul>
            </div>
        `;
    }
    
    // Footer
    html += `
        <div class="d-flex align-items-center justify-content-center mt-4 pt-3 border-top">
            <i class="fas fa-robot text-primary me-2"></i>
            <span class="text-muted small">Analyse générée par Groq AI (Llama 3.3 70B)</span>
        </div>
    `;

    document.getElementById('resultsContent').innerHTML = html;
    document.getElementById('resultsContainer').style.display = 'block';
}

function displayRecommendations(data) {
    document.getElementById('resultsTitle').textContent = 'Mes Recommandations';
    document.getElementById('resultsSubtitle').textContent = 'Généré le ' + new Date(data.generatedAt).toLocaleString('fr-FR') + ' par Groq AI';
    document.getElementById('resultsIcon').style.background = 'linear-gradient(135deg, #10B981, #059669)';
    document.getElementById('resultsIcon').innerHTML = '<i class="fas fa-lightbulb text-white"></i>';

    const html = `
        <div class="analysis-section" style="background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border-left: 4px solid #10B981;">
            <h6 style="color: #059669;"><i class="fas fa-lightbulb me-2"></i>Conseils Personnalisés</h6>
            <div class="analysis-content">${escapeHtml(data.recommendations)}</div>
        </div>
        <div class="card border-0 mt-3" style="border-radius: 16px; background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);">
            <div class="card-body p-3">
                <div class="d-flex align-items-center">
                    <i class="fas fa-info-circle text-primary me-2"></i>
                    <p class="mb-0 small text-muted">
                        Ces recommandations sont générées automatiquement en fonction de vos résultats académiques. 
                        N'hésitez pas à consulter vos enseignants pour des conseils plus personnalisés.
                    </p>
                </div>
            </div>
        </div>
        <div class="d-flex align-items-center justify-content-center mt-4 pt-3 border-top">
            <i class="fas fa-robot text-success me-2"></i>
            <span class="text-muted small">Recommandations générées par Groq AI (Llama 3.3 70B)</span>
        </div>
    `;

    document.getElementById('resultsContent').innerHTML = html;
    document.getElementById('resultsContainer').style.display = 'block';
}

function displayError(message) {
    document.getElementById('resultsTitle').textContent = 'Erreur';
    document.getElementById('resultsSubtitle').textContent = 'Une erreur est survenue';
    document.getElementById('resultsIcon').style.background = 'linear-gradient(135deg, #EF4444, #DC2626)';
    document.getElementById('resultsIcon').innerHTML = '<i class="fas fa-exclamation-triangle text-white"></i>';
    
    document.getElementById('resultsContent').innerHTML = `
        <div class="analysis-section" style="background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%); border-left: 4px solid #EF4444;">
            <h6 style="color: #DC2626;"><i class="fas fa-exclamation-circle me-2"></i>Erreur de traitement</h6>
            <p class="mb-0">${escapeHtml(message)}</p>
        </div>
        <div class="card border-0 mt-3" style="border-radius: 16px; background: #f8fafc;">
            <div class="card-body p-3">
                <div class="d-flex align-items-center">
                    <i class="fas fa-life-ring text-muted me-2"></i>
                    <p class="mb-0 small text-muted">
                        Si le problème persiste, veuillez réessayer plus tard ou contacter l'administration.
                    </p>
                </div>
            </div>
        </div>
    `;
    document.getElementById('resultsContainer').style.display = 'block';
}

function closeResults() {
    document.getElementById('resultsContainer').style.display = 'none';
}

function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

// Chat functionality
let chatHistory = [];

async function sendChat() {
    const message = document.getElementById('chatInput').value.trim();
    if (!message) return;

    // Add user message to chat
    addChatMessage(message, 'user');
    document.getElementById('chatInput').value = '';

    // Add loading indicator
    const loadingId = 'loading-' + Date.now();
    const container = document.getElementById('chatContainer');
    container.innerHTML += `
        <div id="${loadingId}" class="chat-message assistant">
            <div class="bubble">
                <div class="d-flex align-items-center">
                    <div class="loading-spinner me-2" style="width: 18px; height: 18px; border-width: 2px;"></div>
                    <span>Réflexion en cours...</span>
                </div>
            </div>
        </div>
    `;
    scrollChat();

    try {
        const response = await fetch('/student/ai/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message, history: chatHistory })
        });
        const data = await response.json();

        // Remove loading
        document.getElementById(loadingId)?.remove();

        if (data.success) {
            chatHistory.push({ role: 'user', content: message });
            chatHistory.push({ role: 'assistant', content: data.response });
            addChatMessage(data.response, 'assistant');
        } else {
            addChatMessage('Erreur: ' + (data.error || 'Réponse invalide'), 'assistant');
        }
    } catch (error) {
        document.getElementById(loadingId)?.remove();
        addChatMessage('Erreur de connexion au serveur', 'assistant');
    }
}

function addChatMessage(content, type) {
    const container = document.getElementById('chatContainer');
    // Clear welcome message if first message
    const welcome = container.querySelector('.chat-welcome');
    if (welcome) {
        welcome.remove();
    }
    
    container.innerHTML += `
        <div class="chat-message ${type}">
            <div class="bubble">${escapeHtml(content)}</div>
        </div>
    `;
    scrollChat();
}

function scrollChat() {
    const container = document.getElementById('chatContainer');
    container.scrollTop = container.scrollHeight;
}

// Enter key to send message
document.getElementById('chatInput')?.addEventListener('keypress', function(e) {
    if (e.key === 'Enter') {
        sendChat();
    }
});
</script>
{% endblock %}
