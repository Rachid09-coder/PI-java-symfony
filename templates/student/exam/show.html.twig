{% extends 'student_layout.html.twig' %}

{% block title %}{{ exam.title }} - EduSmart{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
    .exam-show-page {
        font-family: 'Plus Jakarta Sans', var(--font-sans, sans-serif);
        max-width: 920px;
        margin: 0 auto;
        padding: 32px 24px 56px;
    }

    .exam-back {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: #64748b;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
        margin-bottom: 28px;
        padding: 10px 0;
        transition: color 0.25s ease, gap 0.3s ease;
        animation: examShowFadeIn 0.5s ease-out;
    }
    .exam-back:hover {
        color: #3b49a2;
        gap: 14px;
    }
    .exam-back i {
        transition: transform 0.3s ease;
    }
    .exam-back:hover i {
        transform: translateX(-4px);
    }
    @keyframes examShowFadeIn {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .exam-main-card {
        padding: 44px;
        border-radius: 24px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.06), 0 0 0 1px rgba(0, 0, 0, 0.04);
        background: #fff;
        animation: examShowCardIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }
    @keyframes examShowCardIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .exam-main-card .title-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 28px;
    }
    .exam-main-card h1 {
        font-size: clamp(1.5rem, 3vw, 2rem);
        font-weight: 800;
        color: #0f172a;
        margin: 0;
        letter-spacing: -0.02em;
        line-height: 1.25;
    }
    .exam-main-card .type-badge {
        background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%);
        color: #4f46e5;
        padding: 10px 18px;
        border-radius: 999px;
        font-weight: 700;
        font-size: 0.9rem;
        white-space: nowrap;
    }

    .exam-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 32px;
    }
    .exam-info-block {
        background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
        padding: 22px;
        border-radius: 18px;
        border: 1px solid rgba(0,0,0,0.04);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        animation: examInfoBlockIn 0.5s ease-out both;
    }
    .exam-info-block:nth-child(1) { animation-delay: 0.1s; }
    .exam-info-block:nth-child(2) { animation-delay: 0.18s; }
    .exam-info-block:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.06);
    }
    @keyframes examInfoBlockIn {
        from { opacity: 0; transform: scale(0.95); }
        to { opacity: 1; transform: scale(1); }
    }
    .exam-info-block .label {
        color: #64748b;
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 6px;
    }
    .exam-info-block .value {
        color: #0f172a;
        font-weight: 800;
        font-size: 1.15rem;
        margin: 0;
    }

    .exam-section-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 14px;
    }
    .exam-consignes {
        color: #475569;
        line-height: 1.7;
        background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
        padding: 24px;
        border-radius: 18px;
        border-left: 4px solid #3b49a2;
        margin-bottom: 28px;
    }

    .exam-download-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 14px 26px;
        border-radius: 14px;
        font-weight: 700;
        border: 2px solid #e2e8f0;
        color: #1e293b;
        text-decoration: none;
        transition: all 0.3s ease;
        margin-bottom: 28px;
    }
    .exam-download-btn:hover {
        border-color: #3b49a2;
        color: #3b49a2;
        background: rgba(59, 73, 162, 0.06);
        transform: translateY(-2px);
    }

    .exam-pdf-preview {
        margin-bottom: 28px;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        overflow: hidden;
        background: #f8fafc;
    }
    .exam-pdf-preview .preview-title {
        padding: 14px 22px;
        border-bottom: 1px solid #e2e8f0;
        font-weight: 700;
        color: #475569;
    }
    .exam-pdf-preview iframe {
        border: none;
        width: 100%;
        height: 800px;
    }

    .exam-btn-primary {
        width: 100%;
        padding: 18px 24px;
        border-radius: 14px;
        font-weight: 700;
        font-size: 1.1rem;
        background: linear-gradient(135deg, #3b49a2 0%, #4f46e5 100%);
        color: #fff;
        border: none;
        cursor: pointer;
        transition: transform 0.25s ease, box-shadow 0.3s ease;
        position: relative;
        overflow: hidden;
    }
    .exam-btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 14px 32px rgba(59, 73, 162, 0.35);
    }
    .exam-btn-primary::after {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
        transition: left 0.5s ease;
    }
    .exam-btn-primary:hover::after {
        left: 100%;
    }

    /* Bloc dépôt rendu */
    .exam-upload-block {
        background: #fff;
        border: 2px solid #e2e8f0;
        border-radius: 22px;
        padding: 32px;
        margin-top: 32px;
        animation: examShowCardIn 0.5s ease-out 0.15s both;
    }
    .exam-upload-block h3 {
        margin-bottom: 20px;
        color: #0f172a;
        font-weight: 700;
    }
    .exam-upload-block .form-control {
        width: 100%;
        padding: 14px 18px;
        border: 2px solid #cbd5e1;
        border-radius: 12px;
        font-size: 1rem;
        transition: border-color 0.25s ease, box-shadow 0.25s ease;
    }
    .exam-upload-block .form-control:focus {
        outline: none;
        border-color: #3b49a2;
        box-shadow: 0 0 0 4px rgba(59, 73, 162, 0.1);
    }
    .exam-upload-block .hint {
        color: #64748b;
        font-size: 0.85rem;
        margin-top: 8px;
    }
    .exam-btn-success {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 16px 40px;
        font-weight: 700;
        background: linear-gradient(135deg, #059669 0%, #10b981 100%);
        color: #fff;
        border: none;
        border-radius: 14px;
        font-size: 1.1rem;
        cursor: pointer;
        transition: transform 0.25s ease, box-shadow 0.3s ease;
        margin-top: 24px;
    }
    .exam-btn-success:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(16, 185, 129, 0.4);
    }

    /* Examen terminé */
    .exam-done-block {
        text-align: center;
        padding: 48px 32px;
        background: linear-gradient(180deg, #f0fdf4 0%, #dcfce7 100%);
        border-radius: 24px;
        border: 2px solid #bbf7d0;
        margin-top: 32px;
        animation: examDoneReveal 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }
    @keyframes examDoneReveal {
        from {
            opacity: 0;
            transform: scale(0.92) translateY(15px);
        }
        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }
    .exam-done-icon {
        width: 88px;
        height: 88px;
        background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
        color: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 24px;
        font-size: 2.5rem;
        animation: examCheckDraw 0.6s ease-out 0.3s both;
        box-shadow: 0 12px 32px rgba(34, 197, 94, 0.4);
    }
    @keyframes examCheckDraw {
        from {
            transform: scale(0);
            opacity: 0;
        }
        50% {
            transform: scale(1.15);
        }
        to {
            transform: scale(1);
            opacity: 1;
        }
    }
    .exam-done-block h2 {
        color: #166534;
        font-weight: 800;
        margin-bottom: 10px;
        font-size: 1.6rem;
    }
    .exam-done-block .subtitle {
        color: #15803d;
        font-size: 1.1rem;
        margin-bottom: 24px;
    }
    .exam-done-info {
        text-align: left;
        display: inline-block;
        background: #fff;
        padding: 22px 28px;
        border-radius: 18px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        min-width: 300px;
        margin-bottom: 20px;
    }
    .exam-done-info p {
        margin: 8px 0;
        font-size: 0.95rem;
    }
    .exam-done-info strong {
        color: #0f172a;
    }
    .exam-done-info span {
        color: #475569;
    }
    .exam-done-block .btn-outline-exam {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 14px 28px;
        border-radius: 14px;
        font-weight: 700;
        border: 2px solid #3b49a2;
        color: #3b49a2;
        text-decoration: none;
        transition: all 0.25s ease;
        margin-top: 16px;
    }
    .exam-done-block .btn-outline-exam:hover {
        background: rgba(59, 73, 162, 0.08);
        transform: translateY(-2px);
    }
    .exam-grade-box {
        display: inline-block;
        background: #fff;
        padding: 24px 44px;
        border-radius: 20px;
        box-shadow: 0 8px 28px rgba(0,0,0,0.08);
        margin-top: 24px;
        animation: examStatsPop 0.5s ease-out 0.2s both;
    }
    @keyframes examStatsPop {
        from { opacity: 0; transform: scale(0.9); }
        to { opacity: 1; transform: scale(1); }
    }
    .exam-grade-box .grade-label {
        color: #64748b;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.05em;
        margin-bottom: 6px;
    }
    .exam-grade-box .grade-value {
        font-size: 2.5rem;
        font-weight: 800;
        margin: 0;
        letter-spacing: -0.02em;
    }
    .exam-grade-box .grade-badge {
        display: inline-block;
        margin-top: 12px;
        padding: 6px 18px;
        border-radius: 999px;
        font-weight: 700;
        font-size: 0.9rem;
    }
    .exam-grade-box .grade-badge.passed {
        background: #bbf7d0;
        color: #166534;
    }
    .exam-grade-box .grade-badge.failed {
        background: #fecaca;
        color: #991b1b;
    }
    .exam-done-block .waiting-msg {
        margin-top: 20px;
        color: #64748b;
        font-weight: 500;
    }

    .exam-timer-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
        color: #fff;
        padding: 14px 22px;
        border-radius: 14px;
        margin-bottom: 24px;
        font-weight: 700;
    }
    .exam-timer-bar .exam-timer-label {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .exam-timer-bar .exam-timer-value {
        font-size: 1.4rem;
        font-variant-numeric: tabular-nums;
        letter-spacing: 0.05em;
    }
    .exam-anticheat-warn {
        background: #fef3c7;
        border: 1px solid #f59e0b;
        color: #92400e;
        padding: 12px 16px;
        border-radius: 12px;
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 20px;
    }
    .exam-closed-block .exam-closed-icon {
        background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
    }
</style>
{% endblock %}

{% block body %}
<div class="exam-show-page">
    <a href="{{ path('student_exams_index') }}" class="exam-back">
        <i class="fas fa-arrow-left"></i> Retour aux examens
    </a>

    <div class="exam-main-card">
        <div class="title-row">
            <h1>{{ exam.title }}</h1>
            <span class="type-badge">{{ exam.type }}</span>
        </div>

        <div class="exam-info-grid">
            <div class="exam-info-block">
                <p class="label">Durée</p>
                <p class="value">{{ exam.duration }} min</p>
            </div>
            <div class="exam-info-block">
                <p class="label">Questions</p>
                <p class="value">{{ exam.questions|length > 0 ? exam.questions|length : 'N/A' }}</p>
            </div>
        </div>

        <h3 class="exam-section-title">Consignes</h3>
        <div class="exam-consignes">
            {{ exam.description|nl2br }}
        </div>

        {% set examFileUrl = exam.filePath starts with 'uploads/' ? asset(exam.filePath) : asset('uploads/' ~ exam.filePath) %}
        {% if exam.filePath %}
        <a href="{{ examFileUrl }}" target="_blank" class="exam-download-btn">
            <i class="fas fa-download"></i> Télécharger le sujet
        </a>
        {% endif %}

        {% if exam.filePath and exam.filePath|lower|slice(-4) == '.pdf' %}
        <div class="exam-pdf-preview">
            <div class="preview-title">Aperçu du sujet</div>
            <iframe src="{{ examFileUrl }}" width="100%" height="800px">
                <p>Votre navigateur ne permet pas de prévisualiser ce fichier PDF. <a href="{{ examFileUrl }}">Cliquez ici pour le télécharger.</a></p>
            </iframe>
        </div>
        {% endif %}

        {% if not submission %}
        <form action="{{ path('student_exam_start', {id: exam.id}) }}" method="post">
            <button type="submit" class="exam-btn-primary">Commencer l'examen</button>
        </form>
        {% elseif submission.filePath is null and submission.closedAt is not null %}
        {# Examen clôturé sans rendu (abandon ou temps écoulé) #}
        <div class="exam-done-block exam-closed-block">
            <div class="exam-done-icon exam-closed-icon">
                <i class="fas fa-ban"></i>
            </div>
            <h2>Examen clôturé</h2>
            <p class="subtitle">Vous avez quitté la page ou le temps imparti est écoulé. Aucun rendu n'a été enregistré.</p>
            <div class="exam-grade-box">
                <p class="grade-label">Note</p>
                <p class="grade-value" style="color: #dc2626;">0 / 20</p>
                <span class="grade-badge failed">Non validé</span>
            </div>
        </div>
        {% elseif can_submit and submission.filePath is null %}
        {# En cours : timer + formulaire de rendu #}
        {% if remaining_seconds > 0 %}
        <div class="exam-timer-bar" id="examTimerBar">
            <span class="exam-timer-label"><i class="fas fa-clock"></i> Temps restant</span>
            <span class="exam-timer-value" id="examTimerValue">--:--</span>
        </div>
        {% endif %}
        <div class="exam-upload-block">
            <h3>Déposer votre rendu</h3>
            <p class="exam-anticheat-warn"><i class="fas fa-exclamation-triangle"></i> Ne quittez pas cette page avant d'avoir déposé votre rendu, sous peine de clôture de l'examen avec la note 0.</p>
            <form action="{{ path('student_exam_submit', {id: exam.id}) }}" method="post" enctype="multipart/form-data" id="examSubmitForm">
                <div style="margin-bottom: 20px;">
                    <label style="display: block; font-weight: 700; margin-bottom: 10px; color: #475569;">Votre travail (PDF)</label>
                    <input type="file" name="submissionFile" accept=".pdf" required class="form-control">
                    <p class="hint">Format accepté : PDF uniquement</p>
                </div>
                <div style="text-align: right;">
                    <button type="submit" class="exam-btn-success">
                        <i class="fas fa-upload"></i> Soumettre mon rendu
                    </button>
                </div>
            </form>
        </div>
        {% if remaining_seconds > 0 %}
        <script>
        (function() {
            var leaveUrl = '{{ path('student_exam_leave', {id: exam.id}) }}';
            var timeupUrl = '{{ path('student_exam_timeup', {id: exam.id}) }}';
            var remaining = {{ remaining_seconds }};
            var closed = false;

            function formatTime(sec) {
                var m = Math.floor(sec / 60);
                var s = sec % 60;
                return (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
            }

            function closeExam(reason) {
                if (closed) return;
                closed = true;
                if (reason === 'timeup') {
                    navigator.sendBeacon ? navigator.sendBeacon(timeupUrl) : (new Image()).src = timeupUrl;
                } else {
                    navigator.sendBeacon ? navigator.sendBeacon(leaveUrl) : (new Image()).src = leaveUrl;
                }
            }

            var el = document.getElementById('examTimerValue');
            var timer = setInterval(function() {
                if (remaining <= 0) {
                    clearInterval(timer);
                    if (el) el.textContent = '0:00';
                    closeExam('timeup');
                    window.location.reload();
                    return;
                }
                remaining--;
                if (el) el.textContent = formatTime(remaining);
            }, 1000);
            if (el) el.textContent = formatTime(remaining);

            window.addEventListener('beforeunload', function() { closeExam('leave'); });
            window.addEventListener('pagehide', function() { closeExam('leave'); });
            document.getElementById('examSubmitForm').addEventListener('submit', function() { closed = true; });
        })();
        </script>
        {% endif %}
        {% else %}
        <div class="exam-done-block">
            <div class="exam-done-icon">
                <i class="fas fa-check"></i>
            </div>
            <h2>Examen terminé</h2>
            <p class="subtitle">Votre participation a été enregistrée.</p>

            <div class="exam-done-info">
                <p><strong>Candidat :</strong> <span>{{ submission.student ? submission.student.email : (submission.candidateIdentifier ?? 'Anonyme') }}</span></p>
                <p><strong>Date :</strong> <span>{{ submission.submittedAt|date('d/m/Y H:i') }}</span></p>
            </div>

            {% set submissionFileUrl = submission.filePath starts with 'uploads/' ? asset(submission.filePath) : asset('uploads/' ~ submission.filePath) %}
            {% if submission.filePath %}
            <a href="{{ submissionFileUrl }}" target="_blank" class="btn-outline-exam">
                <i class="fas fa-file-pdf"></i> Voir ma copie
            </a>
            {% endif %}

            {% if submission.grade is not null %}
            <div class="exam-grade-box">
                <p class="grade-label">Note obtenue</p>
                <p class="grade-value" style="color: {{ submission.isPassed ? '#166534' : '#dc2626' }};">{{ submission.grade }} / 20</p>
                <span class="grade-badge {{ submission.isPassed ? 'passed' : 'failed' }}">
                    {{ submission.isPassed ? 'Validé' : 'Non validé' }}
                </span>
            </div>
            {% else %}
            <p class="waiting-msg">Votre travail est en cours de correction.</p>
            {% endif %}
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
