{% extends 'student_layout.html.twig' %}

{% block title %}Mes Examens - EduSmart{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
    .exam-page {
        font-family: 'Plus Jakarta Sans', var(--font-sans, sans-serif);
        max-width: 1200px;
        margin: 0 auto;
        padding: 28px 24px 48px;
    }

    .exam-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 24px;
        margin-bottom: 48px;
        animation: examFadeInDown 0.6s ease-out;
    }
    @keyframes examFadeInDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .exam-header h2 {
        font-size: clamp(1.6rem, 4vw, 2.1rem);
        font-weight: 800;
        color: #0f172a;
        margin: 0 0 6px 0;
        letter-spacing: -0.02em;
    }
    .exam-header .subtitle {
        color: #64748b;
        font-size: 1rem;
        font-weight: 500;
    }

    .exam-stats-widget {
        background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
        padding: 16px 24px;
        border-radius: 20px;
        box-shadow: 0 4px 24px rgba(59, 73, 162, 0.08), 0 0 0 1px rgba(59, 73, 162, 0.06);
        display: flex;
        align-items: center;
        gap: 16px;
        animation: examStatsPop 0.7s ease-out 0.2s both;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .exam-stats-widget:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 32px rgba(59, 73, 162, 0.12);
    }
    @keyframes examStatsPop {
        from {
            opacity: 0;
            transform: scale(0.92);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }
    .exam-stats-widget .value {
        text-align: right;
    }
    .exam-stats-widget .label {
        font-size: 0.7rem;
        color: #64748b;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }
    .exam-stats-widget .number {
        font-size: 1.35rem;
        font-weight: 800;
        color: #3b49a2;
        letter-spacing: -0.02em;
    }
    .exam-stats-widget .icon-wrap {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6366f1;
        font-size: 1.25rem;
        animation: examIconPulse 3s ease-in-out infinite;
    }
    @keyframes examIconPulse {
        0%, 100% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.05); opacity: 0.9; }
    }

    .exam-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 28px;
    }

    .exam-card {
        background: #fff;
        padding: 28px;
        border-radius: 24px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04), 0 0 0 1px rgba(0, 0, 0, 0.03);
        transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
                    box-shadow 0.4s ease,
                    border-color 0.3s ease;
        border: 1px solid transparent;
        animation: examCardIn 0.6s ease-out both;
        position: relative;
        overflow: hidden;
    }
    .exam-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #3b49a2, #6366f1);
        opacity: 0;
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s;
    }
    .exam-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(59, 73, 162, 0.12), 0 0 0 1px rgba(59, 73, 162, 0.08);
        border-color: rgba(59, 73, 162, 0.1);
    }
    .exam-card:hover::before {
        opacity: 1;
        transform: scaleX(1);
    }
    @keyframes examCardIn {
        from {
            opacity: 0;
            transform: translateY(24px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    {% for exam in exams %}
    .exam-card:nth-child({{ loop.index }}) { animation-delay: {{ loop.index0 * 0.08 }}s; }
    {% endfor %}

    .exam-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 20px;
    }
    .exam-card-icon {
        width: 56px;
        height: 56px;
        border-radius: 18px;
        background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #10b981;
        font-size: 1.5rem;
        transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .exam-card:hover .exam-card-icon {
        transform: scale(1.08) rotate(-4deg);
    }
    .exam-card-badge {
        background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%);
        color: #047857;
        padding: 6px 14px;
        border-radius: 999px;
        font-size: 0.7rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .exam-card h3 {
        font-size: 1.25rem;
        font-weight: 800;
        color: #0f172a;
        margin: 0 0 12px 0;
        line-height: 1.3;
        letter-spacing: -0.02em;
    }
    .exam-card-desc {
        font-size: 0.95rem;
        color: #64748b;
        margin-bottom: 22px;
        line-height: 1.55;
    }
    .exam-card-meta {
        display: flex;
        gap: 20px;
        margin-bottom: 24px;
        font-size: 0.9rem;
        color: #94a3b8;
        font-weight: 600;
    }
    .exam-card-meta span {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .exam-card-meta i {
        opacity: 0.85;
    }

    .exam-card .btn-start {
        display: block;
        width: 100%;
        padding: 14px 20px;
        border-radius: 14px;
        font-weight: 700;
        font-size: 1rem;
        text-align: center;
        text-decoration: none;
        background: linear-gradient(135deg, #3b49a2 0%, #4f46e5 100%);
        color: #fff;
        border: none;
        cursor: pointer;
        transition: transform 0.25s ease, box-shadow 0.3s ease;
        position: relative;
        overflow: hidden;
    }
    .exam-card .btn-start::after {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
        transition: left 0.5s ease;
    }
    .exam-card .btn-start:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(59, 73, 162, 0.35);
    }
    .exam-card .btn-start:hover::after {
        left: 100%;
    }

    .exam-empty {
        grid-column: 1 / -1;
        text-align: center;
        padding: 64px 32px;
        background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
        border-radius: 24px;
        border: 2px dashed #cbd5e1;
        animation: examFadeInDown 0.5s ease-out;
    }
    .exam-empty-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 20px;
        border-radius: 24px;
        background: linear-gradient(135deg, #e2e8f0 0%, #cbd5e1 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #64748b;
        font-size: 2rem;
        animation: examIconPulse 2.5s ease-in-out infinite;
    }
    .exam-empty p {
        color: #64748b;
        font-size: 1.1rem;
        font-weight: 600;
        margin: 0;
    }
</style>
{% endblock %}

{% block body %}
<div class="exam-page">
    <header class="exam-header">
        <div>
            <h2>Mes Examens & Évaluations</h2>
            <p class="subtitle">Consultez vos épreuves à venir et vos résultats passés.</p>
        </div>
        <div class="exam-stats-widget">
            <div class="value">
                <p class="label">Moyenne Générale</p>
                <p class="number">16.5/20</p>
            </div>
            <div class="icon-wrap">
                <i class="fas fa-graduation-cap"></i>
            </div>
        </div>
    </header>

    <div class="exam-grid">
        {% for exam in exams %}
        <article class="exam-card">
            <div class="exam-card-header">
                <div class="exam-card-icon">
                    <i class="fas fa-file-contract"></i>
                </div>
                <span class="exam-card-badge">{{ exam.type }}</span>
            </div>
            <h3>{{ exam.title }}</h3>
            <p class="exam-card-desc">{{ exam.description|slice(0, 100) ~ (exam.description|length > 100 ? '...' : '') }}</p>
            <div class="exam-card-meta">
                <span><i class="far fa-clock"></i> {{ exam.duration }} min</span>
            </div>
            <a href="{{ path('student_exam_show', {id: exam.id}) }}" class="btn-start">Commencer l'examen</a>
        </article>
        {% else %}
        <div class="exam-empty">
            <div class="exam-empty-icon">
                <i class="fas fa-clipboard-list"></i>
            </div>
            <p>Aucun examen disponible pour le moment.</p>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
