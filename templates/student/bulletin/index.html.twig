{% extends 'student_layout.html.twig' %}

{% block title %}Mes Bulletins de Notes - EduSmart{% endblock %}

{% block body %}
<div class="student-bulletins-page" style="max-width: 1200px; margin: 0 auto; padding: 20px;">
    {# Header Section #}
    <div style="margin-bottom: 40px;">
        <h2 style="font-size: 1.8rem; font-weight: 800; color: #1E293B; margin-bottom: 8px;">
            <i class="fas fa-clipboard-list" style="color: #6366F1; margin-right: 10px;"></i>
            Mes Bulletins de Notes
        </h2>
        <p style="color: #64748B;">Consultez vos résultats académiques et suivez vos performances par période.</p>
    </div>

    {# Stats Summary #}
    {% if bulletins|length > 0 %}
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 40px;">
        <div class="card" style="padding: 25px; text-align: center; background: linear-gradient(135deg, #EEF2FF 0%, #E0E7FF 100%); border: none;">
            <div style="font-size: 2.5rem; font-weight: 900; color: #6366F1;">{{ bulletins|length }}</div>
            <div style="font-size: 0.85rem; font-weight: 700; color: #64748B; text-transform: uppercase; letter-spacing: 0.05em;">Bulletins Totaux</div>
        </div>
        
        {% set published_count = 0 %}
        {% set total_avg = 0 %}
        {% for b in bulletins %}
            {% if b.status == 'Publié' %}{% set published_count = published_count + 1 %}{% endif %}
            {% set total_avg = total_avg + (b.average ?? 0) %}
        {% endfor %}
        
        <div class="card" style="padding: 25px; text-align: center; background: linear-gradient(135deg, #D1FAE5 0%, #A7F3D0 100%); border: none;">
            <div style="font-size: 2.5rem; font-weight: 900; color: #10B981;">{{ published_count }}</div>
            <div style="font-size: 0.85rem; font-weight: 700; color: #64748B; text-transform: uppercase; letter-spacing: 0.05em;">Publiés</div>
        </div>
        
        <div class="card" style="padding: 25px; text-align: center; background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%); border: none;">
            <div style="font-size: 2.5rem; font-weight: 900; color: #F59E0B;">
                {{ bulletins|length > 0 ? (total_avg / bulletins|length)|number_format(2) : '0.00' }}
            </div>
            <div style="font-size: 0.85rem; font-weight: 700; color: #64748B; text-transform: uppercase; letter-spacing: 0.05em;">Moyenne Générale</div>
        </div>
    </div>
    {% endif %}

    {# Bulletins Grid #}
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(380px, 1fr)); gap: 25px;">
        {% for bulletin in bulletins %}
            <div class="card bulletin-card" style="padding: 0; overflow: hidden; transition: all 0.3s ease; border: 1px solid #E2E8F0;" 
                 onmouseover="this.style.transform='translateY(-8px)'; this.style.boxShadow='0 20px 40px rgba(99, 102, 241, 0.15)';" 
                 onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none';">
                
                {# Card Header #}
                <div style="padding: 25px; background: linear-gradient(135deg, #6366F1 0%, #4F46E5 100%); color: white;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                        <div>
                            <div style="font-size: 1.3rem; font-weight: 800;">{{ bulletin.academicYear }}</div>
                            <div style="font-size: 0.9rem; opacity: 0.9;">{{ bulletin.semester }}</div>
                        </div>
                        <span style="background: rgba(255,255,255,0.2); padding: 6px 14px; border-radius: 20px; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; backdrop-filter: blur(10px);">
                            {% if bulletin.status == 'Publié' %}
                                <i class="fas fa-check-circle me-1"></i> Publié
                            {% elseif bulletin.status == 'Validé' %}
                                <i class="fas fa-shield-check me-1"></i> Validé
                            {% elseif bulletin.status == 'Vérifié' %}
                                <i class="fas fa-eye me-1"></i> Vérifié
                            {% else %}
                                <i class="fas fa-file-edit me-1"></i> {{ bulletin.status }}
                            {% endif %}
                        </span>
                    </div>
                </div>
                
                {# Card Body #}
                <div style="padding: 25px;">
                    {# Average Display #}
                    <div style="text-align: center; margin-bottom: 20px; padding: 20px; background: #F8FAFC; border-radius: 15px;">
                        <div style="font-size: 0.8rem; font-weight: 700; color: #94A3B8; text-transform: uppercase; margin-bottom: 5px;">Moyenne Générale</div>
                        <div style="font-size: 3rem; font-weight: 900; color: {{ (bulletin.average ?? 0) >= 10 ? '#10B981' : '#EF4444' }};">
                            {{ (bulletin.average ?? 0)|number_format(2) }}
                            <span style="font-size: 1.2rem; color: #94A3B8;">/20</span>
                        </div>
                        {% if bulletin.mention %}
                        <div style="margin-top: 10px;">
                            <span style="background: {{ bulletin.mention == 'Très Bien' ? '#D1FAE5' : (bulletin.mention == 'Bien' ? '#DBEAFE' : (bulletin.mention == 'Assez Bien' ? '#FEF3C7' : '#F3F4F6')) }}; color: {{ bulletin.mention == 'Très Bien' ? '#10B981' : (bulletin.mention == 'Bien' ? '#3B82F6' : (bulletin.mention == 'Assez Bien' ? '#F59E0B' : '#6B7280')) }}; padding: 6px 16px; border-radius: 20px; font-size: 0.8rem; font-weight: 800;">
                                {{ bulletin.mention }}
                            </span>
                        </div>
                        {% endif %}
                    </div>
                    
                    {# Details Grid #}
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 20px;">
                        {% if bulletin.classRank %}
                        <div style="background: #F1F5F9; padding: 15px; border-radius: 12px; text-align: center;">
                            <div style="font-size: 0.75rem; color: #64748B; font-weight: 600;">Rang</div>
                            <div style="font-size: 1.2rem; font-weight: 800; color: #1E293B;">#{{ bulletin.classRank }}</div>
                        </div>
                        {% endif %}
                        
                        <div style="background: #F1F5F9; padding: 15px; border-radius: 12px; text-align: center;">
                            <div style="font-size: 0.75rem; color: #64748B; font-weight: 600;">Matières</div>
                            <div style="font-size: 1.2rem; font-weight: 800; color: #1E293B;">{{ bulletin.reportCardLines|length }}</div>
                        </div>
                    </div>
                    
                    {# Footer Info #}
                    <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 15px; border-top: 1px solid #E2E8F0;">
                        <div style="font-size: 0.8rem; color: #94A3B8;">
                            <i class="far fa-calendar me-1"></i> {{ bulletin.createdAt|date('d/m/Y') }}
                        </div>
                        
                        {% if bulletin.pdfPath and bulletin.status == 'Publié' %}
                        <a href="{{ path('student_bulletin_pdf', {id: bulletin.id}) }}" target="_blank" 
                           style="display: inline-flex; align-items: center; gap: 8px; background: #EF4444; color: white; padding: 8px 16px; border-radius: 10px; text-decoration: none; font-size: 0.85rem; font-weight: 700; transition: 0.3s;"
                           onmouseover="this.style.background='#DC2626'" onmouseout="this.style.background='#EF4444'">
                            <i class="fas fa-file-pdf"></i> Télécharger PDF
                        </a>
                        {% endif %}
                    </div>

                    {# Verification Code #}
                    {% if bulletin.verificationCode and bulletin.status == 'Publié' %}
                    <div style="margin-top: 15px; padding: 12px; background: #F0FDF4; border-radius: 10px; text-align: center;">
                        <div style="font-size: 0.7rem; color: #16A34A; font-weight: 600; margin-bottom: 5px;">
                            <i class="fas fa-shield-check me-1"></i> Code de Vérification
                        </div>
                        <code style="font-size: 0.9rem; font-weight: 800; color: #15803D; background: rgba(22, 163, 74, 0.1); padding: 4px 12px; border-radius: 6px;">
                            {{ bulletin.verificationCode }}
                        </code>
                    </div>
                    {% endif %}
                </div>
            </div>
        {% else %}
            <div class="card" style="padding: 60px; text-align: center; grid-column: 1 / -1;">
                <div style="width: 100px; height: 100px; margin: 0 auto 25px; background: #F1F5F9; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-clipboard-list" style="font-size: 2.5rem; color: #CBD5E1;"></i>
                </div>
                <h3 style="font-size: 1.3rem; font-weight: 800; color: #1E293B; margin-bottom: 10px;">Aucun bulletin disponible</h3>
                <p style="color: #94A3B8; font-weight: 500; max-width: 400px; margin: 0 auto;">
                    Vos bulletins de notes apparaîtront ici une fois qu'ils seront publiés par l'administration.
                </p>
            </div>
        {% endfor %}
    </div>
</div>

<style>
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .bulletin-card {
        animation: fadeInUp 0.5s ease forwards;
    }
    
    .bulletin-card:nth-child(1) { animation-delay: 0.1s; }
    .bulletin-card:nth-child(2) { animation-delay: 0.2s; }
    .bulletin-card:nth-child(3) { animation-delay: 0.3s; }
    .bulletin-card:nth-child(4) { animation-delay: 0.4s; }
</style>
{% endblock %}
