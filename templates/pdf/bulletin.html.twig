<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        body { 
            font-family: 'DejaVu Sans', sans-serif; 
            font-size: 14px; 
            line-height: 1.6; 
            color: #1E293B; 
            background: linear-gradient(135deg, #F8FAFC 0%, #EEF2FF 100%);
        }
        .container { 
            width: 85%; 
            margin: 40px auto; 
            border: 3px solid #6366F1; 
            border-radius: 20px;
            padding: 50px; 
            position: relative; 
            background: white;
            box-shadow: 0 25px 50px rgba(99, 102, 241, 0.15);
        }
        .container::before {
            content: '';
            position: absolute;
            top: 8px;
            left: 8px;
            right: 8px;
            bottom: 8px;
            border: 1px solid #C7D2FE;
            border-radius: 16px;
            pointer-events: none;
        }
        .header { text-align: center; margin-bottom: 40px; }
        .logo-box { margin-bottom: 25px; }
        .logo-text {
            font-size: 36px;
            font-weight: 900;
            background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 50%, #6366F1 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: -1px;
        }
        .logo-tagline {
            font-size: 11px;
            color: #64748B;
            text-transform: uppercase;
            letter-spacing: 3px;
            margin-top: 5px;
        }
        .logo { width: 80px; }
        .doc-title { 
            font-size: 26px; 
            font-weight: 800; 
            color: #1E293B; 
            margin-bottom: 8px; 
            text-transform: uppercase; 
            letter-spacing: 2px;
        }
        .cert-badge {
            display: inline-block;
            background: linear-gradient(135deg, #4F46E5, #7C3AED);
            color: white;
            padding: 8px 25px;
            border-radius: 50px;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1px;
            margin-bottom: 15px;
        }
        .cert-number { 
            font-family: monospace; 
            font-size: 11px; 
            color: #64748B; 
            background: #F1F5F9;
            padding: 6px 15px;
            border-radius: 8px;
            display: inline-block;
        }
        .content { text-align: left; margin-bottom: 50px; padding: 30px; background: #FAFBFF; border-radius: 16px; }
        .student-name { 
            font-size: 24px; 
            font-weight: 800; 
            color: #4F46E5;
            margin: 20px 0; 
            padding: 10px 0;
            border-bottom: 2px solid #E0E7FF;
            text-align: center;
        }
        .highlight-box {
            background: #EEF2FF;
            border-left: 4px solid #4F46E5;
            padding: 15px 20px;
            margin: 15px 0;
            text-align: left;
        }
        .grades-table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
            font-size: 12px;
        }
        .grades-table th {
            background: linear-gradient(135deg, #4F46E5, #6366F1);
            color: white;
            padding: 12px 8px;
            text-align: left;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 10px;
            letter-spacing: 0.5px;
        }
        .grades-table td {
            padding: 10px 8px;
            border-bottom: 1px solid #E2E8F0;
        }
        .grades-table tr:nth-child(even) { background: #F8FAFC; }
        .grades-table .grade-cell { text-align: center; font-weight: 700; }
        .grades-table .grade-good { color: #059669; }
        .grades-table .grade-bad { color: #DC2626; }
        .summary-box {
            background: linear-gradient(135deg, #EEF2FF, #E0E7FF);
            border-radius: 12px;
            padding: 20px;
            margin-top: 20px;
            display: table;
            width: 100%;
        }
        .summary-item {
            display: table-cell;
            text-align: center;
            padding: 0 15px;
            border-right: 1px solid #C7D2FE;
        }
        .summary-item:last-child { border-right: none; }
        .summary-label {
            font-size: 10px;
            color: #64748B;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .summary-value {
            font-size: 20px;
            font-weight: 900;
            color: #4F46E5;
            margin-top: 5px;
        }
        .footer { margin-top: 40px; position: relative; height: 150px; }
        .sig-box { float: left; width: 40%; text-align: center; }
        .sig-box-right { float: right; width: 40%; text-align: center; }
        .sig-title {
            font-size: 11px;
            color: #64748B;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 10px;
        }
        .sig-image { max-width: 100px; display: block; margin: 10px auto; }
        .qr-box { 
            position: absolute; 
            bottom: -30px; 
            left: 50%; 
            transform: translateX(-50%); 
            text-align: center; 
            font-size: 9px; 
            background: white;
            padding: 15px;
            border-radius: 12px;
            border: 1px solid #E2E8F0;
        }
        .qr-image { width: 80px; border-radius: 8px; }
        .qr-label { color: #64748B; margin-top: 8px; }
        .clear { clear: both; }
        .watermark {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-30deg);
            font-size: 100px;
            font-weight: 900;
            color: rgba(99, 102, 241, 0.03);
            pointer-events: none;
            white-space: nowrap;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="watermark">EDUSMART</div>
        <div class="header">
            <div class="logo-box">
                {% if logo %}
                    <img src="data:image/png;base64,{{ (projectDir ~ '/public/' ~ logo.imagePath)|file_to_base64 }}" class="logo">
                {% else %}
                    <div class="logo-text">EduSmart</div>
                    <div class="logo-tagline">Excellence Academique</div>
                {% endif %}
            </div>
            <div class="doc-title">RELEVÉ DE NOTES</div>
            <div class="cert-number">N° BUL-{{ bulletin.id }}-{{ bulletin.academicYear|replace({'/': ''}) }}</div>
        </div>

        <div class="content">
            <p style="text-align: center; color: #475569; margin-bottom: 20px;">
                Relevé officiel des résultats académiques de :
            </p>
            <div class="student-name">
                {{ bulletin.student.prenom }} {{ bulletin.student.name }}
            </div>
            
            <div class="highlight-box">
                <strong>Année académique :</strong> {{ bulletin.academicYear }}<br>
                <strong>Période :</strong> {{ bulletin.semester }}
            </div>
            
            <table class="grades-table">
                <thead>
                    <tr>
                        <th style="width: 45%;">Matière</th>
                        <th style="width: 15%; text-align: center;">Coefficient</th>
                        <th style="width: 15%; text-align: center;">Note</th>
                        <th style="width: 25%;">Observations</th>
                    </tr>
                </thead>
                <tbody>
                    {% for line in bulletin.reportCardLines %}
                    <tr>
                        <td>{{ line.moduleName }}</td>
                        <td class="grade-cell">{{ line.coefficient }}</td>
                        <td class="grade-cell {{ line.note >= 10 ? 'grade-good' : 'grade-bad' }}">
                            {{ line.note|number_format(2) }}/20
                        </td>
                        <td style="font-size: 10px; color: #64748B;">{{ line.teacherComment|default('—') }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            
            <div class="summary-box">
                <div class="summary-item">
                    <div class="summary-label">Moyenne Générale</div>
                    <div class="summary-value" style="{{ bulletin.average >= 10 ? 'color: #059669;' : 'color: #DC2626;' }}">
                        {{ bulletin.average|number_format(2) }}/20
                    </div>
                </div>
                <div class="summary-item">
                    <div class="summary-label">Mention</div>
                    <div class="summary-value" style="font-size: 14px;">
                        {{ bulletin.computeMention() }}
                    </div>
                </div>
                <div class="summary-item">
                    <div class="summary-label">Rang</div>
                    <div class="summary-value">
                        {% if bulletin.classRank %}
                            {{ bulletin.classRank }}{% if bulletin.classRank == 1 %}er{% else %}ème{% endif %}
                        {% else %}
                            —
                        {% endif %}
                    </div>
                </div>
            </div>
            
            <p style="margin-top: 20px; color: #64748B; font-style: italic; text-align: center; font-size: 12px;">
                Fait à Tunis, le {{ "now"|date('d/m/Y') }}
            </p>
        </div>

        <div class="footer">
            <div class="sig-box">
                <div class="sig-title">Le Chef de Departement</div>
                {% if cachet %}
                    <img src="data:image/png;base64,{{ (projectDir ~ '/public/' ~ cachet.imagePath)|file_to_base64 }}" class="sig-image">
                {% endif %}
            </div>
            <div class="sig-box-right">
                <div class="sig-title">Le Directeur de l'Etablissement</div>
                {% if signature %}
                    <img src="data:image/png;base64,{{ (projectDir ~ '/public/' ~ signature.imagePath)|file_to_base64 }}" class="sig-image">
                {% endif %}
            </div>
            <div class="clear"></div>

            <div class="qr-box">
                <img src="data:image/png;base64,{{ qrBase64 }}" class="qr-image"><br>
                <div class="qr-label">
                    Verifiez sur {{ verifyUrl }}<br>
                    <strong>{{ bulletin.verificationCode }}</strong>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
