<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        body { 
            font-family: 'DejaVu Sans', sans-serif; 
            font-size: 14px; 
            line-height: 1.6; 
            color: #1E293B; 
            background: linear-gradient(135deg, #F8FAFC 0%, #EEF2FF 100%);
        }
        .container { 
            width: 85%; 
            margin: 40px auto; 
            border: 3px solid #6366F1; 
            border-radius: 20px;
            padding: 50px; 
            position: relative; 
            background: white;
            box-shadow: 0 25px 50px rgba(99, 102, 241, 0.15);
        }
        .container::before {
            content: '';
            position: absolute;
            top: 8px;
            left: 8px;
            right: 8px;
            bottom: 8px;
            border: 1px solid #C7D2FE;
            border-radius: 16px;
            pointer-events: none;
        }
        .header { text-align: center; margin-bottom: 40px; }
        .logo-box { margin-bottom: 25px; }
        .logo-text {
            font-size: 36px;
            font-weight: 900;
            background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 50%, #6366F1 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: -1px;
        }
        .logo-tagline {
            font-size: 11px;
            color: #64748B;
            text-transform: uppercase;
            letter-spacing: 3px;
            margin-top: 5px;
        }
        .logo { width: 80px; }
        .doc-title { 
            font-size: 26px; 
            font-weight: 800; 
            color: #1E293B; 
            margin-bottom: 8px; 
            text-transform: uppercase; 
            letter-spacing: 2px;
        }
        .cert-badge {
            display: inline-block;
            background: linear-gradient(135deg, #4F46E5, #7C3AED);
            color: white;
            padding: 8px 25px;
            border-radius: 50px;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1px;
            margin-bottom: 15px;
        }
        .cert-number { 
            font-family: monospace; 
            font-size: 11px; 
            color: #64748B; 
            background: #F1F5F9;
            padding: 6px 15px;
            border-radius: 8px;
            display: inline-block;
        }
        .content { text-align: center; margin-bottom: 50px; padding: 30px; background: #FAFBFF; border-radius: 16px; }
        .student-name { 
            font-size: 24px; 
            font-weight: 800; 
            color: #4F46E5;
            margin: 20px 0; 
            padding: 10px 0;
            border-bottom: 2px solid #E0E7FF;
        }
        .footer { margin-top: 40px; position: relative; height: 150px; }
        .sig-box { float: left; width: 40%; text-align: center; }
        .sig-box-right { float: right; width: 40%; text-align: center; }
        .sig-title {
            font-size: 11px;
            color: #64748B;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 10px;
        }
        .sig-image { max-width: 100px; display: block; margin: 10px auto; }
        .qr-box { 
            position: absolute; 
            bottom: -30px; 
            left: 50%; 
            transform: translateX(-50%); 
            text-align: center; 
            font-size: 9px; 
            background: white;
            padding: 15px;
            border-radius: 12px;
            border: 1px solid #E2E8F0;
        }
        .qr-image { width: 80px; border-radius: 8px; }
        .qr-label {
            color: #64748B;
            margin-top: 8px;
        }
        .clear { clear: both; }
        .watermark {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-30deg);
            font-size: 100px;
            font-weight: 900;
            color: rgba(99, 102, 241, 0.03);
            pointer-events: none;
            white-space: nowrap;
        }
        
        /* Styles pour le relevé de notes */
        .grades-table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
            font-size: 12px;
        }
        .grades-table th {
            background: linear-gradient(135deg, #4F46E5, #6366F1);
            color: white;
            padding: 12px 8px;
            text-align: left;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 10px;
            letter-spacing: 0.5px;
        }
        .grades-table td {
            padding: 10px 8px;
            border-bottom: 1px solid #E2E8F0;
        }
        .grades-table tr:nth-child(even) { background: #F8FAFC; }
        .grades-table .grade-cell { text-align: center; font-weight: 700; }
        .grades-table .grade-good { color: #059669; }
        .grades-table .grade-bad { color: #DC2626; }
        
        .summary-box {
            background: linear-gradient(135deg, #EEF2FF, #E0E7FF);
            border-radius: 12px;
            padding: 20px;
            margin-top: 20px;
            display: table;
            width: 100%;
        }
        .summary-item {
            display: table-cell;
            text-align: center;
            padding: 0 15px;
            border-right: 1px solid #C7D2FE;
        }
        .summary-item:last-child { border-right: none; }
        .summary-label {
            font-size: 10px;
            color: #64748B;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .summary-value {
            font-size: 20px;
            font-weight: 900;
            color: #4F46E5;
            margin-top: 5px;
        }
        
        .attestation-text {
            font-size: 14px;
            line-height: 1.8;
            color: #475569;
            text-align: justify;
            padding: 0 20px;
        }
        .attestation-text strong { color: #1E293B; }
        .highlight-box {
            background: #EEF2FF;
            border-left: 4px solid #4F46E5;
            padding: 15px 20px;
            margin: 15px 0;
            text-align: left;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="watermark">EDUSMART</div>
        <div class="header">
            <div class="logo-box">
                {% if logo %}
                    <img src="data:image/png;base64,{{ (projectDir ~ '/public/' ~ logo.imagePath)|file_to_base64 }}" class="logo">
                {% else %}
                    <div class="logo-text">EduSmart</div>
                    <div class="logo-tagline">Excellence Academique</div>
                {% endif %}
            </div>
            <div class="cert-badge">Document Officiel</div>
            <div class="doc-title">{{ certification.getTypeLabel() }}</div>
            <div class="cert-number">N° {{ certification.uniqueNumber }}</div>
        </div>

        {# ==================== CONTENU SELON LE TYPE ==================== #}
        
        {% if certification.type == 'NOTES' %}
            {# ========== RELEVÉ DE NOTES ========== #}
            <div class="content" style="text-align: left;">
                <p style="text-align: center; color: #475569; margin-bottom: 20px;">
                    Relevé officiel des résultats académiques de :
                </p>
                <div class="student-name" style="text-align: center;">
                    {{ certification.student.prenom }} {{ certification.student.name }}
                </div>
                
                {% if certification.bulletin %}
                <div class="highlight-box">
                    <strong>Année académique :</strong> {{ certification.bulletin.academicYear }}<br>
                    <strong>Période :</strong> {{ certification.bulletin.semester }}
                </div>
                
                <table class="grades-table">
                    <thead>
                        <tr>
                            <th style="width: 45%;">Matière</th>
                            <th style="width: 15%; text-align: center;">Coefficient</th>
                            <th style="width: 15%; text-align: center;">Note</th>
                            <th style="width: 25%;">Observations</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for line in certification.bulletin.reportCardLines %}
                        <tr>
                            <td>{{ line.moduleName }}</td>
                            <td class="grade-cell">{{ line.coefficient|default(1) }}</td>
                            <td class="grade-cell {{ line.note >= 10 ? 'grade-good' : 'grade-bad' }}">
                                {{ line.note|number_format(2) }}/20
                            </td>
                            <td style="font-size: 10px; color: #64748B;">{{ line.teacherComment|default('—') }}</td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="4" style="text-align: center; color: #94A3B8;">Aucune note enregistrée</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
                
                <div class="summary-box">
                    <div class="summary-item">
                        <div class="summary-label">Moyenne Générale</div>
                        <div class="summary-value" style="{{ certification.bulletin.average >= 10 ? 'color: #059669;' : 'color: #DC2626;' }}">
                            {{ certification.bulletin.average|number_format(2) }}/20
                        </div>
                    </div>
                    <div class="summary-item">
                        <div class="summary-label">Mention</div>
                        <div class="summary-value" style="font-size: 14px;">
                            {{ certification.bulletin.mention|default('—') }}
                        </div>
                    </div>
                    <div class="summary-item">
                        <div class="summary-label">Rang</div>
                        <div class="summary-value">
                            {% if certification.bulletin.classRank %}
                                {{ certification.bulletin.classRank }}{% if certification.bulletin.classRank == 1 %}er{% else %}ème{% endif %}
                            {% else %}
                                —
                            {% endif %}
                        </div>
                    </div>
                </div>
                {% else %}
                <p style="text-align: center; color: #94A3B8;">Aucun bulletin associé à cette certification.</p>
                {% endif %}
                
                <p style="margin-top: 20px; color: #64748B; font-style: italic; text-align: center; font-size: 12px;">
                    Fait à Tunis, le {{ certification.issuedAt|date('d/m/Y') }}
                </p>
            </div>
            
        {% elseif certification.type == 'SCOLARITE' %}
            {# ========== ATTESTATION DE SCOLARITÉ ========== #}
            <div class="content">
                <p class="attestation-text">
                    Le Directeur de l'établissement <strong>EduSmart</strong> atteste par la présente que :
                </p>
                <div class="student-name">{{ certification.student.prenom }} {{ certification.student.name }}</div>
                <div class="attestation-text">
                    <p>
                        Est régulièrement inscrit(e) au sein de notre établissement pour l'année académique 
                        <strong>{{ certification.issuedAt|date('Y') }}/{{ certification.issuedAt|date('Y') + 1 }}</strong>.
                    </p>
                    <div class="highlight-box">
                        <strong>Email :</strong> {{ certification.student.email }}<br>
                        {% if certification.student.numtel %}
                        <strong>Téléphone :</strong> {{ certification.student.numtel }}
                        {% endif %}
                    </div>
                    <p>
                        Cette attestation est délivrée à l'intéressé(e) pour servir et valoir ce que de droit.
                    </p>
                </div>
                <p style="margin-top: 25px; color: #64748B; font-style: italic; font-size: 12px;">
                    Fait à Tunis, le {{ certification.issuedAt|date('d/m/Y') }}
                </p>
            </div>
            
        {% elseif certification.type == 'REUSSITE' %}
            {# ========== CERTIFICAT DE RÉUSSITE ========== #}
            <div class="content">
                <p class="attestation-text">
                    Le jury de l'établissement <strong>EduSmart</strong> certifie par la présente que :
                </p>
                <div class="student-name">{{ certification.student.prenom }} {{ certification.student.name }}</div>
                <div class="attestation-text">
                    {% if certification.bulletin %}
                    <p>
                        A satisfait aux épreuves de contrôle des connaissances et obtenu les résultats suivants 
                        pour <strong>{{ certification.bulletin.semester }}</strong> de l'année académique 
                        <strong>{{ certification.bulletin.academicYear }}</strong> :
                    </p>
                    <div class="summary-box">
                        <div class="summary-item">
                            <div class="summary-label">Moyenne Obtenue</div>
                            <div class="summary-value" style="{{ certification.bulletin.average >= 10 ? 'color: #059669;' : 'color: #DC2626;' }}">
                                {{ certification.bulletin.average|number_format(2) }}/20
                            </div>
                        </div>
                        <div class="summary-item">
                            <div class="summary-label">Mention Attribuée</div>
                            <div class="summary-value" style="font-size: 14px;">
                                {{ certification.bulletin.mention|default('—') }}
                            </div>
                        </div>
                    </div>
                    {% else %}
                    <p>
                        A satisfait aux conditions requises pour l'obtention de ce certificat
                        au titre de l'année académique <strong>{{ certification.issuedAt|date('Y') }}/{{ certification.issuedAt|date('Y') + 1 }}</strong>.
                    </p>
                    {% endif %}
                    <p style="margin-top: 20px;">
                        En foi de quoi, le présent certificat lui est délivré pour servir et valoir ce que de droit.
                    </p>
                </div>
                <p style="margin-top: 25px; color: #64748B; font-style: italic; font-size: 12px;">
                    Fait à Tunis, le {{ certification.issuedAt|date('d/m/Y') }}
                </p>
            </div>
            
        {% elseif certification.type == 'DIPLOME' %}
            {# ========== DIPLÔME INTERNE ========== #}
            <div class="content">
                <p style="font-size: 16px; color: #475569; margin-bottom: 10px;">
                    Le Président du Conseil d'Administration de l'établissement <strong>EduSmart</strong>
                </p>
                <p style="font-size: 14px; color: #64748B;">confère le présent diplôme à</p>
                <div class="student-name" style="font-size: 26px; border: none; padding: 20px 0;">
                    {{ certification.student.prenom }} {{ certification.student.name }}
                </div>
                <div class="attestation-text">
                    <p style="text-align: center;">
                        Qui a accompli avec succès le cursus académique requis et a satisfait à toutes les conditions 
                        d'obtention du présent diplôme au terme de l'année académique 
                        <strong>{{ certification.issuedAt|date('Y') }}/{{ certification.issuedAt|date('Y') + 1 }}</strong>.
                    </p>
                    {% if certification.bulletin %}
                    <div class="summary-box">
                        <div class="summary-item">
                            <div class="summary-label">Moyenne Finale</div>
                            <div class="summary-value">{{ certification.bulletin.average|number_format(2) }}/20</div>
                        </div>
                        <div class="summary-item">
                            <div class="summary-label">Mention</div>
                            <div class="summary-value" style="font-size: 14px;">{{ certification.bulletin.mention|default('—') }}</div>
                        </div>
                    </div>
                    {% endif %}
                </div>
                <p style="margin-top: 25px; color: #64748B; font-style: italic; font-size: 12px;">
                    Délivré à Tunis, le {{ certification.issuedAt|date('d/m/Y') }}
                </p>
            </div>
            
        {% elseif certification.type == 'STAGE' %}
            {# ========== ATTESTATION DE STAGE ========== #}
            <div class="content">
                <p class="attestation-text">
                    Le Directeur de l'établissement <strong>EduSmart</strong> atteste par la présente que :
                </p>
                <div class="student-name">{{ certification.student.prenom }} {{ certification.student.name }}</div>
                <div class="attestation-text">
                    <p>
                        A effectué un stage au sein de notre établissement dans le cadre de sa formation académique.
                    </p>
                    <div class="highlight-box">
                        <strong>Période du stage :</strong> Année académique {{ certification.issuedAt|date('Y') }}/{{ certification.issuedAt|date('Y') + 1 }}<br>
                        <strong>Statut :</strong> Stage validé avec succès
                    </div>
                    <p>
                        L'intéressé(e) a fait preuve de sérieux, d'assiduité et de compétence tout au long de cette période.
                    </p>
                    <p>
                        Cette attestation est délivrée pour servir et valoir ce que de droit.
                    </p>
                </div>
                <p style="margin-top: 25px; color: #64748B; font-style: italic; font-size: 12px;">
                    Fait à Tunis, le {{ certification.issuedAt|date('d/m/Y') }}
                </p>
            </div>
            
        {% elseif certification.type == 'PRESENCE' %}
            {# ========== ATTESTATION DE PRÉSENCE ========== #}
            <div class="content">
                <p class="attestation-text">
                    Le Directeur de l'établissement <strong>EduSmart</strong> atteste par la présente que :
                </p>
                <div class="student-name">{{ certification.student.prenom }} {{ certification.student.name }}</div>
                <div class="attestation-text">
                    <p>
                        Est présent(e) régulièrement aux cours dispensés au sein de notre établissement pour l'année 
                        académique <strong>{{ certification.issuedAt|date('Y') }}/{{ certification.issuedAt|date('Y') + 1 }}</strong>.
                    </p>
                    <div class="highlight-box">
                        <strong>Email :</strong> {{ certification.student.email }}<br>
                        <strong>Date de vérification :</strong> {{ certification.issuedAt|date('d/m/Y') }}
                    </div>
                    <p>
                        Cette attestation de présence est délivrée à l'intéressé(e) sur sa demande pour servir et valoir ce que de droit.
                    </p>
                </div>
                <p style="margin-top: 25px; color: #64748B; font-style: italic; font-size: 12px;">
                    Fait à Tunis, le {{ certification.issuedAt|date('d/m/Y') }}
                </p>
            </div>
            
        {% else %}
            {# ========== TYPE INCONNU - CONTENU GÉNÉRIQUE ========== #}
            <div class="content">
                <p style="font-size: 15px; color: #475569;">Il est certifié par la présente que l'étudiant(e) :</p>
                <div class="student-name">{{ certification.student.prenom }} {{ certification.student.name }}</div>
                <p style="color: #475569;">
                    A satisfait aux conditions requises pour l'obtention de ce document<br>
                    {% if certification.bulletin and certification.bulletin.academicYear %}
                    au titre de l'année académique <strong style="color: #4F46E5;">{{ certification.bulletin.academicYear }}</strong>
                    {% else %}
                    au titre de l'année académique <strong style="color: #4F46E5;">{{ certification.issuedAt|date('Y') }}/{{ certification.issuedAt|date('Y') + 1 }}</strong>
                    {% endif %}
                </p>
                <p style="margin-top: 30px; color: #64748B; font-style: italic;">
                    Fait à Tunis, le {{ certification.issuedAt|date('d/m/Y') }}
                </p>
            </div>
        {% endif %}

        <div class="footer">
            <div class="sig-box">
                <div class="sig-title">Le Chef de Departement</div>
                {% if cachet %}
                    <img src="data:image/png;base64,{{ (projectDir ~ '/public/' ~ cachet.imagePath)|file_to_base64 }}" class="sig-image">
                {% endif %}
            </div>
            <div class="sig-box-right">
                <div class="sig-title">Le Directeur de l'Etablissement</div>
                {% if signature %}
                    <img src="data:image/png;base64,{{ (projectDir ~ '/public/' ~ signature.imagePath)|file_to_base64 }}" class="sig-image">
                {% endif %}
            </div>
            <div class="clear"></div>

            <div class="qr-box">
                <img src="data:image/png;base64,{{ qrBase64 }}" class="qr-image"><br>
                <div class="qr-label">
                    Verifiez sur {{ verifyUrl }}<br>
                    <strong>{{ certification.verificationCode }}</strong>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
