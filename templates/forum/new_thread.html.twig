{% extends 'student_layout.html.twig' %}

{% block title %}Nouveau sujet — {{ course.title }} — EduSmart{% endblock %}

{% block stylesheets %}
<style>
    .forum-page { padding: 0 20px; }
    .forum-breadcrumb { margin-bottom: 24px; }
    .forum-breadcrumb a { color: #64748B; text-decoration: none; font-weight: 600; }
    .forum-breadcrumb a:hover { color: #667eea; }
    .forum-breadcrumb span { color: #94a3b8; margin: 0 8px; }
    .forum-header { margin-bottom: 28px; }
    .forum-header h1 { font-size: 1.75rem; font-weight: 800; color: #1e293b; margin: 0; }
    .forum-card { background: white; border-radius: 20px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.04); padding: 32px; max-width: 700px; }
    .forum-card .form-group { margin-bottom: 22px; }
    .forum-card label { display: block; font-weight: 700; color: #334155; margin-bottom: 8px; }
    .forum-card input[type="text"], .forum-card textarea {
        width: 100%; padding: 14px 18px; border: 1px solid #e2e8f0; border-radius: 12px;
        font-size: 1rem; font-family: inherit; transition: border-color 0.2s;
    }
    .forum-card input:focus, .forum-card textarea:focus { outline: none; border-color: #667eea; }
    .forum-card textarea { resize: vertical; min-height: 120px; }
    .forum-actions { display: flex; gap: 12px; margin-top: 28px; }
    .btn-submit { padding: 14px 24px; border-radius: 12px; font-weight: 700; background: linear-gradient(135deg, #667eea, #764ba2); color: white; border: none; cursor: pointer; transition: all 0.3s; }
    .btn-submit:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(102,126,234,0.35); }
    .btn-cancel { padding: 14px 24px; border-radius: 12px; font-weight: 600; background: #f1f5f9; color: #475569; text-decoration: none; transition: all 0.2s; }
    .btn-cancel:hover { background: #e2e8f0; }
    .form-errors { color: #dc2626; font-size: 0.9rem; margin-top: 6px; }
</style>
{% endblock %}

{% block body %}
<div class="forum-page">
    <div class="forum-breadcrumb">
        <a href="{{ path('student_courses') }}">Cours</a>
        <span>/</span>
        <a href="{{ path('student_course_details', {id: course.id}) }}">{{ course.title }}</a>
        <span>/</span>
        <a href="{{ path('forum_index', {id: course.id}) }}">Forum</a>
        <span>/</span>
        <span>Nouveau sujet</span>
    </div>

    <div class="forum-header">
        <h1><i class="fas fa-plus-circle" style="color: #667eea; margin-right: 10px;"></i> Nouveau sujet</h1>
    </div>

    <div class="forum-card">
        {{ form_start(form) }}
        <div class="form-group">
            {{ form_label(form.title) }}
            {{ form_widget(form.title) }}
            {{ form_errors(form.title) }}
        </div>
        <div class="form-group">
            {{ form_label(form.content) }}
            {{ form_widget(form.content) }}
            {{ form_errors(form.content) }}
        </div>
        <div class="forum-actions">
            <button type="submit" class="btn-submit"><i class="fas fa-paper-plane" style="margin-right: 8px;"></i> Publier</button>
            <a href="{{ path('forum_index', {id: course.id}) }}" class="btn-cancel">Annuler</a>
        </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
